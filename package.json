{
  "name": "vb-application",
  "version": "2510.0.3",
  "description": "VB application",
  "devDependencies": {
    "@oracle/grunt-vb-audit": "https://static.oracle.com/cdn/vb/tools/npm/grunt-vb-audit/grunt-vb-audit-2701.0.2.tar.gz",
    "@oracle/grunt-vb-build": "https://static.oracle.com/cdn/vb/tools/npm/grunt-vb-build/grunt-vb-build-2701.0.3.tar.gz",
    "electron": "^45.1.0",
    "grunt": "^1.0.3",
    "grunt-cli": "^1.3.2",
    "load-grunt-tasks": "^4.0.0"
  },
  "com_oracle_visual_builder": {
    "upgrade": "micro"
  },
  "scripts": {
    "test": "node tests/run-all.js",
    "build": "node tools/check-tools.js && grunt vb-clean vb-process-local",
    "serve": "npm run build && grunt vb-serve:webApps/vbredwoodapp --port=8888 --open",
    "desktop": "node tools/get-electron.js && electron desktop",
    "desktop:fresh": "npm run build && node tools/get-electron.js && electron desktop"
  }
}
