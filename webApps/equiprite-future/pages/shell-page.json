{
  "description": "EquipRite Future shell: toolbar (menu toggle, brand, New request, the demo clock, Guide, the bell, Playing as, your menu), the prototype banner, a coloured collapsible menu (resources/js/nav.js, by the persona played, with badges from fxViews.work) and the tab strip over oj-vb-switcher, which keeps every open tab's page alive (resources/js/tabs.js). Everything it shows comes from the simulated store (resources/js/future/fxStore.js); the store's changes reach it as fxRefresh (refreshChain).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "tabs": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "TabType",
        "keyAttributes": "id"
      },
      "description": "The switcher's items, one per open tab (id, name, flow, page, params). Changed only through shellTabs.apply (mutation events), never replaced, so open tabs keep their pages."
    },
    "tabList": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The tab strip, in order: { id, title, icon, navId, pinned }."
    },
    "currentTab": {
      "type": "string",
      "defaultValue": ""
    },
    "navCollapsed": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Menu shown as icons only (kept in this browser)."
    },
    "navOpen": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Menu shown over the content on a narrow window."
    },
    "me": {
      "type": "any",
      "defaultValue": {
        "id": "",
        "name": "",
        "initials": "",
        "title": "",
        "roles": [],
        "bus": [],
        "busText": "",
        "today": "",
        "todayText": "",
        "weekday": "",
        "monthEnd": false
      },
      "description": "The persona played (fxViews.me): name, title, roles, business units, and the demo clock's today."
    },
    "personas": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Everyone in the demo group (fxViews.personas), for Playing as."
    },
    "menu": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The menu for the persona played: nav.visibleGroups(me.roles, nav.badges(fxViews.work().items))."
    },
    "bell": {
      "type": "any",
      "defaultValue": {
        "rows": [],
        "unread": 0
      },
      "description": "The persona's notifications (fxViews.notifications): read marks are per persona, in the store."
    },
    "bellOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "profileOpen": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Your menu: the EquipRite version, colours, Reset the demo."
    },
    "personaOpen": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Playing as: the list of people to play."
    },
    "clockOpen": {
      "type": "boolean",
      "defaultValue": false,
      "description": "The demo clock's panel: what moving it does."
    },
    "resetAsk": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Reset the demo is asking first."
    },
    "colours": {
      "type": "any",
      "defaultValue": {
        "theme": "teal",
        "menu": "dark"
      },
      "description": "Your colours: the theme and the menu dark or light (resources/js/theme.js), kept on this computer (the same key as Next)."
    },
    "tabMenuOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "toast": {
      "type": "any",
      "defaultValue": {
        "message": "",
        "tone": "info",
        "seq": 0
      }
    },
    "open": {
      "type": "string",
      "defaultValue": "",
      "input": "fromUrl",
      "description": "Deep link: ?open=<menu id> opens that screen; ?open=request&id=…&number=… opens a request."
    },
    "id": {
      "type": "string",
      "defaultValue": "",
      "input": "fromUrl"
    },
    "number": {
      "type": "string",
      "defaultValue": "",
      "input": "fromUrl"
    },
    "shellReady": {
      "type": "boolean",
      "defaultValue": false,
      "description": "True once the tabs this persona may open are open."
    }
  },
  "types": {
    "TabType": {
      "id": "string",
      "name": "string",
      "flow": "string",
      "page": "string",
      "params": "object",
      "title": "string",
      "icon": "string",
      "navId": "string",
      "pinned": "boolean"
    }
  },
  "events": {
    "shellRequest": {
      "description": "From a screen in a tab, through resources/js/shellBus.js: open a screen or record, rename or close a tab, show a toast.",
      "payloadType": {
        "action": "string",
        "navId": "string",
        "record": "string",
        "params": "object",
        "id": "string",
        "title": "string",
        "message": "string",
        "tone": "string"
      }
    },
    "fxRefresh": {
      "description": "From the page module: the store changed (an action here or in another tab, the persona, the demo clock, a reset).",
      "payloadType": "object"
    },
    "dismiss": {
      "description": "Escape: closes the open popup.",
      "payloadType": "object"
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "themeChain"
        },
        {
          "chain": "shellEnterChain"
        }
      ]
    },
    "shellRequest": {
      "chains": [
        {
          "chain": "shellRequestChain",
          "parameters": {
            "request": "{{ $event }}"
          }
        }
      ]
    },
    "fxRefresh": {
      "chains": [
        {
          "chain": "refreshChain"
        }
      ]
    },
    "dismiss": {
      "chains": [
        {
          "chain": "dismissChain"
        }
      ]
    },
    "onNav": {
      "chains": [
        {
          "chain": "openChain",
          "parameters": {
            "navId": "{{ $event.currentTarget.dataset.navId }}"
          }
        }
      ]
    },
    "onTab": {
      "chains": [
        {
          "chain": "showTabChain",
          "parameters": {
            "id": "{{ $event.currentTarget.dataset.id }}"
          }
        }
      ]
    },
    "onTabClose": {
      "chains": [
        {
          "chain": "closeTabChain",
          "parameters": {
            "id": "{{ $event.currentTarget.dataset.id }}"
          }
        }
      ]
    },
    "onTabAux": {
      "chains": [
        {
          "chain": "closeTabChain",
          "parameters": {
            "id": "{{ $event.button === 1 ? $event.currentTarget.dataset.id : '' }}"
          }
        }
      ]
    },
    "onTabMenu": {
      "chains": [
        {
          "chain": "tabMenuChain",
          "parameters": {
            "action": "{{ $event.currentTarget.dataset.action }}"
          }
        }
      ]
    },
    "toggleNav": {
      "chains": [
        {
          "chain": "navChain"
        }
      ]
    },
    "onPersona": {
      "chains": [
        {
          "chain": "personaChain",
          "parameters": {
            "action": "{{ $event.currentTarget.dataset.action }}",
            "id": "{{ $event.currentTarget.dataset.id }}"
          }
        }
      ]
    },
    "onClock": {
      "chains": [
        {
          "chain": "clockChain",
          "parameters": {
            "action": "{{ $event.currentTarget.dataset.action }}"
          }
        }
      ]
    },
    "onBell": {
      "chains": [
        {
          "chain": "bellChain"
        }
      ]
    },
    "onNote": {
      "chains": [
        {
          "chain": "noteChain",
          "parameters": {
            "id": "{{ $event.currentTarget.dataset.id }}"
          }
        }
      ]
    },
    "onMarkRead": {
      "chains": [
        {
          "chain": "markReadChain"
        }
      ]
    },
    "onReset": {
      "chains": [
        {
          "chain": "resetChain",
          "parameters": {
            "action": "{{ $event.currentTarget.dataset.action }}"
          }
        }
      ]
    },
    "onTheme": {
      "chains": [
        {
          "chain": "themeChain",
          "parameters": {
            "theme": "{{ $event.currentTarget.dataset.theme }}",
            "menu": "{{ $event.currentTarget.dataset.menu }}"
          }
        }
      ]
    },
    "onProfile": {
      "chains": [
        {
          "chain": "profileChain"
        }
      ]
    },
    "onToastClose": {
      "chains": [
        {
          "chain": "toastChain",
          "parameters": {
            "message": ""
          }
        }
      ]
    },
    "onBackdrop": {
      "chains": [
        {
          "chain": "dismissChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-vb-switcher": {
        "path": "vb/components/oj-vb-switcher/loader"
      },
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      }
    }
  }
}
