{
  "description": "Access: every role against every page (FDD 3, 10.3), with what each level means. Reads and writes exactly as New EquipRite's Page access: GET rbac/app-roles, GET rbac/page-access-matrix?appRoleId= per role, and Save sends PUT rbac/page-access once per changed role (only its changed rows, X-User-Id), refused unless the user's own access to EQR_RBAC_ADMIN is Full; locked rows never change. What a change does to each role's menu is said before saving.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "roles": { "type": "any[]", "defaultValue": [], "description": "Active RBAC_APP_ROLES rows, in the order the backend gives them." },
    "rowsByRole": { "type": "any", "defaultValue": {}, "description": "{ appRoleId: rows as loaded } (the clean baseline; edits never touch it)." },
    "dirty": { "type": "any", "defaultValue": {}, "description": "Pending edits { appRoleId: { pageCode: level } }." },
    "rows": { "type": "any[]", "defaultValue": [], "description": "The matrix (accessMatrix.matrix)." },
    "shown": { "type": "any[]", "defaultValue": [], "description": "The matrix rows the search and the chip leave." },
    "cons": { "type": "any[]", "defaultValue": [], "description": "What Save would do, per role (accessMatrix.consequences)." },
    "dirtyCount": { "type": "number", "defaultValue": 0 },
    "canEdit": { "type": "boolean", "defaultValue": false },
    "isLoading": { "type": "boolean", "defaultValue": true },
    "isSaving": { "type": "boolean", "defaultValue": false },
    "loadError": { "type": "string", "defaultValue": "" },
    "saveErrors": { "type": "any", "defaultValue": {}, "description": "{ appRoleId: words } for a role whose save failed." },
    "text": { "type": "string", "defaultValue": "" },
    "only": { "type": "string", "defaultValue": "all", "description": "all | changed | locked" },
    "exportOpen": { "type": "boolean", "defaultValue": false }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [{ "chain": "enterChain" }]
    },
    "onLevel": {
      "chains": [{ "chain": "levelChain", "parameters": {
        "roleId": "{{ $event.target.dataset.role }}",
        "pageCode": "{{ $event.target.dataset.page }}",
        "accessLevel": "{{ $event.target.value }}"
      } }]
    },
    "onSave": {
      "chains": [{ "chain": "saveChain" }]
    },
    "onDiscard": {
      "chains": [{ "chain": "discardChain" }]
    },
    "onSearch": {
      "chains": [{ "chain": "setChain", "parameters": { "field": "text", "value": "{{ $event.target.value }}" } }]
    },
    "onPick": {
      "chains": [{ "chain": "setChain", "parameters": { "field": "{{ $event.currentTarget.dataset.field }}", "value": "{{ $event.currentTarget.dataset.value }}" } }]
    },
    "onExportMenu": {
      "chains": [{ "chain": "setChain", "parameters": { "field": "exportOpen", "value": "toggle" } }]
    },
    "onExport": {
      "chains": [{ "chain": "exportChain", "parameters": { "format": "{{ $event.currentTarget.dataset.format }}" } }]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" }
    }
  }
}
