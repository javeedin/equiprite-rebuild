{
  "description": "Timesheets (FDD 7.13): the requests on site and a week of hours for one of them, typed from the keyboard, with totals, what is missing and Copy last week. Reads views/timesheets and views/timesheet-details/{week}/{request}; Save and Submit send what New EquipRite's Time entry sends (patchTimeEntry / createTimeEntry, createTimeEntryDay for each day, patchRequestLinesBatch for expenditure types, then SUBMITTED), in the same order, and read the week back. Logic: resources/js/timeEntry.js (New's rules, unchanged).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "closed": {
      "type": "string",
      "defaultValue": "",
      "description": "Why the screen is closed (usageAccess), in words; empty when it is open."
    },
    "queue": {
      "type": "any[]",
      "defaultValue": [],
      "description": "views/timesheets: one row per request on site, with its current week."
    },
    "queueText": {
      "type": "string",
      "defaultValue": ""
    },
    "queueKind": {
      "type": "string",
      "defaultValue": "all",
      "description": "all | todo | waiting | approved"
    },
    "queueLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "requestNumber": {
      "type": "string",
      "defaultValue": ""
    },
    "projectName": {
      "type": "string",
      "defaultValue": ""
    },
    "weekStart": {
      "type": "string",
      "defaultValue": ""
    },
    "weeks": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Every week (Monday) of the request's rental span; the week arrows stay inside it."
    },
    "weekDays": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The seven days of weekStart. Replaced only when the week changes, so the grid does not re-render while typing."
    },
    "rows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The week's rows as loaded (New's buildRows)."
    },
    "apiRows": {
      "type": "any[]",
      "defaultValue": []
    },
    "edits": {
      "type": "any",
      "defaultValue": {},
      "description": "What the user typed, keyed '<rowKey>|d<0-6>', '<rowKey>|type', '<rowKey>|exp'."
    },
    "picked": {
      "type": "any",
      "defaultValue": {},
      "description": "Rows ticked for Submit: { rowKey: true }."
    },
    "headerStatus": {
      "type": "string",
      "defaultValue": ""
    },
    "expTypeList": {
      "type": "any[]",
      "defaultValue": [
        { "value": "Equipment", "label": "Equipment" },
        { "value": "Purchased Equipment", "label": "Purchased Equipment" },
        { "value": "Supplies", "label": "Supplies" },
        { "value": "Miscellaneous", "label": "Miscellaneous" }
      ]
    },
    "internalRequestId": {
      "type": "number",
      "defaultValue": 0
    },
    "lineRates": {
      "type": "any",
      "defaultValue": {},
      "description": "{ lineId: { billRate, priceUom } } from views/request-detail-lines."
    },
    "ppmOn": {
      "type": "boolean",
      "defaultValue": false
    },
    "readOnly": {
      "type": "boolean",
      "defaultValue": false
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "isSaving": {
      "type": "boolean",
      "defaultValue": false
    },
    "saveMode": {
      "type": "string",
      "defaultValue": ""
    },
    "loadError": {
      "type": "string",
      "defaultValue": ""
    },
    "saveError": {
      "type": "string",
      "defaultValue": ""
    },
    "notice": {
      "type": "string",
      "defaultValue": ""
    },
    "pendingMove": {
      "type": "any",
      "defaultValue": null,
      "description": "A week or request change waiting on Discard, because the week has unsaved hours."
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [{ "chain": "loadChain" }]
    },
    "onRefresh": {
      "chains": [{ "chain": "moveChain", "parameters": { "refresh": "yes" } }]
    },
    "onQueueSearch": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "queueText", "value": "{{ $event.target.value }}" } }]
    },
    "onQueueKind": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "queueKind", "value": "{{ $event.currentTarget.dataset.value }}" } }]
    },
    "onPickRequest": {
      "chains": [{ "chain": "moveChain", "parameters": { "requestNumber": "{{ $event.currentTarget.dataset.request }}" } }]
    },
    "onWeekStep": {
      "chains": [{ "chain": "moveChain", "parameters": { "dir": "{{ $event.currentTarget.dataset.dir }}" } }]
    },
    "onThisWeek": {
      "chains": [{ "chain": "moveChain", "parameters": { "week": "today" } }]
    },
    "onDiscardMove": {
      "chains": [{ "chain": "moveChain", "parameters": { "confirm": "discard" } }]
    },
    "onKeepEditing": {
      "chains": [{ "chain": "moveChain", "parameters": { "confirm": "stay" } }]
    },
    "onHours": {
      "chains": [
        {
          "chain": "editChain",
          "parameters": {
            "action": "hours",
            "key": "{{ $event.target.dataset.key }}",
            "day": "{{ $event.target.dataset.d }}",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onRowField": {
      "chains": [
        {
          "chain": "editChain",
          "parameters": {
            "action": "{{ $event.target.dataset.field }}",
            "key": "{{ $event.target.dataset.key }}",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onPick": {
      "chains": [
        {
          "chain": "editChain",
          "parameters": { "action": "pick", "key": "{{ $event.target.dataset.key }}", "value": "{{ $event.target.checked }}" }
        }
      ]
    },
    "onPickAll": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "pickAll", "value": "{{ $event.target.checked }}" } }]
    },
    "onUndo": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "undo" } }]
    },
    "onCopyLastWeek": {
      "chains": [{ "chain": "copyLastWeekChain" }]
    },
    "onSave": {
      "chains": [{ "chain": "saveTimesheetChain", "parameters": { "mode": "save" } }]
    },
    "onSubmit": {
      "chains": [{ "chain": "saveTimesheetChain", "parameters": { "mode": "submit" } }]
    },
    "onExportMenu": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "exportOpen" } }]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": { "format": "{{ $event.currentTarget.dataset.format }}", "what": "{{ $event.currentTarget.dataset.what }}" }
        }
      ]
    },
    "onOpenApprove": {
      "chains": [{ "chain": "openScreenChain", "parameters": { "navId": "approve-time" } }]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" }
    }
  }
}
