{
  "description": "Agreements: every rental agreement (views/rental-agreements, as New EquipRite's list reads it): what is active, what ends soon, what waits for approval; chips, search, sort, export. An agreement opens in its own tab; New agreement opens an empty one (FULL access).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "canWrite": { "type": "boolean", "defaultValue": false, "description": "FULL access to EQR_RENTAL_AGREEMENTS." },
    "unavailable": { "type": "string", "defaultValue": "", "description": "Why agreements are off (feature flags), or ''." },
    "rows": { "type": "any[]", "defaultValue": [], "description": "agreementRules.listRow rows, newest first." },
    "shown": { "type": "any[]", "defaultValue": [] },
    "chips": { "type": "any[]", "defaultValue": [] },
    "summary": { "type": "string", "defaultValue": "" },
    "text": { "type": "string", "defaultValue": "" },
    "chip": { "type": "string", "defaultValue": "all" },
    "sortKey": { "type": "string", "defaultValue": "newest" },
    "sortDir": { "type": "string", "defaultValue": "asc" },
    "isLoading": { "type": "boolean", "defaultValue": true },
    "error": { "type": "string", "defaultValue": "" },
    "exportOpen": { "type": "boolean", "defaultValue": false }
  },
  "eventListeners": {
    "vbEnter": { "chains": [{ "chain": "loadChain" }] },
    "onRefresh": { "chains": [{ "chain": "loadChain" }] },
    "onSearch": { "chains": [{ "chain": "setChain", "parameters": { "field": "text", "value": "{{ $event.target.value }}" } }] },
    "onChip": { "chains": [{ "chain": "setChain", "parameters": { "field": "chip", "value": "{{ $event.currentTarget.dataset.value }}" } }] },
    "onSort": { "chains": [{ "chain": "setChain", "parameters": { "field": "sort", "value": "{{ $event.currentTarget.dataset.key }}" } }] },
    "onExportMenu": { "chains": [{ "chain": "setChain", "parameters": { "field": "exportOpen", "value": "toggle" } }] },
    "onExport": { "chains": [{ "chain": "exportChain", "parameters": { "format": "{{ $event.currentTarget.dataset.format }}" } }] },
    "onOpen": { "chains": [{ "chain": "openChain", "parameters": { "number": "{{ $event.currentTarget.dataset.number }}" } }] },
    "onNew": { "chains": [{ "chain": "openChain", "parameters": { "number": "", "isNew": true } }] }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" }
    }
  }
}
