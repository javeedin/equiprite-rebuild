{
  "description": "The quote of a customer request in its own tab: the PDF the equipment manager sent, what it covers and adds up to (New's quote line totals), the rental terms, and how to accept it. Accepting creates the Fusion rental contract (New's acceptQuoteChain, first step), so it is done in New EquipRite; nothing is written here.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "id": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller"
    },
    "number": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller"
    },
    "requestId": {
      "type": "number",
      "defaultValue": 0
    },
    "quote": {
      "type": "any",
      "defaultValue": {
        "requestNumber": "",
        "customerName": "",
        "customerContact": "",
        "startDate": "",
        "endDate": "",
        "location": "",
        "status": "",
        "contractNumber": "",
        "grandTotal": 0,
        "lines": []
      }
    },
    "state": {
      "type": "any",
      "defaultValue": {
        "key": "",
        "pill": "",
        "tone": "",
        "title": "",
        "text": ""
      }
    },
    "hasQuoteDoc": {
      "type": "boolean",
      "defaultValue": false
    },
    "quotePdfUrl": {
      "type": "string",
      "defaultValue": ""
    },
    "quoteFileName": {
      "type": "string",
      "defaultValue": "quote.pdf"
    },
    "acceptAllowed": {
      "type": "boolean",
      "defaultValue": false,
      "description": "isQuotingAllowed(..., 'CUSTOMER'): a quote can be accepted online (New's rule). Reading it stays open."
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "error": {
      "type": "string",
      "defaultValue": ""
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadQuoteChain"
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadQuoteChain"
        }
      ]
    },
    "onExportMenu": {
      "chains": [
        {
          "chain": "menuChain"
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onOpen": {
      "chains": [
        {
          "chain": "openChain",
          "parameters": {
            "record": "{{ $event.currentTarget.dataset.record }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      }
    }
  }
}
