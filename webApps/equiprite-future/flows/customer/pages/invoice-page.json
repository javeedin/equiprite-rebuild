{
  "description": "The invoices of one customer request in its own tab (FDD 7.18.6): still to pay, paid, last invoice and adjustments, then each piece of equipment with its invoices (New's invoice page reads and the old billing detail's rules). Export. Read only; withdrawn while EXTERNAL_PROJECT_ASSIGN_ENABLED is on, as in New.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "id": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller"
    },
    "number": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller"
    },
    "requestId": {
      "type": "number",
      "defaultValue": 0
    },
    "head": {
      "type": "any",
      "defaultValue": {}
    },
    "groups": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Each line of the request with its invoices (portalView.invoiceGroups)."
    },
    "rows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Every invoice of the request, for the export."
    },
    "totals": {
      "type": "any",
      "defaultValue": {}
    },
    "billingShown": {
      "type": "boolean",
      "defaultValue": true
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "error": {
      "type": "string",
      "defaultValue": ""
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadInvoicesChain"
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadInvoicesChain"
        }
      ]
    },
    "onExportMenu": {
      "chains": [
        {
          "chain": "menuChain"
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onOpen": {
      "chains": [
        {
          "chain": "openChain",
          "parameters": {
            "record": "{{ $event.currentTarget.dataset.record }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      }
    }
  }
}
