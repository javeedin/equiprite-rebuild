{
  "description": "One equipment item in its own tab (FDD 7.2.5): what it is, its units at a glance and in full, certificates and documents, Fusion work orders, expenditure types; Change class (FULL; PATCH /equipment-master/{id}, read back); export of its units, documents or work orders. Data: loadRecordChain (New's detailInitChain, call for call). The variables are New's Equipment detail's, so its chains run on them.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "id": { "type": "string", "defaultValue": "", "input": "fromCaller" },
    "number": { "type": "string", "defaultValue": "", "input": "fromCaller" },
    "equipmentId": { "type": "string", "defaultValue": "", "description": "The master's id, from the tab (or found by its number)." },
    "controlType": { "type": "string", "defaultValue": "", "description": "SERIAL, LOT or INVENTORY, from the master record." },
    "canWrite": { "type": "boolean", "defaultValue": false },
    "isLoading": { "type": "boolean", "defaultValue": true },
    "loadError": { "type": "string", "defaultValue": "" },
    "masterRecord": { "type": "any", "defaultValue": {} },
    "unitsArray": { "type": "any[]", "defaultValue": [] },
    "unitFilter": { "type": "string", "defaultValue": "" },
    "attLevel": { "type": "string", "defaultValue": "HEADER", "description": "Read by resources/js/equipmentAttachments.target: the master's own documents." },
    "attRows": { "type": "any[]", "defaultValue": [] },
    "attInheritedRows": { "type": "any[]", "defaultValue": [] },
    "attCategoryOptions": { "type": "any[]", "defaultValue": [] },
    "attCategoryFilterOptions": { "type": "any[]", "defaultValue": [] },
    "attLoading": { "type": "boolean", "defaultValue": false },
    "attLoadError": { "type": "string", "defaultValue": "" },
    "ExpTypeRows": { "type": "any[]", "defaultValue": [] },
    "ExpTypeResolvedLevel": { "type": "string", "defaultValue": "NONE" },
    "ExpTypeInherited": { "type": "string", "defaultValue": "" },
    "workOrders": { "type": "any[]", "defaultValue": [] },
    "woLoading": { "type": "boolean", "defaultValue": false },
    "woLoaded": { "type": "boolean", "defaultValue": false },
    "classPanelOpen": { "type": "boolean", "defaultValue": false },
    "classDraft": { "type": "any", "defaultValue": { "classId": null, "subclassId": null } },
    "classOptions": { "type": "any[]", "defaultValue": [] },
    "allSubclassOptions": { "type": "any[]", "defaultValue": [] },
    "subclassOptions": { "type": "any[]", "defaultValue": [] },
    "classChangeLoading": { "type": "boolean", "defaultValue": false },
    "classChangeSaving": { "type": "boolean", "defaultValue": false },
    "classChangeError": { "type": "string", "defaultValue": "" },
    "exportOpen": { "type": "boolean", "defaultValue": false },
    "exportWhat": { "type": "string", "defaultValue": "units", "description": "units | docs | wos: which list Export writes." }
  },
  "eventListeners": {
    "vbEnter": { "chains": [{ "chain": "loadRecordChain" }] },
    "onRefresh": { "chains": [{ "chain": "loadRecordChain" }] },
    "onChangeClass": { "chains": [{ "chain": "openChangeClassChain" }] },
    "onClassPick": {
      "chains": [{ "chain": "classPickChain", "parameters": { "kind": "{{ $event.currentTarget.dataset.kind }}", "value": "{{ $event.currentTarget.dataset.value }}" } }]
    },
    "onSaveClass": { "chains": [{ "chain": "saveClassChangeChain" }] },
    "onOpenDoc": { "chains": [{ "chain": "openAttachmentChain", "parameters": { "id": "{{ $event.currentTarget.dataset.id }}" } }] },
    "onLoadWorkOrders": { "chains": [{ "chain": "loadWorkOrdersChain" }] },
    "onUnitFilter": { "chains": [{ "chain": "unitFilterChain", "parameters": { "text": "{{ $event.target.value }}" } }] },
    "onExportMenu": { "chains": [{ "chain": "menuChain", "parameters": { "what": "" } }] },
    "onExportWhat": { "chains": [{ "chain": "menuChain", "parameters": { "what": "{{ $event.currentTarget.dataset.what }}" } }] },
    "onExport": { "chains": [{ "chain": "exportChain", "parameters": { "format": "{{ $event.currentTarget.dataset.format }}" } }] },
    "onOpenList": { "chains": [{ "chain": "openListChain" }] }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" }
    }
  }
}
