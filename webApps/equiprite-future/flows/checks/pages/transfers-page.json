{
  "description": "Transfers (FDD 7.16, 7.16A, S13, S26, S28): every transfer order (out to site, back to the yard, between projects), from where to where, what is moving, where it is read from the equipment, what is late; chips, kinds, search, sort, export; a transfer opens in its own tab. Reads only: transfer-orders, transfer-history, inv-orgs, views/my-requests (shared), then transfer-order-lines and request-detail-lines of the open orders. Recording a transfer writes transfer orders (Fusion): that is done in New EquipRite.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "orders": {
      "type": "any[]",
      "defaultValue": [],
      "description": "transfer-orders rows."
    },
    "history": {
      "type": "any[]",
      "defaultValue": [],
      "description": "transfer-history rows (inter-project transfers)."
    },
    "orgs": {
      "type": "any[]",
      "defaultValue": []
    },
    "requests": {
      "type": "any",
      "defaultValue": {},
      "description": "Request id -> { number, party }."
    },
    "toLines": {
      "type": "any",
      "defaultValue": {},
      "description": "Order id -> its transfer-order-lines rows (the orders that were read)."
    },
    "lines": {
      "type": "any",
      "defaultValue": {},
      "description": "Request line id -> request-detail-lines row."
    },
    "rows": {
      "type": "any[]",
      "defaultValue": []
    },
    "shown": {
      "type": "any[]",
      "defaultValue": []
    },
    "chips": {
      "type": "any[]",
      "defaultValue": []
    },
    "kindChips": {
      "type": "any[]",
      "defaultValue": []
    },
    "chip": {
      "type": "string",
      "defaultValue": "all"
    },
    "kind": {
      "type": "string",
      "defaultValue": "all"
    },
    "text": {
      "type": "string",
      "defaultValue": ""
    },
    "sortKey": {
      "type": "string",
      "defaultValue": "due"
    },
    "sortDir": {
      "type": "string",
      "defaultValue": "asc"
    },
    "summary": {
      "type": "string",
      "defaultValue": ""
    },
    "limit": {
      "type": "number",
      "defaultValue": 100
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "detailLoading": {
      "type": "boolean",
      "defaultValue": false
    },
    "loadToken": {
      "type": "number",
      "defaultValue": 0
    },
    "error": {
      "type": "string",
      "defaultValue": ""
    },
    "note": {
      "type": "string",
      "defaultValue": ""
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadChain",
          "parameters": {
            "refresh": false
          }
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadChain",
          "parameters": {
            "refresh": true
          }
        }
      ]
    },
    "onSearch": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "text",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onPick": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onSort": {
      "chains": [
        {
          "chain": "sortChain",
          "parameters": {
            "key": "{{ $event.currentTarget.dataset.key }}"
          }
        }
      ]
    },
    "onMore": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "limit",
            "value": "more"
          }
        }
      ]
    },
    "onExportMenu": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "exportOpen",
            "value": "toggle"
          }
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onOpen": {
      "chains": [
        {
          "chain": "openRecordChain",
          "parameters": {
            "id": "{{ $event.currentTarget.dataset.id }}",
            "number": "{{ $event.currentTarget.dataset.number }}",
            "source": "{{ $event.currentTarget.dataset.source }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      }
    }
  }
}
