{
  "title": "My requests",
  "description": "Project and customer requests in one list (FDD 7.6; replaces equipment-requests and customer-my-requests), two ways: Requests (a card per request with its equipment on it) and Equipment (a row per piece of equipment across requests). Data: views/my-requests with the old list's role-scoped origin filter, and views/my-request-lines for the equipment; a request the bulk view misses loads its own lines (views/request-detail-lines) when opened.",
  "variables": {
    "allRows": {
      "type": "any[]",
      "defaultValue": [],
      "onValueChanged": {
        "chains": [
          {
            "chain": "applyFilterChain"
          }
        ]
      }
    },
    "filteredRows": {
      "type": "any[]",
      "defaultValue": []
    },
    "linesByRequest": {
      "type": "any",
      "defaultValue": {},
      "description": "Equipment lines by request number (my-requests-page.js lineOf shape).",
      "onValueChanged": {
        "chains": [
          {
            "chain": "applyFilterChain"
          }
        ]
      }
    },
    "linesLoaded": {
      "type": "boolean",
      "defaultValue": false,
      "description": "The bulk equipment call answered."
    },
    "allLines": {
      "type": "any[]",
      "defaultValue": []
    },
    "filteredLines": {
      "type": "any[]",
      "defaultValue": []
    },
    "expanded": {
      "type": "any",
      "defaultValue": {},
      "description": "Request numbers whose full equipment list is open."
    },
    "loadingLines": {
      "type": "any",
      "defaultValue": {}
    },
    "view": {
      "type": "string",
      "defaultValue": "requests",
      "description": "requests or equipment.",
      "onValueChanged": {
        "chains": [
          {
            "chain": "applyFilterChain"
          }
        ]
      }
    },
    "limit": {
      "type": "number",
      "defaultValue": 40
    },
    "groupChips": {
      "type": "any[]",
      "defaultValue": []
    },
    "searchText": {
      "type": "string",
      "defaultValue": ""
    },
    "group": {
      "type": "string",
      "defaultValue": "all",
      "onValueChanged": {
        "chains": [
          {
            "chain": "applyFilterChain"
          }
        ]
      }
    },
    "source": {
      "type": "string",
      "defaultValue": "",
      "description": "INTERNAL or EXTERNAL; managers only. Empty = both.",
      "onValueChanged": {
        "chains": [
          {
            "chain": "applyFilterChain"
          }
        ]
      }
    },
    "isManager": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Sees both origins (canChooseCustomerType): shows the source chips and badges."
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "fetchError": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "metadata": {},
  "eventListeners": {
    "vbBeforeEnter": {
      "chains": [
        {
          "chain": "enforcePageAccessChain"
        }
      ]
    },
    "vbEnter": {
      "chains": [
        {
          "chain": "loadRequestsChain"
        }
      ]
    },
    "onSearchInput": {
      "chains": [
        {
          "chain": "applyFilterChain",
          "parameters": {
            "text": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onGroupClick": {
      "chains": [
        {
          "chain": "setGroupChain",
          "parameters": {
            "group": "{{ $event.currentTarget.dataset.group }}"
          }
        }
      ]
    },
    "onSourceClick": {
      "chains": [
        {
          "chain": "setGroupChain",
          "parameters": {
            "source": "{{ $event.currentTarget.dataset.source }}"
          }
        }
      ]
    },
    "onViewClick": {
      "chains": [
        {
          "chain": "setViewChain",
          "parameters": {
            "view": "{{ $event.currentTarget.dataset.view }}"
          }
        }
      ]
    },
    "onToggle": {
      "chains": [
        {
          "chain": "toggleRequestChain",
          "parameters": {
            "number": "{{ $event.currentTarget.dataset.number }}",
            "id": "{{ $event.currentTarget.dataset.id }}"
          }
        }
      ]
    },
    "onOpen": {
      "chains": [
        {
          "chain": "openRequestChain",
          "parameters": {
            "id": "{{ $event.currentTarget.dataset.id }}",
            "number": "{{ $event.currentTarget.dataset.number }}"
          }
        }
      ]
    },
    "onMore": {
      "chains": [
        {
          "chain": "showMoreChain"
        }
      ]
    },
    "onNewRequest": {
      "chains": [
        {
          "chain": "openNavChain",
          "parameters": {
            "navId": "new-request"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      }
    }
  }
}
