{
  "title": "Time entry",
  "description": "Weekly time entry (FDD 7.13; replaces equipment-timesheets and timesheet-detail). Reads views/timesheets (the request list) and views/timesheet-details/{week}/{request} (the grid); Save and Submit post what the old timesheet-detail saveTimesheetChain / submitTimesheetChain post, in the same order. ?request= and ?week= open a request and week.",
  "variables": {
    "request": {
      "type": "string",
      "input": "fromUrl",
      "description": "Request NUMBER to open (the old page's requestId)."
    },
    "week": {
      "type": "string",
      "input": "fromUrl",
      "description": "Week start (a Monday, YYYY-MM-DD) to open."
    },
    "queue": {
      "type": "any[]",
      "defaultValue": [],
      "description": "views/timesheets: one row per request with its current week."
    },
    "queueText": {
      "type": "string",
      "defaultValue": ""
    },
    "requestNumber": {
      "type": "string",
      "defaultValue": ""
    },
    "projectName": {
      "type": "string",
      "defaultValue": ""
    },
    "weekStart": {
      "type": "string",
      "defaultValue": ""
    },
    "weeks": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Every week (Monday) of the request's rental span; the week arrows stay inside it."
    },
    "weekDays": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The seven days of weekStart. Replaced only when the week changes, so the grid does not re-render while typing."
    },
    "rows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The week's rows as loaded (time-entry-page.js buildRows)."
    },
    "apiRows": {
      "type": "any[]",
      "defaultValue": []
    },
    "edits": {
      "type": "any",
      "defaultValue": {},
      "description": "What the user typed, keyed '<rowKey>|d<0-6>', '<rowKey>|type', '<rowKey>|exp'."
    },
    "picked": {
      "type": "any",
      "defaultValue": {},
      "description": "Rows ticked for Submit: { rowKey: true }."
    },
    "headerStatus": {
      "type": "string",
      "defaultValue": ""
    },
    "expTypeList": {
      "type": "any[]",
      "defaultValue": [
        { "value": "Equipment", "label": "Equipment" },
        { "value": "Purchased Equipment", "label": "Purchased Equipment" },
        { "value": "Supplies", "label": "Supplies" },
        { "value": "Miscellaneous", "label": "Miscellaneous" }
      ]
    },
    "internalRequestId": {
      "type": "number",
      "defaultValue": 0
    },
    "lineRates": {
      "type": "any",
      "defaultValue": {},
      "description": "{ lineId: { billRate, priceUom } } from views/request-detail-lines."
    },
    "ppmOn": {
      "type": "boolean",
      "defaultValue": false
    },
    "readOnly": {
      "type": "boolean",
      "defaultValue": false
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "isSaving": {
      "type": "boolean",
      "defaultValue": false
    },
    "saveMode": {
      "type": "string",
      "defaultValue": ""
    },
    "loadError": {
      "type": "string",
      "defaultValue": ""
    },
    "saveError": {
      "type": "string",
      "defaultValue": ""
    },
    "notice": {
      "type": "string",
      "defaultValue": ""
    },
    "pendingMove": {
      "type": "any",
      "defaultValue": null,
      "description": "A week or request change waiting on Discard, because the week has unsaved hours."
    }
  },
  "metadata": {},
  "eventListeners": {
    "vbBeforeEnter": {
      "chains": [{ "chain": "enforcePageAccessChain" }]
    },
    "vbEnter": {
      "chains": [{ "chain": "timeEntryInitChain" }]
    },
    "onQueueSearch": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "queueText", "value": "{{ $event.target.value }}" } }]
    },
    "onPickRequest": {
      "chains": [{ "chain": "moveChain", "parameters": { "requestNumber": "{{ $event.currentTarget.dataset.request }}" } }]
    },
    "onWeekStep": {
      "chains": [{ "chain": "moveChain", "parameters": { "dir": "{{ $event.currentTarget.dataset.dir }}" } }]
    },
    "onThisWeek": {
      "chains": [{ "chain": "moveChain", "parameters": { "week": "today" } }]
    },
    "onDiscardMove": {
      "chains": [{ "chain": "moveChain", "parameters": { "confirm": "discard" } }]
    },
    "onKeepEditing": {
      "chains": [{ "chain": "moveChain", "parameters": { "confirm": "stay" } }]
    },
    "onHours": {
      "chains": [
        {
          "chain": "editChain",
          "parameters": {
            "action": "hours",
            "key": "{{ $event.target.dataset.key }}",
            "day": "{{ $event.target.dataset.d }}",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onRowField": {
      "chains": [
        {
          "chain": "editChain",
          "parameters": {
            "action": "{{ $event.target.dataset.field }}",
            "key": "{{ $event.target.dataset.key }}",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onPick": {
      "chains": [
        {
          "chain": "editChain",
          "parameters": { "action": "pick", "key": "{{ $event.target.dataset.key }}", "value": "{{ $event.target.checked }}" }
        }
      ]
    },
    "onPickAll": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "pickAll", "value": "{{ $event.target.checked }}" } }]
    },
    "onUndo": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "undo" } }]
    },
    "onCopyLastWeek": {
      "chains": [{ "chain": "copyLastWeekChain" }]
    },
    "onSave": {
      "chains": [{ "chain": "saveTimesheetChain", "parameters": { "mode": "save" } }]
    },
    "onSubmit": {
      "chains": [{ "chain": "saveTimesheetChain", "parameters": { "mode": "submit" } }]
    },
    "onExportCsv": {
      "chains": [{ "chain": "exportCsvChain" }]
    },
    "onOpenApproval": {
      "chains": [{ "chain": "openNavChain", "parameters": { "navId": "timesheet-approval" } }]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" }
    }
  }
}
