{
  "description": "Set up your workspace (Build.Rite): a wizard — 1 the VB Studio workspace (organization, project, workspace), 2 the folder on this PC, 3 a preview of what is made, 4 Set workspace & working folder: main (VB Studio's branch, cloned) and working (where changes go), made current and shown in the top bar (desktop/lib/vbs.js workPlan, workUse).",
  "navigation": { "embeddable": "enabled" },
  "variables": {
    "key": { "type": "string", "defaultValue": "", "input": "fromCaller", "description": "A project to start with ('<host>/<org>/<project>')." },
    "ws": { "type": "string", "defaultValue": "", "input": "fromCaller", "description": "A workspace to start with (its name): the wizard opens on the folder step." },
    "step": { "type": "number", "defaultValue": 1, "description": "1 workspace, 2 folder, 3 preview, 4 set." },
    "found": { "type": "any", "defaultValue": null },
    "orgs": { "type": "any[]", "defaultValue": [] },
    "work": { "type": "any", "defaultValue": null },
    "fOrg": { "type": "string", "defaultValue": "" },
    "pQ": { "type": "string", "defaultValue": "" },
    "selProject": { "type": "string", "defaultValue": "" },
    "selWs": { "type": "string", "defaultValue": "" },
    "folder": { "type": "string", "defaultValue": "" },
    "plan": { "type": "any", "defaultValue": null, "description": "What Set workspace & working folder makes (workPlan): its folders, address, branch." },
    "done": { "type": "any", "defaultValue": null, "description": "What it made (workUse)." },
    "loading": { "type": "boolean", "defaultValue": true },
    "busy": { "type": "boolean", "defaultValue": false },
    "busyText": { "type": "string", "defaultValue": "" },
    "result": { "type": "any", "defaultValue": null }
  },
  "eventListeners": {
    "vbEnter": { "chains": [ { "chain": "loadChain" } ] },
    "onAct": { "chains": [ { "chain": "actChain", "parameters": { "act": "{{ $event.currentTarget.dataset.act }}", "key": "{{ $event.currentTarget.dataset.key || '' }}" } } ] },
    "onField": { "chains": [ { "chain": "setChain", "parameters": { "field": "{{ $event.currentTarget.dataset.field }}", "value": "{{ $event.currentTarget.value }}" } } ] }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" }
    }
  }
}
