{
  "description": "Standup minutes: the daily standup on the Jira backlog written down and kept in DuckDB on this PC (desktop/lib/minutes.js). A meeting has a header (date, time, title, customer, attendees) and lines, each tied to a Jira story or generic, with a note, a next action, owner and due date. Voice→text (Whisper) and Format by AI (the shared Ask AI LLM) help write a line. Tracking rolls the minutes up by the story's epic and by customer; the minutes can be sent as a formatted email or to a Teams webhook. Rules: resources/js/minutes.js.",
  "navigation": { "embeddable": "enabled" },
  "variables": {
    "available": { "type": "boolean", "defaultValue": true, "description": "Minutes runs only in the desktop app (DuckDB on this PC)." },
    "checked": { "type": "boolean", "defaultValue": false },
    "busy": { "type": "boolean", "defaultValue": false },
    "busyMsg": { "type": "string", "defaultValue": "" },
    "error": { "type": "string", "defaultValue": "" },
    "toast": { "type": "string", "defaultValue": "" },
    "view": { "type": "string", "defaultValue": "edit", "description": "edit | track" },
    "trackBy": { "type": "string", "defaultValue": "epic", "description": "epic | story | customer" },
    "dialog": { "type": "string", "defaultValue": "", "description": "'' | settings | ai | email" },
    "meetings": { "type": "any[]", "defaultValue": [], "description": "Past meetings (summaries), newest first." },
    "meeting": { "type": "any", "defaultValue": { "id": "", "date": "", "time": "", "title": "", "customer": "", "attendees": [], "context": "", "discussion": "", "lines": [] }, "description": "The meeting being edited." },
    "attendeesText": { "type": "string", "defaultValue": "", "description": "The attendees as a comma-separated field (legacy)." },
    "attendeeDraft": { "type": "string", "defaultValue": "", "description": "The attendee-picker input (cleared after each add)." },
    "people": { "type": "any[]", "defaultValue": [], "description": "Outlook contacts read from this PC (name, email), for the attendee picker." },
    "peopleReady": { "type": "boolean", "defaultValue": false, "description": "Whether Outlook contacts were available on this PC." },
    "dirty": { "type": "boolean", "defaultValue": false },
    "rows": { "type": "any[]", "defaultValue": [], "description": "The Jira backlog read (jiraBacklog.fromIssue), for story links and epic/customer tracking." },
    "jiraReady": { "type": "boolean", "defaultValue": false },
    "recLineId": { "type": "string", "defaultValue": "", "description": "The line whose voice is being recorded ('__body__' = the discussion body)." },
    "fmtLineId": { "type": "string", "defaultValue": "", "description": "The line being formatted by AI." },
    "fmtBody": { "type": "boolean", "defaultValue": false, "description": "Whether the discussion body is being formatted by AI." },
    "fmtAll": { "type": "boolean", "defaultValue": false, "description": "Whether the whole minutes (discussion + all notes) is being formatted by AI." },
    "pickOpen": { "type": "boolean", "defaultValue": false, "description": "Whether the 'Find a Jira story' picker dialog is open." },
    "pickLineId": { "type": "string", "defaultValue": "", "description": "The action-item line the story picker is choosing for." },
    "pickCurrent": { "type": "string", "defaultValue": "", "description": "The story key currently linked to that line." },
    "pickSel": { "type": "any[]", "defaultValue": [], "description": "The story keys ticked in the picker for multi-select linking." },
    "pickQ": { "type": "string", "defaultValue": "", "description": "The picker's free-text search (number, description, status, assignee, sprint)." },
    "pickSprint": { "type": "string", "defaultValue": "", "description": "The picker's sprint filter." },
    "pickStatus": { "type": "string", "defaultValue": "", "description": "The picker's status filter." },
    "pickAssignee": { "type": "string", "defaultValue": "", "description": "The picker's assignee filter." },
    "settings": { "type": "any", "defaultValue": { "teamsWebhookSet": false, "defaultAttendees": [], "orgName": "", "fromName": "", "fromEmail": "", "provider": "local" } },
    "settingsForm": { "type": "any", "defaultValue": { "teamsWebhook": "", "defaultAttendees": "", "orgName": "", "fromName": "", "fromEmail": "", "clearTeamsWebhook": false, "provider": "local", "tenantId": "", "clientId": "" } },
    "graph": { "type": "any", "defaultValue": { "configured": false, "signedIn": false, "pending": false, "account": "", "userCode": "", "verificationUri": "", "error": "" }, "description": "Microsoft 365 sign-in status (lib/graph.js)." },
    "ai": { "type": "any", "defaultValue": { "active": "", "providers": {} } },
    "aiReady": { "type": "boolean", "defaultValue": false },
    "aiForm": { "type": "any", "defaultValue": { "provider": "claudecode", "key": "", "model": "", "baseUrl": "", "region": "", "compartmentId": "", "status": "" } },
    "email": { "type": "any", "defaultValue": { "subject": "", "html": "", "text": "", "to": "" } }
  },
  "eventListeners": {
    "vbEnter": { "chains": [ { "chain": "initChain" } ] },
    "onField": { "chains": [ { "chain": "setChain", "parameters": {
      "scope": "{{ $event.target.dataset.scope }}", "field": "{{ $event.target.dataset.field }}",
      "value": "{{ $event.target.value }}", "lineId": "{{ $event.target.dataset.line || '' }}" } } ] },
    "onAct": { "chains": [ { "chain": "actChain", "parameters": {
      "act": "{{ $event.currentTarget.dataset.act }}", "id": "{{ $event.currentTarget.dataset.id || '' }}",
      "lineId": "{{ $event.currentTarget.dataset.line || '' }}" } } ] },
    "onNote": { "chains": [ { "chain": "setChain", "parameters": {
      "scope": "line", "field": "text", "value": "{{ $event.detail.value }}", "lineId": "{{ $event.target.dataset.line || '' }}" } } ] },
    "onBodyHtml": { "chains": [ { "chain": "setChain", "parameters": {
      "scope": "header", "field": "discussion", "value": "{{ $event.target.innerHTML }}" } } ] },
    "onPickField": { "chains": [ { "chain": "actChain", "parameters": {
      "act": "pickSet", "id": "{{ $event.target.dataset.field }}", "value": "{{ $event.target.value }}" } } ] },
    "onPickManualKey": { "chains": [ { "chain": "actChain", "parameters": {
      "act": "{{ $event.key === 'Enter' ? 'pickManual' : 'noop' }}" } } ] },
    "onAttendeeInput": { "chains": [ { "chain": "actChain", "parameters": { "act": "attendeeSearch", "id": "{{ $event.target.value }}" } } ] },
    "onAttendeeKey": { "chains": [ { "chain": "actChain", "parameters": { "act": "{{ $event.key === 'Enter' ? 'addAttendee' : 'noop' }}", "id": "{{ $event.target.value }}" } } ] }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" },
      "oj-text-area": { "path": "ojs/ojinputtext" }
    }
  }
}
