{
  "description": "One Jira sprint, in its own tab (opened from Jira stories, By sprint): every item ever in it (JQL sprint = id), its dates, state and goal, what is wrong with it on the board, the numbers, a day-by-day burn-up, by status and person, carried on and carried in, the items (each opens in the drawer, as on Jira stories, with its test evidence; an icon opens it in Jira), export. Rules: resources/js/jiraBacklog.js sprintReport (the same file Old uses). Read only.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "id": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller",
      "description": "The sprint's Jira id (the tab's key)."
    },
    "name": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller",
      "description": "The sprint's name."
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "error": {
      "type": "string",
      "defaultValue": ""
    },
    "notConnected": {
      "type": "boolean",
      "defaultValue": false
    },
    "readAt": {
      "type": "string",
      "defaultValue": ""
    },
    "report": {
      "type": "any",
      "defaultValue": {
        "sprint": {},
        "kpis": {},
        "burnup": [],
        "statuses": [],
        "people": [],
        "flags": [],
        "findings": [],
        "rows": [],
        "url": ""
      },
      "description": "jiraBacklog.sprintReport."
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "selKey": {
      "type": "string",
      "defaultValue": "",
      "description": "The item open in the drawer ('' when none)."
    },
    "selected": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The item keys ticked for Copy to follow-up (empty = copy all shown)."
    },
    "itemF": { "type": "object", "defaultValue": {}, "description": "Per-column filter text for the items table (key, summary, status, in, sprint, assignee, due, resolved)." },
    "itemSort": { "type": "object", "defaultValue": { "col": "", "dir": "asc" }, "description": "The items table's sort column and direction (Key sorts by story number)." },
    "fuOpen": { "type": "boolean", "defaultValue": false, "description": "The Copy to follow-up dialog is open." },
    "fuRows": { "type": "any[]", "defaultValue": [], "description": "The items the follow-up email covers (what was ticked, or all)." },
    "fuTitle": { "type": "string", "defaultValue": "", "description": "The email header's first line (e.g. Follow-up — Sprint 2026-06)." },
    "fuSubtitle": { "type": "string", "defaultValue": "", "description": "The email header's second line (state · dates)." },
    "fuWhen": { "type": "string", "defaultValue": "", "description": "When the follow-up was drafted (shown with the item count)." },
    "fuTpl": { "type": "string", "defaultValue": "close", "description": "The chosen body template key (followup.TEMPLATES)." },
    "fuTo": { "type": "string", "defaultValue": "", "description": "Recipients for Open in Outlook (optional)." },
    "fuSubject": { "type": "string", "defaultValue": "", "description": "The email subject." },
    "fuMessage": { "type": "string", "defaultValue": "", "description": "The editable message above the table (greeting + body)." },
    "fuSignoff": { "type": "string", "defaultValue": "Thanks,", "description": "The editable sign-off below the table." },
    "fuM365": { "type": "any", "defaultValue": { "signedIn": false, "account": "" }, "description": "Microsoft 365 sign-in status (from Minutes settings), for Send via Microsoft 365." },
    "fuCc": { "type": "string", "defaultValue": "", "description": "CC recipients." },
    "fuSug": { "type": "any[]", "defaultValue": [], "description": "Contact suggestions for the active recipient field (from the directory)." },
    "fuSugFor": { "type": "string", "defaultValue": "", "description": "Which recipient field the suggestions are for ('to' | 'cc')." },
    "images": {
      "type": "object",
      "defaultValue": {},
      "description": "The open item's images, read through the jira connection: { attachment id: object URL } ('' when it could not be read)."
    },
    "evidence": {
      "type": "object",
      "defaultValue": {
        "available": false,
        "key": "",
        "items": [],
        "folder": "",
        "error": "",
        "busy": "",
        "recording": "",
        "canTranscribe": false,
        "engines": []
      },
      "description": "The open item's test evidence on this PC (resources/js/testRecorder.js): recordings and screenshots in its folder."
    },
    "evidenceIndex": {
      "type": "object",
      "defaultValue": {},
      "description": "Which stories have recordings or screenshots on this PC (resources/js/testRecorder.js index): { KEY: { videos, shots, failed, latest } }, for the icon after a story's summary."
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadChain",
          "parameters": {
            "refresh": false
          }
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadChain",
          "parameters": {
            "refresh": true
          }
        }
      ]
    },
    "onConnect": {
      "chains": [
        {
          "chain": "openChain",
          "parameters": {
            "what": "stories"
          }
        }
      ]
    },
    "onRwAction": {
      "chains": [
        {
          "chain": "openChain",
          "parameters": {
            "what": "{{ $event.detail.secondaryItem && $event.detail.secondaryItem.id ? $event.detail.secondaryItem.id : '' }}"
          }
        }
      ]
    },
    "onExportToggle": {
      "chains": [
        {
          "chain": "openChain",
          "parameters": {
            "what": "exportMenu"
          }
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onPick": {
      "chains": [
        {
          "chain": "pickChain",
          "parameters": {
            "act": "row",
            "key": "{{ $event.currentTarget.dataset.key }}"
          }
        }
      ]
    },
    "onPickAll": {
      "chains": [
        {
          "chain": "pickChain",
          "parameters": {
            "act": "all"
          }
        }
      ]
    },
    "onFollowup": {
      "chains": [ { "chain": "followupChain", "parameters": { "act": "open" } } ]
    },
    "onFuTemplate": {
      "chains": [ { "chain": "followupChain", "parameters": { "act": "template", "key": "{{ $event.currentTarget.dataset.key }}" } } ]
    },
    "onFuField": {
      "chains": [ { "chain": "followupChain", "parameters": { "act": "field", "field": "{{ $event.target.dataset.field }}", "value": "{{ $event.detail.value }}" } } ]
    },
    "onFuCopy": {
      "chains": [ { "chain": "followupChain", "parameters": { "act": "copy" } } ]
    },
    "onFuOutlook": {
      "chains": [ { "chain": "followupChain", "parameters": { "act": "outlook" } } ]
    },
    "onFuDefault": {
      "chains": [ { "chain": "followupChain", "parameters": { "act": "default" } } ]
    },
    "onFuSave": {
      "chains": [ { "chain": "followupChain", "parameters": { "act": "save" } } ]
    },
    "onFuSend": {
      "chains": [ { "chain": "followupChain", "parameters": { "act": "send" } } ]
    },
    "onFuRecipInput": {
      "chains": [ { "chain": "followupChain", "parameters": { "act": "recipSearch", "field": "{{ $event.target.dataset.field }}", "value": "{{ $event.detail.value }}" } } ]
    },
    "onFuRecipPick": {
      "chains": [ { "chain": "followupChain", "parameters": { "act": "recipPick", "field": "{{ $event.currentTarget.dataset.field }}", "value": "{{ $event.currentTarget.dataset.email }}" } } ]
    },
    "onItemFilter": {
      "chains": [ { "chain": "gridChain", "parameters": { "act": "filter", "field": "{{ $event.target.dataset.field }}", "value": "{{ $event.target.value }}" } } ]
    },
    "onItemSort": {
      "chains": [ { "chain": "gridChain", "parameters": { "act": "sort", "col": "{{ $event.currentTarget.dataset.col }}" } } ]
    },
    "onItemClear": {
      "chains": [ { "chain": "gridChain", "parameters": { "act": "clear" } } ]
    },
    "onFuClose": {
      "chains": [ { "chain": "followupChain", "parameters": { "act": "close" } } ]
    },
    "onOpenItem": {
      "chains": [
        {
          "chain": "selectChain",
          "parameters": {
            "key": "{{ $event.currentTarget.dataset.key }}"
          }
        }
      ]
    },
    "onDrawer": {
      "chains": [
        {
          "chain": "selectChain",
          "parameters": {
            "key": "{{ $event.detail.value ? $page.variables.selKey : '' }}"
          }
        }
      ]
    },
    "onDrawerClose": {
      "chains": [
        {
          "chain": "selectChain",
          "parameters": {
            "key": ""
          }
        }
      ]
    },
    "evidenceChanged": {
      "chains": [
        {
          "chain": "evidenceChain",
          "parameters": {
            "act": "list"
          }
        }
      ]
    },
    "onEvidence": {
      "chains": [
        {
          "chain": "evidenceChain",
          "parameters": {
            "act": "{{ $event.currentTarget.dataset.act }}",
            "name": "{{ $event.currentTarget.dataset.name || '' }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      },
      "oj-sp-general-overview-page": {
        "path": "oj-sp/general-overview-page/loader"
      },
      "oj-drawer-popup": {
        "path": "ojs/ojdrawerpopup"
      },
      "oj-sp-general-drawer-template": {
        "path": "oj-sp/general-drawer-template/loader"
      },
      "oj-input-text": {
        "path": "ojs/ojinputtext"
      },
      "oj-text-area": {
        "path": "ojs/ojinputtext"
      }
    }
  },
  "events": {
    "evidenceChanged": {
      "description": "From resources/js/testRecorder.js: a recording or screenshot was saved (or a recording began or ended).",
      "payloadType": "object"
    }
  }
}
