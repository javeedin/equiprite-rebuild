{
  "description": "Integrations (FDD 8, 9; RPT-17): what is down, since when, what failed and what to do, from New EquipRite's Integration health reads (integration events, error logs, dead letter queue, job runs, open sync exceptions, the sync lock) graded by its integrationHealth module, unchanged. Read only: running a sync again or reprocessing is done in New EquipRite, which the page links to and says what it would do.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "raw": { "type": "any", "defaultValue": {}, "description": "The rows as loaded (events, errors, dlq, jobs, syncExceptions, lock)." },
    "m": {
      "type": "any",
      "defaultValue": { "answer": "", "summary": "", "banner": null, "lockText": "", "kpis": [], "cards": [], "silent": [], "silentText": "", "chips": [], "queue": [], "queueAll": 0, "jobs": [] },
      "description": "integrationsView.view(raw, now, filters)."
    },
    "isLoading": { "type": "boolean", "defaultValue": true },
    "loaded": { "type": "boolean", "defaultValue": false },
    "loadNote": { "type": "string", "defaultValue": "" },
    "checkedAt": { "type": "string", "defaultValue": "" },
    "integ": { "type": "string", "defaultValue": "", "description": "The exception queue's integration chip." },
    "exportOpen": { "type": "string", "defaultValue": "", "description": "Which list's export menu is open: cards | queue | jobs." }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [{ "chain": "loadChain" }]
    },
    "onCheckAgain": {
      "chains": [{ "chain": "loadChain" }]
    },
    "onPick": {
      "chains": [{ "chain": "setChain", "parameters": { "field": "{{ $event.currentTarget.dataset.field }}", "value": "{{ $event.currentTarget.dataset.value }}" } }]
    },
    "onExport": {
      "chains": [{ "chain": "exportChain", "parameters": { "list": "{{ $event.currentTarget.dataset.list }}", "format": "{{ $event.currentTarget.dataset.format }}" } }]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" }
    }
  }
}
