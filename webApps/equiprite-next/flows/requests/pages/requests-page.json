{
  "description": "Requests: every request read from its equipment (requestProgress) as a list, a board by stage, or one row per piece of equipment; journey chips (Late first), search, sort, export. Opens a request in its own tab.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "rows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Requests with their progress (requestList.decorate)."
    },
    "linesByRequest": {
      "type": "any",
      "defaultValue": {}
    },
    "linesLoaded": {
      "type": "boolean",
      "defaultValue": true
    },
    "manager": {
      "type": "boolean",
      "defaultValue": false
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "error": {
      "type": "string",
      "defaultValue": ""
    },
    "view": {
      "type": "string",
      "defaultValue": "list",
      "description": "list | board | equipment"
    },
    "text": {
      "type": "string",
      "defaultValue": ""
    },
    "stage": {
      "type": "string",
      "defaultValue": "all"
    },
    "source": {
      "type": "string",
      "defaultValue": ""
    },
    "sortKey": {
      "type": "string",
      "defaultValue": "number"
    },
    "sortDir": {
      "type": "string",
      "defaultValue": "desc"
    },
    "shown": {
      "type": "any[]",
      "defaultValue": [],
      "description": "What the current view shows, filtered and sorted."
    },
    "lanes": {
      "type": "any[]",
      "defaultValue": []
    },
    "chips": {
      "type": "any[]",
      "defaultValue": []
    },
    "summary": {
      "type": "string",
      "defaultValue": ""
    },
    "limit": {
      "type": "number",
      "defaultValue": 100
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "can": {
      "type": "any",
      "defaultValue": {
        "decide": false,
        "assign": false,
        "pick": false,
        "accept": false
      },
      "description": "Which row steps this user may take: decide (EQR_WORKBENCH FULL; also confirms for picking), assign (EQR_WORKBENCH seen), pick (EQR_INITIATE_PICKING seen), accept a delivery (EQR_EQUIPMENT_REQUESTS or EQR_WORKBENCH FULL)."
    },
    "pop": {
      "type": "any",
      "defaultValue": {
        "kind": ""
      },
      "description": "The open popup on a request: approve (decide it here) or history (its timeline); see popChain."
    },
    "ui": {
      "type": "string",
      "defaultValue": "current",
      "description": "The look of this page: 'current' (Next's own) or 'redwood' (Oracle's Redwood page template and components), as chosen in your menu (resources/js/look.js; setChain ui)."
    },
    "rwRows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: one row per request shown (applyChain, from shown), for the oj-table."
    },
    "rwADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "key",
        "data": "{{ $page.variables.rwRows }}"
      }
    },
    "rwCriterion": {
      "type": "any",
      "description": "Redwood view: the Smart Search criterion (text and filters); rwFilterChain turns it into text, stage and source."
    },
    "rwSearchConfig": {
      "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory",
      "defaultValue": {
        "url": "[[ $application.path + 'resources/data/requestsSearchConfig.json' ]]"
      }
    },
    "rwStages": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: the stage filter's options, with their counts (applyChain, from chips)."
    },
    "rwStagesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwStages }}"
      }
    },
    "rwTypes": {
      "type": "any[]",
      "defaultValue": [
        {
          "value": "INTERNAL",
          "label": "Project"
        },
        {
          "value": "EXTERNAL",
          "label": "Customer"
        }
      ]
    },
    "rwTypesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwTypes }}"
      }
    },
    "rwSearchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
            "StageFilter": {
              "label": "Where the equipment is",
              "options": {
                "optionsData": "[[ $page.variables.rwStagesADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "TypeFilter": {
              "label": "Type",
              "options": {
                "optionsData": "[[ $page.variables.rwTypesADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            }
          }
        }
      }
    },
    "rwMounted": {
      "type": "boolean",
      "defaultValue": false,
      "description": "The Redwood look has been opened on this page: it stays mounted (hidden when the current look shows)."
    }
  },
  "events": {
    "focusRequest": {
      "description": "From resources/js/shellBus.js focus(): another screen handed this one a filter (Help: where some pieces are).",
      "payloadType": "object"
    },
    "lookChanged": {
      "description": "From the page module: the look chosen in your menu changed (resources/js/look.js): Redwood or Current.",
      "payloadType": "object"
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadChain",
          "parameters": {
            "refresh": false
          }
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadChain",
          "parameters": {
            "refresh": true
          }
        }
      ]
    },
    "onSearch": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "text",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onPick": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onSort": {
      "chains": [
        {
          "chain": "sortChain",
          "parameters": {
            "key": "{{ $event.currentTarget.dataset.key }}"
          }
        }
      ]
    },
    "onOpen": {
      "chains": [
        {
          "chain": "openRecordChain",
          "parameters": {
            "id": "{{ $event.currentTarget.dataset.id }}",
            "number": "{{ $event.currentTarget.dataset.number }}",
            "act": "{{ $event.target && $event.target.closest && $event.target.closest('[data-act]') ? $event.target.closest('[data-act]').getAttribute('data-act') : 'open' }}"
          }
        }
      ]
    },
    "onExportMenu": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "exportOpen",
            "value": "toggle"
          }
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onMore": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "limit",
            "value": "more"
          }
        }
      ]
    },
    "onNew": {
      "chains": [
        {
          "chain": "openScreenChain",
          "parameters": {
            "navId": "new-request"
          }
        }
      ]
    },
    "onPop": {
      "chains": [
        {
          "chain": "popChain",
          "parameters": {
            "action": "{{ $event.currentTarget.dataset.action }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onPopReason": {
      "chains": [
        {
          "chain": "popChain",
          "parameters": {
            "action": "reasonText",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onPopApprove": {
      "chains": [
        {
          "chain": "popChain",
          "parameters": {
            "action": "approve",
            "id": "{{ $variables.pop.id }}",
            "number": "{{ $variables.pop.number }}"
          }
        }
      ]
    },
    "focusRequest": {
      "chains": [
        {
          "chain": "focusChain"
        }
      ]
    },
    "onRwFilter": {
      "chains": [
        {
          "chain": "rwFilterChain"
        }
      ]
    },
    "onRwRow": {
      "chains": [
        {
          "chain": "openRecordChain",
          "parameters": {
            "id": "{{ $event.detail.context.key }}",
            "number": "{{ $event.detail.context.item && $event.detail.context.item.data ? $event.detail.context.item.data.number : '' }}",
            "act": "open"
          }
        }
      ]
    },
    "onRwAct": {
      "chains": [
        {
          "chain": "openRecordChain",
          "parameters": {
            "id": "{{ $event.currentTarget.dataset.id }}",
            "number": "{{ $event.currentTarget.dataset.number }}",
            "act": "{{ $event.currentTarget.dataset.act }}"
          }
        }
      ]
    },
    "onRwExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": {
            "format": "xlsx"
          }
        }
      ]
    },
    "lookChanged": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "ui",
            "value": "{{ $event.look }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      },
      "oj-sp-smart-search-page": {
        "path": "oj-sp/smart-search-page/loader"
      },
      "oj-sp-smart-search": {
        "path": "oj-sp/smart-search/loader"
      },
      "oj-sp-collection-container": {
        "path": "oj-sp/collection-container/loader"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      },
      "oj-c-button": {
        "path": "oj-c/button"
      }
    }
  }
}
