{
  "description": "Requests: every request read from its equipment (requestProgress) as a list, a board by stage, or one row per piece of equipment; journey chips (Late first), search, sort, export. Opens a request in its own tab.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "rows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Requests with their progress (requestList.decorate)."
    },
    "linesByRequest": {
      "type": "any",
      "defaultValue": {}
    },
    "linesLoaded": {
      "type": "boolean",
      "defaultValue": true
    },
    "manager": {
      "type": "boolean",
      "defaultValue": false
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "error": {
      "type": "string",
      "defaultValue": ""
    },
    "view": {
      "type": "string",
      "defaultValue": "list",
      "description": "list | board | equipment"
    },
    "text": {
      "type": "string",
      "defaultValue": ""
    },
    "stage": {
      "type": "string",
      "defaultValue": "all"
    },
    "source": {
      "type": "string",
      "defaultValue": ""
    },
    "sortKey": {
      "type": "string",
      "defaultValue": "number"
    },
    "sortDir": {
      "type": "string",
      "defaultValue": "desc"
    },
    "shown": {
      "type": "any[]",
      "defaultValue": [],
      "description": "What the current view shows, filtered and sorted."
    },
    "lanes": {
      "type": "any[]",
      "defaultValue": []
    },
    "chips": {
      "type": "any[]",
      "defaultValue": []
    },
    "summary": {
      "type": "string",
      "defaultValue": ""
    },
    "limit": {
      "type": "number",
      "defaultValue": 100
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadChain",
          "parameters": {
            "refresh": false
          }
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadChain",
          "parameters": {
            "refresh": true
          }
        }
      ]
    },
    "onSearch": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "text",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onPick": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onSort": {
      "chains": [
        {
          "chain": "sortChain",
          "parameters": {
            "key": "{{ $event.currentTarget.dataset.key }}"
          }
        }
      ]
    },
    "onOpen": {
      "chains": [
        {
          "chain": "openRecordChain",
          "parameters": {
            "id": "{{ $event.currentTarget.dataset.id }}",
            "number": "{{ $event.currentTarget.dataset.number }}"
          }
        }
      ]
    },
    "onExportMenu": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "exportOpen",
            "value": "toggle"
          }
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onMore": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "limit",
            "value": "more"
          }
        }
      ]
    },
    "onNew": {
      "chains": [
        {
          "chain": "openScreenChain",
          "parameters": {
            "navId": "new-request"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      }
    }
  }
}
