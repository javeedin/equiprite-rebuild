{
  "description": "One request in its own tab: what it is, where each piece of equipment is (the journey), what is next and late, the equipment, the facts; export of its equipment.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "id": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller"
    },
    "number": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller"
    },
    "requestId": {
      "type": "number",
      "defaultValue": 0
    },
    "head": {
      "type": "any",
      "defaultValue": {}
    },
    "lines": {
      "type": "any[]",
      "defaultValue": []
    },
    "p": {
      "type": "any",
      "defaultValue": {
        "headline": "",
        "tone": "",
        "stops": [],
        "late": [],
        "total": 0
      }
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "error": {
      "type": "string",
      "defaultValue": ""
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadRecordChain"
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadRecordChain"
        }
      ]
    },
    "onExportMenu": {
      "chains": [
        {
          "chain": "menuChain"
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportLinesChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onOpenList": {
      "chains": [
        {
          "chain": "openListChain"
        }
      ]
    },
    "onFinishDraft": {
      "chains": [
        {
          "chain": "finishDraftChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      }
    }
  }
}
