{
  "description": "One request in its own tab: what it is, where each piece of equipment is (the journey), what is next and late, the equipment, the facts; export of its equipment. Under the Redwood look (your menu): Oracle's general overview header (its actions are the page head's buttons) and the equipment as an oj-table.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "id": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller"
    },
    "number": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller"
    },
    "requestId": {
      "type": "number",
      "defaultValue": 0
    },
    "head": {
      "type": "any",
      "defaultValue": {}
    },
    "lines": {
      "type": "any[]",
      "defaultValue": []
    },
    "p": {
      "type": "any",
      "defaultValue": {
        "headline": "",
        "tone": "",
        "stops": [],
        "late": [],
        "total": 0
      }
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "error": {
      "type": "string",
      "defaultValue": ""
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "ask": { "type": "string", "defaultValue": "", "description": "'' | 'confirm' | 'accept': the step asked about before it is done (stepChain)." },
    "stepBusy": { "type": "string", "defaultValue": "", "description": "The step in flight: 'confirm' | 'accept' | ''." },
    "stepResult": { "type": "any", "defaultValue": { "tone": "", "title": "", "text": "" }, "description": "What the last Confirm or Accept did." },
    "acts": {
      "type": "any",
      "defaultValue": {
        "approve": false,
        "assign": false,
        "confirm": 0,
        "pick": 0,
        "accept": 0,
        "mayConfirm": false,
        "mayAccept": false
      },
      "description": "The steps this request offers this user (requestList.actions), as on its row in Requests."
    },
    "history": {
      "type": "any",
      "defaultValue": {
        "loading": true
      },
      "description": "Its history from start to end (requestHistory.build), read after the request."
    },
    "histTab": {
      "type": "string",
      "defaultValue": "steps",
      "description": "steps | activity, on a narrow screen."
    },
    "rwLinesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "key",
        "data": "{{ $page.variables.lines }}"
      },
      "description": "Redwood view: the equipment as an oj-table (the same lines)."
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadRecordChain"
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadRecordChain"
        }
      ]
    },
    "onExportMenu": {
      "chains": [
        {
          "chain": "menuChain"
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportLinesChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onOpenList": {
      "chains": [
        {
          "chain": "openListChain"
        }
      ]
    },
    "onFinishDraft": {
      "chains": [
        {
          "chain": "finishDraftChain"
        }
      ]
    },
    "onStep": {
      "chains": [
        {
          "chain": "stepChain",
          "parameters": {
            "act": "{{ $event.currentTarget.dataset.act }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onRwPrimary": {
      "chains": [
        {
          "chain": "rwActionChain",
          "parameters": {
            "id": "primary"
          }
        }
      ]
    },
    "onRwAction": {
      "chains": [
        {
          "chain": "rwActionChain",
          "parameters": {
            "id": "{{ $event.detail.secondaryItem }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      },
      "oj-sp-general-overview-page": {
        "path": "oj-sp/general-overview-page/loader"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      }
    }
  }
}
