{
  "description": "One request in its own tab: what it is, where each piece of equipment is (the journey), what is next and late, the equipment, the facts; export of its equipment.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "id": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller"
    },
    "number": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller"
    },
    "requestId": {
      "type": "number",
      "defaultValue": 0
    },
    "head": {
      "type": "any",
      "defaultValue": {}
    },
    "lines": {
      "type": "any[]",
      "defaultValue": []
    },
    "p": {
      "type": "any",
      "defaultValue": {
        "headline": "",
        "tone": "",
        "stops": [],
        "late": [],
        "total": 0
      }
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "error": {
      "type": "string",
      "defaultValue": ""
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "acts": {
      "type": "any",
      "defaultValue": {
        "approve": false,
        "assign": false,
        "pick": 0
      },
      "description": "The steps this request offers this user (requestList.actions), as on its row in Requests."
    },
    "history": {
      "type": "any",
      "defaultValue": {
        "loading": true
      },
      "description": "Its history from start to end (requestHistory.build), read after the request."
    },
    "histTab": {
      "type": "string",
      "defaultValue": "steps",
      "description": "steps | activity, on a narrow screen."
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadRecordChain"
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadRecordChain"
        }
      ]
    },
    "onExportMenu": {
      "chains": [
        {
          "chain": "menuChain"
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportLinesChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onOpenList": {
      "chains": [
        {
          "chain": "openListChain"
        }
      ]
    },
    "onFinishDraft": {
      "chains": [
        {
          "chain": "finishDraftChain"
        }
      ]
    },
    "onStep": {
      "chains": [
        {
          "chain": "stepChain",
          "parameters": {
            "act": "{{ $event.currentTarget.dataset.act }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      }
    }
  }
}
