{
  "description": "A customer's new request (FDD 7.18.4, S11): dates, who it is for and where it goes, the catalog at the customer's rates with availability, a cart that prices itself (or says a quote is coming), then Review with the rental terms to accept, Submit or Save draft. Posts what New EquipRite's customer New request posts (the old cart's EXTERNAL path) through the same requestHeaderBody / requestLineBody builders. With customer quoting off, submitting also creates the Fusion sell contract, so that submit is left to New (the draft is saved here and sent from New). A draft tab ({ draft: id }) reopens a saved customer draft.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "draft": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller",
      "description": "A customer DRAFT request to reopen (EQR_EQUIPMENT_REQUEST id). Empty for a new request."
    },
    "number": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller"
    },
    "startStep": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller",
      "description": "'review' opens a reopened draft on Review (New's startStep 3); anything else on the form."
    },
    "mode": {
      "type": "string",
      "defaultValue": "edit",
      "description": "edit | review"
    },
    "form": {
      "type": "any",
      "defaultValue": {},
      "description": "customer-create-req's formData fields (customerOrder.emptyForm); set by initChain."
    },
    "cart": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Cart lines built by catalogCart.itemFromRow; a line can carry its own startDate, endDate and notes."
    },
    "resume": {
      "type": "any",
      "defaultValue": null,
      "description": "The draft this page saves into { id, requestNumber, attribute1, shipToSiteId }: a reopened one, or the one Save draft created."
    },
    "agreementId": {
      "type": "number",
      "defaultValue": null
    },
    "agreementLineMap": {
      "type": "any",
      "defaultValue": {}
    },
    "customers": {
      "type": "any[]",
      "defaultValue": [],
      "description": "getCustomerRefs, as { id, customerName }."
    },
    "contacts": {
      "type": "any[]",
      "defaultValue": [],
      "description": "getCustomerPortalUsers, as { id, contactName, username, email }."
    },
    "customerQuery": {
      "type": "string",
      "defaultValue": ""
    },
    "contactQuery": {
      "type": "string",
      "defaultValue": ""
    },
    "catalogRows": {
      "type": "any[]",
      "defaultValue": []
    },
    "catalogShown": {
      "type": "any[]",
      "defaultValue": []
    },
    "catalogCount": {
      "type": "number",
      "defaultValue": 0
    },
    "classChips": {
      "type": "any[]",
      "defaultValue": []
    },
    "catalogText": {
      "type": "string",
      "defaultValue": ""
    },
    "catalogClass": {
      "type": "string",
      "defaultValue": "all"
    },
    "catalogAvail": {
      "type": "string",
      "defaultValue": ""
    },
    "catalogLimit": {
      "type": "number",
      "defaultValue": 48
    },
    "catalogLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "catalogError": {
      "type": "string",
      "defaultValue": ""
    },
    "hideRates": {
      "type": "boolean",
      "defaultValue": false,
      "description": "A quote is coming for customer requests (isQuotingAllowed EXTERNAL): no prices are shown or posted."
    },
    "contractAtSubmit": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Customer quoting is off (isQuotingAllowed CUSTOMER false): New's submit creates the Fusion sell contract, so submitting is done in New."
    },
    "canCreate": {
      "type": "boolean",
      "defaultValue": true,
      "description": "EQR_CUST_CREATE_REQ is FULL or READ_ONLY (New's rule)."
    },
    "behalf": {
      "type": "boolean",
      "defaultValue": false
    },
    "termsAccepted": {
      "type": "boolean",
      "defaultValue": false,
      "description": "The rental terms tick on Review. Submit refuses without it and uses it up (the old cart's T&C gate)."
    },
    "missing": {
      "type": "any[]",
      "defaultValue": []
    },
    "priceNote": {
      "type": "string",
      "defaultValue": ""
    },
    "saveError": {
      "type": "string",
      "defaultValue": ""
    },
    "sent": {
      "type": "any",
      "defaultValue": null,
      "description": "What was just saved or sent: { mode, id, number, link }."
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "loadError": {
      "type": "string",
      "defaultValue": ""
    },
    "wrongDraft": {
      "type": "boolean",
      "defaultValue": false
    },
    "isSubmitting": {
      "type": "boolean",
      "defaultValue": false
    },
    "submitMode": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "initChain"
        }
      ]
    },
    "onField": {
      "chains": [
        {
          "chain": "setFieldChain",
          "parameters": {
            "field": "{{ $event.target.dataset.field }}",
            "value": "{{ $event.target.value }}",
            "checked": "{{ $event.target.checked }}"
          }
        }
      ]
    },
    "onPick": {
      "chains": [
        {
          "chain": "setFieldChain",
          "parameters": {
            "field": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onCatalogSearch": {
      "chains": [
        {
          "chain": "filterCatalogChain",
          "parameters": {
            "text": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onClassChip": {
      "chains": [
        {
          "chain": "filterCatalogChain",
          "parameters": {
            "cls": "{{ $event.currentTarget.dataset.cls }}"
          }
        }
      ]
    },
    "onAvailToggle": {
      "chains": [
        {
          "chain": "filterCatalogChain",
          "parameters": {
            "avail": "{{ $event.target.checked }}"
          }
        }
      ]
    },
    "onShowMore": {
      "chains": [
        {
          "chain": "filterCatalogChain",
          "parameters": {
            "more": true
          }
        }
      ]
    },
    "onCart": {
      "chains": [
        {
          "chain": "cartChain",
          "parameters": {
            "action": "{{ $event.currentTarget.dataset.action }}",
            "id": "{{ $event.currentTarget.dataset.id }}"
          }
        }
      ]
    },
    "onLineQty": {
      "chains": [
        {
          "chain": "cartChain",
          "parameters": {
            "action": "set",
            "id": "{{ $event.target.dataset.id }}",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onLineField": {
      "chains": [
        {
          "chain": "cartChain",
          "parameters": {
            "action": "line",
            "id": "{{ $event.target.dataset.id }}",
            "field": "{{ $event.target.dataset.field }}",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onReview": {
      "chains": [
        {
          "chain": "modeChain",
          "parameters": {
            "to": "review"
          }
        }
      ]
    },
    "onEdit": {
      "chains": [
        {
          "chain": "modeChain",
          "parameters": {
            "to": "edit"
          }
        }
      ]
    },
    "onSubmit": {
      "chains": [
        {
          "chain": "submitChain",
          "parameters": {
            "mode": "submit"
          }
        }
      ]
    },
    "onSaveDraft": {
      "chains": [
        {
          "chain": "submitChain",
          "parameters": {
            "mode": "draft"
          }
        }
      ]
    },
    "onHandOff": {
      "chains": [
        {
          "chain": "submitChain",
          "parameters": {
            "mode": "handoff"
          }
        }
      ]
    },
    "onOpenSaved": {
      "chains": [
        {
          "chain": "openChain",
          "parameters": {
            "id": "{{ $event.currentTarget.dataset.id }}",
            "number": "{{ $event.currentTarget.dataset.number }}"
          }
        }
      ]
    },
    "onReset": {
      "chains": [
        {
          "chain": "resetChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      }
    }
  }
}
