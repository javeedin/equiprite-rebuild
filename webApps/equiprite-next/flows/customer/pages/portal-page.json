{
  "description": "Customer portal home (FDD 7.18, S11): what needs the customer (quotes to accept, deliveries to accept, drafts to send, overdue invoices), what is on its way to them and on their site, their requests read from the equipment, every piece of equipment, their invoices. Export on every list. Records open in tabs of their own. Reads only (New's customer views).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "base": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The customer's requests, mapped as New maps views/customer-my-requests (portalView.requestsOf)."
    },
    "linesById": {
      "type": "any",
      "defaultValue": {},
      "description": "{ requestId: mapped lines } for the open requests whose equipment was read (views/request-detail-lines)."
    },
    "invoiceBase": {
      "type": "any[]",
      "defaultValue": [],
      "description": "views/customer-my-billing, mapped with the old billing detail's rules (customerPortal.mapInvoices)."
    },
    "rows": {
      "type": "any[]",
      "defaultValue": []
    },
    "needs": {
      "type": "any[]",
      "defaultValue": []
    },
    "tiles": {
      "type": "any[]",
      "defaultValue": []
    },
    "totals": {
      "type": "any",
      "defaultValue": {}
    },
    "recent": {
      "type": "any[]",
      "defaultValue": []
    },
    "onWay": {
      "type": "any[]",
      "defaultValue": []
    },
    "onSite": {
      "type": "any[]",
      "defaultValue": []
    },
    "customerName": {
      "type": "string",
      "defaultValue": ""
    },
    "summary": {
      "type": "string",
      "defaultValue": ""
    },
    "quotingAllowed": {
      "type": "boolean",
      "defaultValue": false,
      "description": "isQuotingAllowed(..., 'CUSTOMER'): a quote can be accepted online."
    },
    "billingShown": {
      "type": "boolean",
      "defaultValue": false,
      "description": "EXTERNAL_PROJECT_ASSIGN_ENABLED positively off: invoices are the customer's (New's billing rule)."
    },
    "canCreate": {
      "type": "boolean",
      "defaultValue": false,
      "description": "EQR_CUST_CREATE_REQ is FULL or READ_ONLY (New's rule for New request)."
    },
    "behalf": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Staff using the portal for customers (customerPortal.actsForCustomers)."
    },
    "view": {
      "type": "string",
      "defaultValue": "home",
      "description": "home | requests | equipment | invoices"
    },
    "reqGroup": {
      "type": "string",
      "defaultValue": "open"
    },
    "reqText": {
      "type": "string",
      "defaultValue": ""
    },
    "reqSort": {
      "type": "string",
      "defaultValue": "number"
    },
    "reqDir": {
      "type": "string",
      "defaultValue": "desc"
    },
    "reqChips": {
      "type": "any[]",
      "defaultValue": []
    },
    "reqShown": {
      "type": "any[]",
      "defaultValue": []
    },
    "eqChip": {
      "type": "string",
      "defaultValue": "all"
    },
    "eqText": {
      "type": "string",
      "defaultValue": ""
    },
    "eqChips": {
      "type": "any[]",
      "defaultValue": []
    },
    "eqShown": {
      "type": "any[]",
      "defaultValue": []
    },
    "invChip": {
      "type": "string",
      "defaultValue": "all"
    },
    "invText": {
      "type": "string",
      "defaultValue": ""
    },
    "invChips": {
      "type": "any[]",
      "defaultValue": []
    },
    "invShown": {
      "type": "any[]",
      "defaultValue": []
    },
    "limit": {
      "type": "number",
      "defaultValue": 50
    },
    "linesNote": {
      "type": "string",
      "defaultValue": ""
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "error": {
      "type": "string",
      "defaultValue": ""
    },
    "billingError": {
      "type": "string",
      "defaultValue": ""
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "rwShown": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: the requests the Requests view shows (reqShown), narrowed by the column filters picked in Smart Search (applyChain, portalRedwood.byColumns). Export takes these under Redwood."
    },
    "rwRows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: one plain row per request in rwShown, for the oj-table (portalRedwood.rows)."
    },
    "rwADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "key",
        "data": "{{ $page.variables.rwRows }}"
      }
    },
    "rwCriterion": {
      "type": "any",
      "description": "Redwood view: the Smart Search criterion (text and filters; Oracle's, read only); rwFilterChain turns it into reqText, reqGroup (All when Show is not picked) and rwCols, whenever it changes and whenever the Redwood list is shown (rwShowChain)."
    },
    "rwGroup": {
      "type": "string",
      "defaultValue": "all",
      "description": "Redwood view: the Show picked in Smart Search (needs, open, finished, all). Nothing picked is every request, as in Old; the current look keeps its own Show (reqGroup)."
    },
    "rwCols": {
      "type": "object",
      "defaultValue": {
        "number": "",
        "dates": "",
        "status": "",
        "next": "",
        "contract": ""
      },
      "description": "Redwood view: the column filters picked in Smart Search (rwFilterChain), as portalRedwood.byColumns reads them; Show is the page's own reqGroup."
    },
    "rwSearchConfig": {
      "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory",
      "defaultValue": {
        "url": "[[ $application.path + 'resources/data/portalRequestsSearchConfig.json' ]]"
      }
    },
    "rwNumbers": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: the Request filter's options (applyChain, portalRedwood.options)."
    },
    "rwNumbersADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwNumbers }}"
      }
    },
    "rwDates": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: the Dates filter's options with their counts."
    },
    "rwDatesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwDates }}"
      }
    },
    "rwStatuses": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: the Where your equipment is filter's options with their counts."
    },
    "rwStatusesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwStatuses }}"
      }
    },
    "rwNext": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: the Next filter's options with their counts."
    },
    "rwNextADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwNext }}"
      }
    },
    "rwContracts": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: the Contract filter's options with their counts."
    },
    "rwContractsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwContracts }}"
      }
    },
    "rwGroups": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: the Show filter's options (the portal's chips: Needs you, Open, Finished, All) with their counts."
    },
    "rwGroupsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwGroups }}"
      }
    },
    "rwSearchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
            "RequestFilter": {
              "label": "Request",
              "options": { "optionsData": "[[ $page.variables.rwNumbersADP ]]", "optionsKeys": { "label": "label", "value": "value" } }
            },
            "DatesFilter": {
              "label": "Dates",
              "options": { "optionsData": "[[ $page.variables.rwDatesADP ]]", "optionsKeys": { "label": "label", "value": "value" } }
            },
            "StatusFilter": {
              "label": "Where your equipment is",
              "options": { "optionsData": "[[ $page.variables.rwStatusesADP ]]", "optionsKeys": { "label": "label", "value": "value" } }
            },
            "NextFilter": {
              "label": "Next",
              "options": { "optionsData": "[[ $page.variables.rwNextADP ]]", "optionsKeys": { "label": "label", "value": "value" } }
            },
            "ContractFilter": {
              "label": "Contract",
              "options": { "optionsData": "[[ $page.variables.rwContractsADP ]]", "optionsKeys": { "label": "label", "value": "value" } }
            },
            "GroupFilter": {
              "label": "Show",
              "options": { "optionsData": "[[ $page.variables.rwGroupsADP ]]", "optionsKeys": { "label": "label", "value": "value" } }
            }
          }
        }
      }
    }
  },
  "events": {
    "portalChanged": {
      "description": "A tab of the portal changed something (resources/js/portalSignal.js): read the home again.",
      "payloadType": "object"
    },
    "lookChanged": {
      "description": "From the page module: the look chosen in your menu changed (resources/js/look.js): Redwood or Current.",
      "payloadType": "object"
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadChain"
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadChain"
        }
      ]
    },
    "onView": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "view",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onPick": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onSearch": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "{{ $event.target.dataset.field }}",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onSort": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "sort",
            "value": "{{ $event.currentTarget.dataset.key }}"
          }
        }
      ]
    },
    "onOpen": {
      "chains": [
        {
          "chain": "openChain",
          "parameters": {
            "record": "{{ $event.currentTarget.dataset.record }}",
            "id": "{{ $event.currentTarget.dataset.id }}",
            "number": "{{ $event.currentTarget.dataset.number }}",
            "view": "{{ $event.currentTarget.dataset.view }}",
            "chip": "{{ $event.currentTarget.dataset.chip }}"
          }
        }
      ]
    },
    "onNew": {
      "chains": [
        {
          "chain": "openChain",
          "parameters": {
            "record": "customer-order"
          }
        }
      ]
    },
    "onExportMenu": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "exportOpen",
            "value": "toggle"
          }
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onMore": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "limit",
            "value": "more"
          }
        }
      ]
    },
    "portalChanged": {
      "chains": [
        {
          "chain": "loadChain"
        }
      ]
    },
    "onRwAction": {
      "chains": [
        {
          "chain": "rwActChain",
          "parameters": {
            "id": "{{ $event.detail.secondaryItem }}"
          }
        }
      ]
    },
    "onRwFilter": {
      "chains": [
        {
          "chain": "rwFilterChain"
        }
      ]
    },
    "onRwRow": {
      "chains": [
        {
          "chain": "rwOpenChain",
          "parameters": {
            "id": "{{ $event.detail.context.key }}"
          }
        }
      ]
    },
    "lookChanged": {
      "chains": [
        {
          "chain": "rwShowChain",
          "parameters": {
            "look": "{{ $event.look }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      },
      "oj-sp-general-overview-page": {
        "path": "oj-sp/general-overview-page/loader"
      },
      "oj-sp-smart-search": {
        "path": "oj-sp/smart-search/loader"
      },
      "oj-sp-collection-container": {
        "path": "oj-sp/collection-container/loader"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      }
    }
  }
}
