{
  "description": "Customer portal home (FDD 7.18, S11): what needs the customer (quotes to accept, deliveries to accept, drafts to send, overdue invoices), what is on its way to them and on their site, their requests read from the equipment, every piece of equipment, their invoices. Export on every list. Records open in tabs of their own. Reads only (New's customer views).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "base": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The customer's requests, mapped as New maps views/customer-my-requests (portalView.requestsOf)."
    },
    "linesById": {
      "type": "any",
      "defaultValue": {},
      "description": "{ requestId: mapped lines } for the open requests whose equipment was read (views/request-detail-lines)."
    },
    "invoiceBase": {
      "type": "any[]",
      "defaultValue": [],
      "description": "views/customer-my-billing, mapped with the old billing detail's rules (customerPortal.mapInvoices)."
    },
    "rows": {
      "type": "any[]",
      "defaultValue": []
    },
    "needs": {
      "type": "any[]",
      "defaultValue": []
    },
    "tiles": {
      "type": "any[]",
      "defaultValue": []
    },
    "totals": {
      "type": "any",
      "defaultValue": {}
    },
    "recent": {
      "type": "any[]",
      "defaultValue": []
    },
    "onWay": {
      "type": "any[]",
      "defaultValue": []
    },
    "onSite": {
      "type": "any[]",
      "defaultValue": []
    },
    "customerName": {
      "type": "string",
      "defaultValue": ""
    },
    "summary": {
      "type": "string",
      "defaultValue": ""
    },
    "quotingAllowed": {
      "type": "boolean",
      "defaultValue": false,
      "description": "isQuotingAllowed(..., 'CUSTOMER'): a quote can be accepted online."
    },
    "billingShown": {
      "type": "boolean",
      "defaultValue": false,
      "description": "EXTERNAL_PROJECT_ASSIGN_ENABLED positively off: invoices are the customer's (New's billing rule)."
    },
    "canCreate": {
      "type": "boolean",
      "defaultValue": false,
      "description": "EQR_CUST_CREATE_REQ is FULL or READ_ONLY (New's rule for New request)."
    },
    "behalf": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Staff using the portal for customers (customerPortal.actsForCustomers)."
    },
    "view": {
      "type": "string",
      "defaultValue": "home",
      "description": "home | requests | equipment | invoices"
    },
    "reqGroup": {
      "type": "string",
      "defaultValue": "open"
    },
    "reqText": {
      "type": "string",
      "defaultValue": ""
    },
    "reqSort": {
      "type": "string",
      "defaultValue": "number"
    },
    "reqDir": {
      "type": "string",
      "defaultValue": "desc"
    },
    "reqChips": {
      "type": "any[]",
      "defaultValue": []
    },
    "reqShown": {
      "type": "any[]",
      "defaultValue": []
    },
    "eqChip": {
      "type": "string",
      "defaultValue": "all"
    },
    "eqText": {
      "type": "string",
      "defaultValue": ""
    },
    "eqChips": {
      "type": "any[]",
      "defaultValue": []
    },
    "eqShown": {
      "type": "any[]",
      "defaultValue": []
    },
    "invChip": {
      "type": "string",
      "defaultValue": "all"
    },
    "invText": {
      "type": "string",
      "defaultValue": ""
    },
    "invChips": {
      "type": "any[]",
      "defaultValue": []
    },
    "invShown": {
      "type": "any[]",
      "defaultValue": []
    },
    "limit": {
      "type": "number",
      "defaultValue": 50
    },
    "linesNote": {
      "type": "string",
      "defaultValue": ""
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "error": {
      "type": "string",
      "defaultValue": ""
    },
    "billingError": {
      "type": "string",
      "defaultValue": ""
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    }
  },
  "events": {
    "portalChanged": {
      "description": "A tab of the portal changed something (resources/js/portalSignal.js): read the home again.",
      "payloadType": "object"
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadChain"
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadChain"
        }
      ]
    },
    "onView": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "view",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onPick": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onSearch": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "{{ $event.target.dataset.field }}",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onSort": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "sort",
            "value": "{{ $event.currentTarget.dataset.key }}"
          }
        }
      ]
    },
    "onOpen": {
      "chains": [
        {
          "chain": "openChain",
          "parameters": {
            "record": "{{ $event.currentTarget.dataset.record }}",
            "id": "{{ $event.currentTarget.dataset.id }}",
            "number": "{{ $event.currentTarget.dataset.number }}",
            "view": "{{ $event.currentTarget.dataset.view }}",
            "chip": "{{ $event.currentTarget.dataset.chip }}"
          }
        }
      ]
    },
    "onNew": {
      "chains": [
        {
          "chain": "openChain",
          "parameters": {
            "record": "customer-order"
          }
        }
      ]
    },
    "onExportMenu": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "exportOpen",
            "value": "toggle"
          }
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onMore": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "limit",
            "value": "more"
          }
        }
      ]
    },
    "portalChanged": {
      "chains": [
        {
          "chain": "loadChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      }
    }
  }
}
