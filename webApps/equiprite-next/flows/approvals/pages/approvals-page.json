{
  "description": "Approve & allocate (FDD 7.8, 7.11): the Equipment Manager's queue of requests to decide and approved lines with no unit yet, most urgent first; a request's lines with availability and suggested units; approve or send back with a reason (one or many requests), auto-allocate or pick units. Under the Redwood look (your menu): Oracle's Smart Search page of the queue (a filter per column, oj-table), and a chosen request under Oracle's general overview header with the way back. The calls are New EquipRite's Approve & allocate chains (resources/js/approveAllocate.js); the logic is resources/js/approvalQueue.js and unitPicker.js.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "isLoading": { "type": "boolean", "defaultValue": true },
    "error": { "type": "string", "defaultValue": "" },
    "access": { "type": "string", "defaultValue": "", "description": "EQR_WORKBENCH: FULL | READ_ONLY | HIDDEN (resources/js/rules.js pageAccess)." },
    "canAct": { "type": "boolean", "defaultValue": false, "description": "FULL access: approve, send back, assign units." },
    "showSource": { "type": "boolean", "defaultValue": false, "description": "Project / customer chips, with the customers module." },
    "linesLoaded": { "type": "boolean", "defaultValue": true },
    "rows": { "type": "any[]", "defaultValue": [], "description": "views/my-requests rows (requestData)." },
    "linesByRequest": { "type": "any", "defaultValue": {} },
    "items": { "type": "any[]", "defaultValue": [], "description": "The queue (approvalQueue.build), most urgent first." },
    "shown": { "type": "any[]", "defaultValue": [], "description": "The queue after the chip, the source and the search." },
    "chips": { "type": "any[]", "defaultValue": [] },
    "summary": { "type": "string", "defaultValue": "" },
    "text": { "type": "string", "defaultValue": "" },
    "stage": { "type": "string", "defaultValue": "all" },
    "source": { "type": "string", "defaultValue": "" },
    "limit": { "type": "number", "defaultValue": 60 },
    "exportOpen": { "type": "boolean", "defaultValue": false },
    "selectedIds": { "type": "any[]", "defaultValue": [], "description": "Ticked requests to decide (queue keys)." },
    "selection": { "type": "any", "defaultValue": { "count": 0, "ids": [], "text": "" } },
    "bulk": { "type": "any", "defaultValue": { "mode": "", "reason": "", "error": "" }, "description": "mode reject: the send-back confirmation with its reason." },
    "bulkResult": { "type": "any", "defaultValue": null },
    "current": { "type": "any", "defaultValue": { "key": "" }, "description": "The queue item open in the panel." },
    "focus": { "type": "any", "defaultValue": { "number": "" }, "description": "focusChain: the one request another screen opened here ({ key, number, label, open, missing }): only it is shown, with Back to the screen it came from, until Show the whole queue." },
    "rec": { "type": "any", "defaultValue": { "loading": false, "error": "", "head": {}, "rows": [], "verdict": { "tone": "", "text": "", "next": "" } } },
    "lines": { "type": "any[]", "defaultValue": [], "description": "The open request's lines (approveAllocate.loadLines), what the writes act on." },
    "ticks": { "type": "any[]", "defaultValue": [], "description": "Ticked line ids, in the order ticked: a decision acts on these, or on every line." },
    "confirm": { "type": "string", "defaultValue": "", "description": "reject | auto: the confirmation open in the panel." },
    "reason": { "type": "string", "defaultValue": "" },
    "formError": { "type": "string", "defaultValue": "" },
    "busy": { "type": "boolean", "defaultValue": false },
    "busyText": { "type": "string", "defaultValue": "" },
    "busyWhere": { "type": "string", "defaultValue": "", "description": "bulk | panel: where the progress shows." },
    "result": { "type": "any", "defaultValue": null, "description": "What the last action did, in words: { tone, text, items }." },
    "sugg": { "type": "any", "defaultValue": { "loading": false, "byLine": {}, "plan": { "count": 0, "lines": [], "none": [], "label": "" } } },
    "picker": { "type": "any", "defaultValue": { "lineId": "" }, "description": "The unit picker open under a line (staging kept in the page module)." },
    "pickTick": { "type": "number", "defaultValue": 0 },
    "pickNote": { "type": "string", "defaultValue": "" },
    "recSeq": { "type": "number", "defaultValue": 0 },
    "settled": { "type": "any", "defaultValue": {}, "description": "Requests read with nothing left to assign: { key: lines taking no unit }. They leave the queue for this tab." },
    "rwShown": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the queue as its table shows it (shown, then the column filters: approvalQueue.byColumns); what its Export takes." },
    "rwRows": { "type": "any[]", "defaultValue": [], "description": "Redwood view: one row per request in rwShown (approvalQueue.redwoodRows, with ticked and tickable), for the oj-table." },
    "rwADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "key", "data": "{{ $page.variables.rwRows }}" } },
    "rwCriterion": { "type": "any", "description": "Redwood view: the Smart Search criterion (text and filters); rwFilterChain turns it into text, stage, source and rwCols." },
    "rwCols": { "type": "object", "defaultValue": { "number": "", "party": "", "equipment": "", "dates": "", "requester": "" },
      "description": "Redwood view: the column filters picked in Smart Search (rwFilterChain), as approvalQueue.byColumns reads them; Waiting for and Type are stage and source." },
    "rwSearchConfig": { "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory", "defaultValue": { "url": "[[ $application.path + 'resources/data/approvalsSearchConfig.json' ]]" } },
    "rwNumbers": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Request filter's options (applyChain, approvalQueue.columnOptions)." },
    "rwNumbersADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwNumbers }}" } },
    "rwParties": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Project or customer filter's options with their counts." },
    "rwPartiesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwParties }}" } },
    "rwNeeds": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Waiting for filter's options (the chips, with their counts)." },
    "rwNeedsADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwNeeds }}" } },
    "rwEquipment": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Equipment filter's options (the waiting lines' equipment) with their counts." },
    "rwEquipmentADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwEquipment }}" } },
    "rwDates": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Dates filter's options (where each start date stands) with their counts." },
    "rwDatesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwDates }}" } },
    "rwTypes": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Type filter's options (Project, Customer) with their counts." },
    "rwTypesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwTypes }}" } },
    "rwRequesters": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Requester filter's options with their counts." },
    "rwRequestersADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwRequesters }}" } },
    "rwSearchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
            "RequestFilter": { "label": "Request", "options": { "optionsData": "[[ $page.variables.rwNumbersADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "PartyFilter": { "label": "Project or customer", "options": { "optionsData": "[[ $page.variables.rwPartiesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "NeedsFilter": { "label": "Waiting for", "options": { "optionsData": "[[ $page.variables.rwNeedsADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "EquipmentFilter": { "label": "Equipment", "options": { "optionsData": "[[ $page.variables.rwEquipmentADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "DatesFilter": { "label": "Dates", "options": { "optionsData": "[[ $page.variables.rwDatesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "TypeFilter": { "label": "Type", "options": { "optionsData": "[[ $page.variables.rwTypesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "RequesterFilter": { "label": "Requester", "options": { "optionsData": "[[ $page.variables.rwRequestersADP ]]", "optionsKeys": { "label": "label", "value": "value" } } }
          }
        }
      }
    }
  },
  "events": {
    "focusRequest": { "description": "From resources/js/shellBus.js focus(): another screen handed this one a request to open.", "payloadType": "object" }
  },
  "eventListeners": {
    "focusRequest": { "chains": [{ "chain": "focusChain" }] },
    "vbEnter": { "chains": [{ "chain": "loadChain", "parameters": { "refresh": false } }] },
    "onRefresh": { "chains": [{ "chain": "loadChain", "parameters": { "refresh": true, "reopen": true } }] },
    "onSearch": { "chains": [{ "chain": "setChain", "parameters": { "field": "text", "value": "{{ $event.target.value }}" } }] },
    "onPick": { "chains": [{ "chain": "setChain", "parameters": { "field": "{{ $event.currentTarget.dataset.field }}", "value": "{{ $event.currentTarget.dataset.value }}" } }] },
    "onExportMenu": { "chains": [{ "chain": "setChain", "parameters": { "field": "exportOpen", "value": "toggle" } }] },
    "onExport": { "chains": [{ "chain": "exportChain", "parameters": { "format": "{{ $event.currentTarget.dataset.format }}" } }] },
    "onMore": { "chains": [{ "chain": "setChain", "parameters": { "field": "limit", "value": "more" } }] },
    "onTick": { "chains": [{ "chain": "tickChain", "parameters": { "id": "{{ $event.target.dataset.id }}", "checked": "{{ $event.target.checked }}" } }] },
    "onBulk": { "chains": [{ "chain": "bulkChain", "parameters": { "action": "{{ $event.currentTarget.dataset.action }}" } }] },
    "onBulkReason": { "chains": [{ "chain": "setChain", "parameters": { "field": "bulkReason", "value": "{{ $event.target.value }}" } }] },
    "onDismissBulk": { "chains": [{ "chain": "setChain", "parameters": { "field": "bulkResult", "value": "" } }] },
    "onSelect": { "chains": [{ "chain": "selectChain", "parameters": { "key": "{{ $event.currentTarget.dataset.key }}" } }] },
    "onBack": { "chains": [{ "chain": "selectChain", "parameters": { "key": "" } }] },
    "onLineTick": { "chains": [{ "chain": "lineTickChain", "parameters": { "id": "{{ $event.target.dataset.id }}", "checked": "{{ $event.target.checked }}" } }] },
    "onDecide": { "chains": [{ "chain": "decideChain", "parameters": { "action": "{{ $event.currentTarget.dataset.action }}" } }] },
    "onReason": { "chains": [{ "chain": "setChain", "parameters": { "field": "reason", "value": "{{ $event.target.value }}" } }] },
    "onAuto": { "chains": [{ "chain": "autoChain", "parameters": { "action": "{{ $event.currentTarget.dataset.action }}" } }] },
    "onUnits": { "chains": [{ "chain": "unitsChain", "parameters": { "lineId": "{{ $event.currentTarget.dataset.line }}" } }] },
    "onCloseUnits": { "chains": [{ "chain": "unitsChain", "parameters": { "close": true } }] },
    "onStage": { "chains": [{ "chain": "stageChain", "parameters": { "action": "{{ $event.currentTarget.dataset.action }}", "id": "{{ $event.currentTarget.dataset.id }}" } }] },
    "onLotQty": { "chains": [{ "chain": "stageChain", "parameters": { "action": "qty", "id": "{{ $event.target.dataset.id }}", "qty": "{{ $event.target.value }}" } }] },
    "onSaveUnits": { "chains": [{ "chain": "saveUnitsChain" }] },
    "onOpenRecord": { "chains": [{ "chain": "openRecordChain", "parameters": { "id": "{{ $event.currentTarget.dataset.id }}", "number": "{{ $event.currentTarget.dataset.number }}" } }] },
    "onDismissResult": { "chains": [{ "chain": "setChain", "parameters": { "field": "result", "value": "" } }] },
    "onFocusAll": { "chains": [{ "chain": "setChain", "parameters": { "field": "focusAll", "value": "" } }] },
    "onFocusBack": { "chains": [{ "chain": "setChain", "parameters": { "field": "focusBack", "value": "" } }] },
    "onConfirmPicking": { "chains": [{ "chain": "confirmChain" }] },
    "onRwFilter": { "chains": [{ "chain": "rwFilterChain" }] },
    "onRwRow": { "chains": [{ "chain": "selectChain", "parameters": { "key": "{{ $event.detail.context.key }}" } }] },
    "onRwTickNone": { "chains": [{ "chain": "tickChain", "parameters": { "id": "none", "checked": false } }] },
    "onRwExport": { "chains": [{ "chain": "exportChain", "parameters": { "format": "xlsx", "view": "redwood" } }] },
    "onRwAction": { "chains": [{ "chain": "rwActionChain", "parameters": { "id": "{{ $event.detail.secondaryItem }}" } }] },
    "onRwBack": { "chains": [{ "chain": "rwActionChain", "parameters": { "id": "back" } }] }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" },
      "oj-sp-smart-search-page": { "path": "oj-sp/smart-search-page/loader" },
      "oj-sp-smart-search": { "path": "oj-sp/smart-search/loader" },
      "oj-sp-collection-container": { "path": "oj-sp/collection-container/loader" },
      "oj-sp-general-overview-page": { "path": "oj-sp/general-overview-page/loader" },
      "oj-table": { "path": "ojs/ojtable" },
      "oj-c-button": { "path": "oj-c/button" }
    }
  }
}
