{
  "description": "Approve time (FDD 7.14, 7.14.3, S21): every submitted line of a week across requests, what needs a look first (a day over 10 h or 16 h, a big change on last week), select the lines that look right and approve them in one go, reject, or adjust hours with an audit entry (the line stays submitted). Reads views/timesheet-approval-details, the audit trail and the cost so far; Approve, Reject and Adjust send what New EquipRite's Timesheet approval sends. Under Fusion PPM rates approving also sends the hours to Fusion, so it is left to New EquipRite. Logic: resources/js/timeApproval.js (New's rules, unchanged).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "closed": {
      "type": "string",
      "defaultValue": ""
    },
    "rowsAll": {
      "type": "any[]",
      "defaultValue": [],
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "weekKey": {
      "type": "string",
      "defaultValue": "",
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "weekDays": {
      "type": "any[]",
      "defaultValue": [],
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "statusKey": {
      "type": "string",
      "defaultValue": "SUBMITTED",
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "searchText": {
      "type": "string",
      "defaultValue": "",
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "compare": {
      "type": "boolean",
      "defaultValue": false
    },
    "onlyLook": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Show only the lines that need a look.",
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "picked": {
      "type": "any",
      "defaultValue": {}
    },
    "adjust": {
      "type": "any",
      "defaultValue": null,
      "description": "The line being adjusted: { key, days: [7 strings], reason }."
    },
    "auditByEntry": {
      "type": "any",
      "defaultValue": {},
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "costByRequest": {
      "type": "any",
      "defaultValue": {},
      "description": "Cost so far per request (views/project-cost-detail)."
    },
    "confirm": {
      "type": "string",
      "defaultValue": "",
      "description": "approve or reject while the confirmation is open."
    },
    "ppmOn": {
      "type": "boolean",
      "defaultValue": false
    },
    "readOnly": {
      "type": "boolean",
      "defaultValue": false,
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "isWorking": {
      "type": "boolean",
      "defaultValue": false
    },
    "loadError": {
      "type": "string",
      "defaultValue": ""
    },
    "actionError": {
      "type": "string",
      "defaultValue": ""
    },
    "actionNote": {
      "type": "string",
      "defaultValue": ""
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "rwRows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look (your menu): one oj-table row per line shown (rwApplyChain: the current look's shown(), narrowed by rwCols)."
    },
    "rwADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "key",
        "data": "{{ $page.variables.rwRows }}"
      }
    },
    "rwKeys": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the keys of the lines its table shows (for its export)."
    },
    "rwPage": {
      "type": "object",
      "defaultValue": {
        "text": "",
        "week": "",
        "status": "",
        "hours": ""
      },
      "description": "Redwood look: what Smart Search last said for the page's own week, status, search and needs-a-look (rwFilterChain passes on only a change)."
    },
    "rwCriterion": {
      "type": "any",
      "description": "Redwood look: the Smart Search criterion (text and filters); rwFilterChain reads it."
    },
    "rwCols": {
      "type": "object",
      "defaultValue": {
        "number": "",
        "project": "",
        "type": "",
        "hours": "",
        "change": "",
        "equipment": "",
        "submitter": ""
      },
      "description": "Redwood look: the column filters picked in Smart Search (rwFilterChain); they narrow the Redwood table only."
    },
    "rwSearchConfig": {
      "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory",
      "defaultValue": {
        "url": "[[ $application.path + 'resources/data/approveTimeSearchConfig.json' ]]"
      }
    },
    "rwNumbers": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Request filter's options with their counts (rwApplyChain, usageRedwood.taOptions)."
    },
    "rwNumbersADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwNumbers }}"
      }
    },
    "rwProjects": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Project filter's options with their counts."
    },
    "rwProjectsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwProjects }}"
      }
    },
    "rwTypes": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Rate type filter's options with their counts."
    },
    "rwTypesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwTypes }}"
      }
    },
    "rwHours": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Hours filter's options (needs a look: the page's own onlyLook; looks right) with their counts."
    },
    "rwHoursADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwHours }}"
      }
    },
    "rwChanges": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the On last week filter's options with their counts."
    },
    "rwChangesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwChanges }}"
      }
    },
    "rwStatuses": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Status filter's options: the page's own status buttons (statusKey) with their counts."
    },
    "rwStatusesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwStatuses }}"
      }
    },
    "rwWeeks": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Week filter's options: the page's own week chips (weekKey) with how many lines each holds."
    },
    "rwWeeksADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwWeeks }}"
      }
    },
    "rwEquipment": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Equipment filter's options with their counts."
    },
    "rwEquipmentADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwEquipment }}"
      }
    },
    "rwSubmitters": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Submitted by filter's options with their counts."
    },
    "rwSubmittersADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwSubmitters }}"
      }
    },
    "rwSearchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
            "RequestFilter": {
              "label": "Request",
              "options": {
                "optionsData": "[[ $page.variables.rwNumbersADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "ProjectFilter": {
              "label": "Project",
              "options": {
                "optionsData": "[[ $page.variables.rwProjectsADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "TypeFilter": {
              "label": "Rate type",
              "options": {
                "optionsData": "[[ $page.variables.rwTypesADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "HoursFilter": {
              "label": "Hours",
              "options": {
                "optionsData": "[[ $page.variables.rwHoursADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "ChangeFilter": {
              "label": "On last week",
              "options": {
                "optionsData": "[[ $page.variables.rwChangesADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "StatusFilter": {
              "label": "Status",
              "options": {
                "optionsData": "[[ $page.variables.rwStatusesADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "WeekFilter": {
              "label": "Week",
              "options": {
                "optionsData": "[[ $page.variables.rwWeeksADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "EquipmentFilter": {
              "label": "Equipment",
              "options": {
                "optionsData": "[[ $page.variables.rwEquipmentADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "SubmitterFilter": {
              "label": "Submitted by",
              "options": {
                "optionsData": "[[ $page.variables.rwSubmittersADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            }
          }
        }
      },
      "description": "Redwood look: every filter in the search config has its entry here (one without throws and blanks the table)."
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [{ "chain": "loadChain" }]
    },
    "onRefresh": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "refresh" } }]
    },
    "onWeek": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "week", "value": "{{ $event.currentTarget.dataset.week }}" } }]
    },
    "onStatus": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "status", "value": "{{ $event.currentTarget.dataset.status }}" } }]
    },
    "onSearch": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "text", "value": "{{ $event.target.value }}" } }]
    },
    "onCompare": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "compare", "value": "{{ $event.target.checked }}" } }]
    },
    "onOnlyLook": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "onlyLook" } }]
    },
    "onPick": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "pick", "key": "{{ $event.target.dataset.key }}", "value": "{{ $event.target.checked }}" } }]
    },
    "onPickAll": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "pickAll", "value": "{{ $event.target.checked }}" } }]
    },
    "onPickClean": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "pickClean" } }]
    },
    "onPickNone": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "pickAll", "value": "false" } }]
    },
    "onAskApprove": {
      "chains": [{ "chain": "approveChain", "parameters": { "step": "ask" } }]
    },
    "onAskReject": {
      "chains": [{ "chain": "rejectChain", "parameters": { "step": "ask" } }]
    },
    "onCancelConfirm": {
      "chains": [{ "chain": "approveChain", "parameters": { "step": "cancel" } }]
    },
    "onApprove": {
      "chains": [{ "chain": "approveChain", "parameters": { "step": "go" } }]
    },
    "onReject": {
      "chains": [{ "chain": "rejectChain", "parameters": { "step": "go" } }]
    },
    "onAdjustStart": {
      "chains": [{ "chain": "adjustChain", "parameters": { "action": "start", "key": "{{ $event.currentTarget.dataset.key }}" } }]
    },
    "onAdjustDay": {
      "chains": [{ "chain": "adjustChain", "parameters": { "action": "day", "day": "{{ $event.target.dataset.d }}", "value": "{{ $event.target.value }}" } }]
    },
    "onAdjustReason": {
      "chains": [{ "chain": "adjustChain", "parameters": { "action": "reason", "value": "{{ $event.target.value }}" } }]
    },
    "onAdjustCancel": {
      "chains": [{ "chain": "adjustChain", "parameters": { "action": "cancel" } }]
    },
    "onAdjustSave": {
      "chains": [{ "chain": "adjustChain", "parameters": { "action": "save" } }]
    },
    "onExportMenu": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "exportOpen" } }]
    },
    "onExport": {
      "chains": [{ "chain": "exportChain", "parameters": { "format": "{{ $event.currentTarget.dataset.format }}" } }]
    },
    "onOpenTimesheets": {
      "chains": [{ "chain": "openScreenChain", "parameters": { "navId": "timesheets" } }]
    },
    "onRwFilter": { "chains": [{ "chain": "rwFilterChain" }] },
    "onRwRow": { "chains": [{ "chain": "rwPickChain", "parameters": { "key": "{{ $event.detail.context.key }}" } }] },
    "onRwExport": { "chains": [{ "chain": "exportChain", "parameters": { "format": "xlsx", "redwood": true } }] },
    "onRwPickAll": { "chains": [{ "chain": "filterChain", "parameters": { "action": "pickAll", "value": "true", "redwood": true } }] },
    "onRwPickClean": { "chains": [{ "chain": "filterChain", "parameters": { "action": "pickClean", "redwood": true } }] }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" },
      "oj-sp-smart-search-page": { "path": "oj-sp/smart-search-page/loader" },
      "oj-sp-smart-search": { "path": "oj-sp/smart-search/loader" },
      "oj-sp-collection-container": { "path": "oj-sp/collection-container/loader" },
      "oj-table": { "path": "ojs/ojtable" },
      "oj-c-button": { "path": "oj-c/button" }
    }
  }
}
