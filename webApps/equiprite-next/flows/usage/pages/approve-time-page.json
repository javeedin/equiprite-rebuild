{
  "description": "Approve time (FDD 7.14, 7.14.3, S21): every submitted line of a week across requests, what needs a look first (a day over 10 h or 16 h, a big change on last week), select the lines that look right and approve them in one go, reject, or adjust hours with an audit entry (the line stays submitted). Reads views/timesheet-approval-details, the audit trail and the cost so far; Approve, Reject and Adjust send what New EquipRite's Timesheet approval sends. Under Fusion PPM rates approving also sends the hours to Fusion, so it is left to New EquipRite. Logic: resources/js/timeApproval.js (New's rules, unchanged).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "closed": {
      "type": "string",
      "defaultValue": ""
    },
    "rowsAll": {
      "type": "any[]",
      "defaultValue": []
    },
    "weekKey": {
      "type": "string",
      "defaultValue": ""
    },
    "weekDays": {
      "type": "any[]",
      "defaultValue": []
    },
    "statusKey": {
      "type": "string",
      "defaultValue": "SUBMITTED"
    },
    "searchText": {
      "type": "string",
      "defaultValue": ""
    },
    "compare": {
      "type": "boolean",
      "defaultValue": false
    },
    "onlyLook": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Show only the lines that need a look."
    },
    "picked": {
      "type": "any",
      "defaultValue": {}
    },
    "adjust": {
      "type": "any",
      "defaultValue": null,
      "description": "The line being adjusted: { key, days: [7 strings], reason }."
    },
    "auditByEntry": {
      "type": "any",
      "defaultValue": {}
    },
    "costByRequest": {
      "type": "any",
      "defaultValue": {},
      "description": "Cost so far per request (views/project-cost-detail)."
    },
    "confirm": {
      "type": "string",
      "defaultValue": "",
      "description": "approve or reject while the confirmation is open."
    },
    "ppmOn": {
      "type": "boolean",
      "defaultValue": false
    },
    "readOnly": {
      "type": "boolean",
      "defaultValue": false
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "isWorking": {
      "type": "boolean",
      "defaultValue": false
    },
    "loadError": {
      "type": "string",
      "defaultValue": ""
    },
    "actionError": {
      "type": "string",
      "defaultValue": ""
    },
    "actionNote": {
      "type": "string",
      "defaultValue": ""
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [{ "chain": "loadChain" }]
    },
    "onRefresh": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "refresh" } }]
    },
    "onWeek": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "week", "value": "{{ $event.currentTarget.dataset.week }}" } }]
    },
    "onStatus": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "status", "value": "{{ $event.currentTarget.dataset.status }}" } }]
    },
    "onSearch": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "text", "value": "{{ $event.target.value }}" } }]
    },
    "onCompare": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "compare", "value": "{{ $event.target.checked }}" } }]
    },
    "onOnlyLook": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "onlyLook" } }]
    },
    "onPick": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "pick", "key": "{{ $event.target.dataset.key }}", "value": "{{ $event.target.checked }}" } }]
    },
    "onPickAll": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "pickAll", "value": "{{ $event.target.checked }}" } }]
    },
    "onPickClean": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "pickClean" } }]
    },
    "onPickNone": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "pickAll", "value": "false" } }]
    },
    "onAskApprove": {
      "chains": [{ "chain": "approveChain", "parameters": { "step": "ask" } }]
    },
    "onAskReject": {
      "chains": [{ "chain": "rejectChain", "parameters": { "step": "ask" } }]
    },
    "onCancelConfirm": {
      "chains": [{ "chain": "approveChain", "parameters": { "step": "cancel" } }]
    },
    "onApprove": {
      "chains": [{ "chain": "approveChain", "parameters": { "step": "go" } }]
    },
    "onReject": {
      "chains": [{ "chain": "rejectChain", "parameters": { "step": "go" } }]
    },
    "onAdjustStart": {
      "chains": [{ "chain": "adjustChain", "parameters": { "action": "start", "key": "{{ $event.currentTarget.dataset.key }}" } }]
    },
    "onAdjustDay": {
      "chains": [{ "chain": "adjustChain", "parameters": { "action": "day", "day": "{{ $event.target.dataset.d }}", "value": "{{ $event.target.value }}" } }]
    },
    "onAdjustReason": {
      "chains": [{ "chain": "adjustChain", "parameters": { "action": "reason", "value": "{{ $event.target.value }}" } }]
    },
    "onAdjustCancel": {
      "chains": [{ "chain": "adjustChain", "parameters": { "action": "cancel" } }]
    },
    "onAdjustSave": {
      "chains": [{ "chain": "adjustChain", "parameters": { "action": "save" } }]
    },
    "onExportMenu": {
      "chains": [{ "chain": "filterChain", "parameters": { "action": "exportOpen" } }]
    },
    "onExport": {
      "chains": [{ "chain": "exportChain", "parameters": { "format": "{{ $event.currentTarget.dataset.format }}" } }]
    },
    "onOpenTimesheets": {
      "chains": [{ "chain": "openScreenChain", "parameters": { "navId": "timesheets" } }]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" }
    }
  }
}
