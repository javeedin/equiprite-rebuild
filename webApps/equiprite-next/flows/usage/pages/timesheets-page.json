{
  "description": "Timesheets (FDD 7.13): the requests on site and a week of hours for one of them, typed from the keyboard, with totals, what is missing and Copy last week. Reads views/timesheets and views/timesheet-details/{week}/{request}; Save and Submit send what New EquipRite's Time entry sends (patchTimeEntry / createTimeEntry, createTimeEntryDay for each day, patchRequestLinesBatch for expenditure types, then SUBMITTED), in the same order, and read the week back. Logic: resources/js/timeEntry.js (New's rules, unchanged).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "closed": {
      "type": "string",
      "defaultValue": "",
      "description": "Why the screen is closed (usageAccess), in words; empty when it is open."
    },
    "queue": {
      "type": "any[]",
      "defaultValue": [],
      "description": "views/timesheets: one row per request on site, with its current week.",
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "queueText": {
      "type": "string",
      "defaultValue": "",
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "queueKind": {
      "type": "string",
      "defaultValue": "all",
      "description": "all | todo | waiting | approved",
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "queueLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "requestNumber": {
      "type": "string",
      "defaultValue": "",
      "onValueChanged": { "chains": [{ "chain": "rwApplyChain" }] }
    },
    "projectName": {
      "type": "string",
      "defaultValue": ""
    },
    "weekStart": {
      "type": "string",
      "defaultValue": ""
    },
    "weeks": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Every week (Monday) of the request's rental span; the week arrows stay inside it."
    },
    "weekDays": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The seven days of weekStart. Replaced only when the week changes, so the grid does not re-render while typing."
    },
    "rows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The week's rows as loaded (New's buildRows)."
    },
    "apiRows": {
      "type": "any[]",
      "defaultValue": []
    },
    "edits": {
      "type": "any",
      "defaultValue": {},
      "description": "What the user typed, keyed '<rowKey>|d<0-6>', '<rowKey>|type', '<rowKey>|exp'."
    },
    "picked": {
      "type": "any",
      "defaultValue": {},
      "description": "Rows ticked for Submit: { rowKey: true }."
    },
    "headerStatus": {
      "type": "string",
      "defaultValue": ""
    },
    "expTypeList": {
      "type": "any[]",
      "defaultValue": [
        { "value": "Equipment", "label": "Equipment" },
        { "value": "Purchased Equipment", "label": "Purchased Equipment" },
        { "value": "Supplies", "label": "Supplies" },
        { "value": "Miscellaneous", "label": "Miscellaneous" }
      ]
    },
    "internalRequestId": {
      "type": "number",
      "defaultValue": 0
    },
    "lineRates": {
      "type": "any",
      "defaultValue": {},
      "description": "{ lineId: { billRate, priceUom } } from views/request-detail-lines."
    },
    "ppmOn": {
      "type": "boolean",
      "defaultValue": false
    },
    "readOnly": {
      "type": "boolean",
      "defaultValue": false
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "isSaving": {
      "type": "boolean",
      "defaultValue": false
    },
    "saveMode": {
      "type": "string",
      "defaultValue": ""
    },
    "loadError": {
      "type": "string",
      "defaultValue": ""
    },
    "saveError": {
      "type": "string",
      "defaultValue": ""
    },
    "notice": {
      "type": "string",
      "defaultValue": ""
    },
    "pendingMove": {
      "type": "any",
      "defaultValue": null,
      "description": "A week or request change waiting on Discard, because the week has unsaved hours."
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "rwRows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look (your menu): one oj-table row per request on site shown (rwApplyChain: the current look's queueShown, narrowed by rwCols)."
    },
    "rwADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "key",
        "data": "{{ $page.variables.rwRows }}"
      }
    },
    "rwShown": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the requests its table shows, as loaded (for its export)."
    },
    "rwPage": {
      "type": "object",
      "defaultValue": { "text": "", "status": "" },
      "description": "Redwood look: what Smart Search last said for the page's own search and chip (rwFilterChain passes on only a change)."
    },
    "rwCriterion": {
      "type": "any",
      "description": "Redwood look: the Smart Search criterion (text and filters); rwFilterChain reads it."
    },
    "rwCols": {
      "type": "object",
      "defaultValue": {
        "number": "",
        "project": "",
        "task": "",
        "equipment": "",
        "week": "",
        "hours": ""
      },
      "description": "Redwood look: the column filters picked in Smart Search (rwFilterChain); they narrow the Redwood table only."
    },
    "rwSearchConfig": {
      "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory",
      "defaultValue": {
        "url": "[[ $application.path + 'resources/data/timesheetsSearchConfig.json' ]]"
      }
    },
    "rwNumbers": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Request filter's options (rwApplyChain, usageRedwood.tsOptions)."
    },
    "rwNumbersADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwNumbers }}"
      }
    },
    "rwProjects": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Project filter's options with their counts."
    },
    "rwProjectsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwProjects }}"
      }
    },
    "rwTasks": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Task filter's options with their counts."
    },
    "rwTasksADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwTasks }}"
      }
    },
    "rwEquipment": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Equipment filter's options (how many pieces) with their counts."
    },
    "rwEquipmentADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwEquipment }}"
      }
    },
    "rwWeeks": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Week filter's options (each request's current week) with their counts."
    },
    "rwWeeksADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwWeeks }}"
      }
    },
    "rwHours": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Hours filter's options (no hours yet, with hours) with their counts."
    },
    "rwHoursADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwHours }}"
      }
    },
    "rwStatuses": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood look: the Status filter's options: the current look's chips (queueKind) with their counts."
    },
    "rwStatusesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwStatuses }}"
      }
    },
    "rwSearchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
            "RequestFilter": {
              "label": "Request",
              "options": {
                "optionsData": "[[ $page.variables.rwNumbersADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "ProjectFilter": {
              "label": "Project",
              "options": {
                "optionsData": "[[ $page.variables.rwProjectsADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "TaskFilter": {
              "label": "Task",
              "options": {
                "optionsData": "[[ $page.variables.rwTasksADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "EquipmentFilter": {
              "label": "Equipment",
              "options": {
                "optionsData": "[[ $page.variables.rwEquipmentADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "WeekFilter": {
              "label": "Week",
              "options": {
                "optionsData": "[[ $page.variables.rwWeeksADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "HoursFilter": {
              "label": "Hours",
              "options": {
                "optionsData": "[[ $page.variables.rwHoursADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "StatusFilter": {
              "label": "Status",
              "options": {
                "optionsData": "[[ $page.variables.rwStatusesADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            }
          }
        }
      },
      "description": "Redwood look: every filter in the search config has its entry here (one without throws and blanks the table)."
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [{ "chain": "loadChain" }]
    },
    "onRefresh": {
      "chains": [{ "chain": "moveChain", "parameters": { "refresh": "yes" } }]
    },
    "onQueueSearch": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "queueText", "value": "{{ $event.target.value }}" } }]
    },
    "onQueueKind": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "queueKind", "value": "{{ $event.currentTarget.dataset.value }}" } }]
    },
    "onPickRequest": {
      "chains": [{ "chain": "moveChain", "parameters": { "requestNumber": "{{ $event.currentTarget.dataset.request }}" } }]
    },
    "onWeekStep": {
      "chains": [{ "chain": "moveChain", "parameters": { "dir": "{{ $event.currentTarget.dataset.dir }}" } }]
    },
    "onThisWeek": {
      "chains": [{ "chain": "moveChain", "parameters": { "week": "today" } }]
    },
    "onDiscardMove": {
      "chains": [{ "chain": "moveChain", "parameters": { "confirm": "discard" } }]
    },
    "onKeepEditing": {
      "chains": [{ "chain": "moveChain", "parameters": { "confirm": "stay" } }]
    },
    "onHours": {
      "chains": [
        {
          "chain": "editChain",
          "parameters": {
            "action": "hours",
            "key": "{{ $event.target.dataset.key }}",
            "day": "{{ $event.target.dataset.d }}",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onRowField": {
      "chains": [
        {
          "chain": "editChain",
          "parameters": {
            "action": "{{ $event.target.dataset.field }}",
            "key": "{{ $event.target.dataset.key }}",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onPick": {
      "chains": [
        {
          "chain": "editChain",
          "parameters": { "action": "pick", "key": "{{ $event.target.dataset.key }}", "value": "{{ $event.target.checked }}" }
        }
      ]
    },
    "onPickAll": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "pickAll", "value": "{{ $event.target.checked }}" } }]
    },
    "onUndo": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "undo" } }]
    },
    "onCopyLastWeek": {
      "chains": [{ "chain": "copyLastWeekChain" }]
    },
    "onSave": {
      "chains": [{ "chain": "saveTimesheetChain", "parameters": { "mode": "save" } }]
    },
    "onSubmit": {
      "chains": [{ "chain": "saveTimesheetChain", "parameters": { "mode": "submit" } }]
    },
    "onExportMenu": {
      "chains": [{ "chain": "editChain", "parameters": { "action": "exportOpen" } }]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": { "format": "{{ $event.currentTarget.dataset.format }}", "what": "{{ $event.currentTarget.dataset.what }}" }
        }
      ]
    },
    "onOpenApprove": {
      "chains": [{ "chain": "openScreenChain", "parameters": { "navId": "approve-time" } }]
    },
    "onRwFilter": { "chains": [{ "chain": "rwFilterChain" }] },
    "onRwRow": { "chains": [{ "chain": "moveChain", "parameters": { "requestNumber": "{{ $event.detail.context.key }}" } }] },
    "onRwExport": { "chains": [{ "chain": "exportChain", "parameters": { "format": "xlsx", "what": "rwqueue" } }] }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" },
      "oj-sp-smart-search-page": { "path": "oj-sp/smart-search-page/loader" },
      "oj-sp-smart-search": { "path": "oj-sp/smart-search/loader" },
      "oj-sp-collection-container": { "path": "oj-sp/collection-container/loader" },
      "oj-table": { "path": "ojs/ojtable" },
      "oj-c-button": { "path": "oj-c/button" }
    }
  }
}
