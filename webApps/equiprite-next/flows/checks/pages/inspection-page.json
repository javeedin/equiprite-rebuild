{
  "description": "Inspections (FDD 7.12, 7.17.3, S16, DP-03): the inspector's queue (units leaving the yard, arriving on site, leaving a site, back at the yard, failed), a unit's whole checklist with pass / fail and notes, defects with photos, the PASS / CONDITIONAL / FAIL result and what happens to a failed unit. Rules and calls are New EquipRite's (resources/js/inspectionRules.js, New's inspection page module unchanged): workbench-requests OUTBOUND + INBOUND, request-detail-lines, conf-inspection-details; inspection-checklists, inspections; POST inspections, POST/PATCH inspection-responses, POST inspection-defects + a commonService photo each, PATCH inspections COMPLETED, PATCH lines/batch at the yard ship-out. The maintenance work order (INT-13) is Fusion and is not raised here. Under Redwood (your menu, Look) the queue is Oracle's Smart Search page over an oj-table, a filter per column (the chips are its Inspection filter, Asked for / Everything waiting its Which units filter); a row opens the unit's checklist under Oracle's general overview page (its point or result as the badge, its request as an action, back to the queue).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "lines": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Every request line waiting at an inspection point (request-detail-lines rows)."
    },
    "matrix": {
      "type": "any[]",
      "defaultValue": [],
      "description": "conf-inspection-details rows: class / subclass / equipment x inspection point."
    },
    "matrixNote": {
      "type": "string",
      "defaultValue": ""
    },
    "truncatedNote": {
      "type": "string",
      "defaultValue": ""
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": true
    },
    "loadError": {
      "type": "string",
      "defaultValue": ""
    },
    "scope": {
      "type": "string",
      "defaultValue": "required",
      "description": "required = units the inspection matrix asks for; all = every unit waiting at a point."
    },
    "chip": {
      "type": "string",
      "defaultValue": "all",
      "description": "all | late | SHIP_OUT_YARD | RECEIVE_SITE | SHIP_OUT_SITE | RECEIVE_YARD | failed"
    },
    "text": {
      "type": "string",
      "defaultValue": ""
    },
    "entries": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The queue with its words (inspectionQueue.entries)."
    },
    "shown": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The queue as shown: the chip and the search applied."
    },
    "chips": {
      "type": "any[]",
      "defaultValue": []
    },
    "summary": {
      "type": "string",
      "defaultValue": ""
    },
    "exportOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "inspector": {
      "type": "string",
      "defaultValue": ""
    },
    "current": {
      "type": "any",
      "defaultValue": null,
      "description": "The unit being inspected (a queue entry: the line plus point, pointLabel, required)."
    },
    "openToken": {
      "type": "number",
      "defaultValue": 0
    },
    "checklist": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The questions (inspectionRules checklistItem shape)."
    },
    "checklistLoading": {
      "type": "boolean",
      "defaultValue": false
    },
    "checklistError": {
      "type": "string",
      "defaultValue": ""
    },
    "history": {
      "type": "any[]",
      "defaultValue": []
    },
    "answers": {
      "type": "any",
      "defaultValue": {},
      "description": "Question id -> { value, note }."
    },
    "defects": {
      "type": "any[]",
      "defaultValue": [],
      "description": "{ key, itemId, checklistId, description, severity, action, cost, photo: { name, size, url }, saved }. The photo File itself is held by the page module."
    },
    "notes": {
      "type": "string",
      "defaultValue": ""
    },
    "ack": {
      "type": "boolean",
      "defaultValue": false
    },
    "saved": {
      "type": "any",
      "defaultValue": {},
      "description": "What the save has already written, so a retry continues instead of duplicating: { inspectionId, responses, defects, photos }."
    },
    "photoError": {
      "type": "string",
      "defaultValue": ""
    },
    "isSaving": {
      "type": "boolean",
      "defaultValue": false
    },
    "saveError": {
      "type": "string",
      "defaultValue": ""
    },
    "blocked": {
      "type": "any[]",
      "defaultValue": []
    },
    "done": {
      "type": "any",
      "defaultValue": null,
      "description": "The inspection just completed: { unit, code, text, point, lineStatus, statusError, line, recorded, nextLineId, nextUnit }."
    },
    "rwShown": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: the queue shown narrowed by its column filters (applyChain); what its export writes."
    },
    "rwRows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: one oj-table row per unit in rwShown (inspectionQueue.redwoodRows)."
    },
    "rwADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "key",
        "data": "{{ $page.variables.rwRows }}"
      }
    },
    "rwCriterion": {
      "type": "any",
      "description": "Redwood view: the Smart Search criterion (text and filters); rwFilterChain turns it into text, chip, scope and rwCols."
    },
    "rwCols": {
      "type": "object",
      "defaultValue": {
        "unit": "",
        "request": "",
        "when": ""
      },
      "description": "Redwood view: the column filters only it shows (inspectionQueue.byColumns); Inspection and Which units are the page's own chip and scope."
    },
    "rwSearchConfig": {
      "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory",
      "defaultValue": {
        "url": "[[ $application.path + 'resources/data/inspectionSearchConfig.json' ]]"
      }
    },
    "rwUnits": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Redwood view: each filter's options with their counts (applyChain, inspectionQueue.columnOptions)."
    },
    "rwUnitsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwUnits }}"
      }
    },
    "rwRequests": {
      "type": "any[]",
      "defaultValue": []
    },
    "rwRequestsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwRequests }}"
      }
    },
    "rwChips": {
      "type": "any[]",
      "defaultValue": []
    },
    "rwChipsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwChips }}"
      }
    },
    "rwWhen": {
      "type": "any[]",
      "defaultValue": []
    },
    "rwWhenADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwWhen }}"
      }
    },
    "rwScopes": {
      "type": "any[]",
      "defaultValue": []
    },
    "rwScopesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.rwScopes }}"
      }
    },
    "rwSearchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
            "EquipmentFilter": {
              "label": "Equipment",
              "options": {
                "optionsData": "[[ $page.variables.rwUnitsADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "RequestFilter": {
              "label": "Request",
              "options": {
                "optionsData": "[[ $page.variables.rwRequestsADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "PointFilter": {
              "label": "Inspection",
              "options": {
                "optionsData": "[[ $page.variables.rwChipsADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "WhenFilter": {
              "label": "When",
              "options": {
                "optionsData": "[[ $page.variables.rwWhenADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "ScopeFilter": {
              "label": "Which units",
              "options": {
                "optionsData": "[[ $page.variables.rwScopesADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            }
          }
        }
      }
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "loadQueueChain"
        }
      ]
    },
    "onRefresh": {
      "chains": [
        {
          "chain": "loadQueueChain"
        }
      ]
    },
    "onSearch": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "text",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onPick": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onExportMenu": {
      "chains": [
        {
          "chain": "setChain",
          "parameters": {
            "field": "exportOpen",
            "value": "toggle"
          }
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": {
            "format": "{{ $event.currentTarget.dataset.format }}"
          }
        }
      ]
    },
    "onOpenLine": {
      "chains": [
        {
          "chain": "openLineChain",
          "parameters": {
            "lineId": "{{ $event.currentTarget.dataset.line }}"
          }
        }
      ]
    },
    "onCloseLine": {
      "chains": [
        {
          "chain": "openLineChain",
          "parameters": {
            "lineId": ""
          }
        }
      ]
    },
    "onAnswer": {
      "chains": [
        {
          "chain": "answerChain",
          "parameters": {
            "id": "{{ $event.currentTarget.dataset.item }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onAnswerTyped": {
      "chains": [
        {
          "chain": "answerChain",
          "parameters": {
            "id": "{{ $event.target.dataset.item }}",
            "value": "{{ $event.target.value }}",
            "typed": true
          }
        }
      ]
    },
    "onAnswerNote": {
      "chains": [
        {
          "chain": "answerChain",
          "parameters": {
            "id": "{{ $event.target.dataset.item }}",
            "note": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onAddDefect": {
      "chains": [
        {
          "chain": "defectChain",
          "parameters": {
            "action": "add",
            "item": "{{ $event.currentTarget.dataset.item }}"
          }
        }
      ]
    },
    "onRemoveDefect": {
      "chains": [
        {
          "chain": "defectChain",
          "parameters": {
            "action": "remove",
            "key": "{{ $event.currentTarget.dataset.key }}"
          }
        }
      ]
    },
    "onDefectField": {
      "chains": [
        {
          "chain": "defectChain",
          "parameters": {
            "action": "set",
            "key": "{{ $event.target.dataset.key }}",
            "field": "{{ $event.target.dataset.field }}",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onDefectChoice": {
      "chains": [
        {
          "chain": "defectChain",
          "parameters": {
            "action": "set",
            "key": "{{ $event.currentTarget.dataset.key }}",
            "field": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.dataset.value }}"
          }
        }
      ]
    },
    "onDefectPhoto": {
      "chains": [
        {
          "chain": "photoChain",
          "parameters": {
            "key": "{{ $event.target.dataset.key }}",
            "file": "[[ $event.target.files && $event.target.files.length ? $event.target.files[0] : null ]]"
          }
        }
      ]
    },
    "onNotes": {
      "chains": [
        {
          "chain": "setFieldChain",
          "parameters": {
            "field": "notes",
            "value": "{{ $event.target.value }}"
          }
        }
      ]
    },
    "onAck": {
      "chains": [
        {
          "chain": "setFieldChain",
          "parameters": {
            "field": "ack",
            "value": "{{ $event.target.checked }}"
          }
        }
      ]
    },
    "onComplete": {
      "chains": [
        {
          "chain": "completeInspectionChain"
        }
      ]
    },
    "onRetryStatus": {
      "chains": [
        {
          "chain": "retryStatusChain"
        }
      ]
    },
    "onOpenRequest": {
      "chains": [
        {
          "chain": "openRecordChain",
          "parameters": {
            "id": "{{ $event.currentTarget.dataset.id }}",
            "number": "{{ $event.currentTarget.dataset.number }}"
          }
        }
      ]
    },
    "onOpenScreen": {
      "chains": [
        {
          "chain": "openScreenChain",
          "parameters": {
            "navId": "{{ $event.currentTarget.dataset.nav }}"
          }
        }
      ]
    },
    "onRwFilter": {
      "chains": [
        {
          "chain": "rwFilterChain"
        }
      ]
    },
    "onRwRow": {
      "chains": [
        {
          "chain": "openLineChain",
          "parameters": {
            "lineId": "{{ $event.detail.context.key }}"
          }
        }
      ]
    },
    "onRwInspect": {
      "chains": [
        {
          "chain": "openLineChain",
          "parameters": {
            "lineId": "{{ $event.currentTarget.dataset.line }}"
          }
        }
      ]
    },
    "onRwExport": {
      "chains": [
        {
          "chain": "exportChain",
          "parameters": {
            "format": "xlsx"
          }
        }
      ]
    },
    "onRwBack": {
      "chains": [
        {
          "chain": "rwBackChain"
        }
      ]
    },
    "onRwNext": {
      "chains": [
        {
          "chain": "openLineChain",
          "parameters": {
            "lineId": "{{ $variables.done && $variables.done.nextLineId ? '' + $variables.done.nextLineId : '' }}"
          }
        }
      ]
    },
    "onRwAction": {
      "chains": [
        {
          "chain": "rwActionChain",
          "parameters": {
            "item": "{{ $event.detail ? $event.detail.secondaryItem : '' }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      },
      "oj-sp-smart-search-page": {
        "path": "oj-sp/smart-search-page/loader"
      },
      "oj-sp-smart-search": {
        "path": "oj-sp/smart-search/loader"
      },
      "oj-sp-collection-container": {
        "path": "oj-sp/collection-container/loader"
      },
      "oj-sp-general-overview-page": {
        "path": "oj-sp/general-overview-page/loader"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      },
      "oj-c-button": {
        "path": "oj-c/button"
      }
    }
  }
}
