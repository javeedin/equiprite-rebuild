{
  "description": "One rental agreement in its own tab (record kind 'agreement', keyed by its number; 'new' for a new one): what it is and what is next, its lines and their rates, Approve / Reject, Create request from the ticked lines (the draftStorage hand-off to New request), and Edit in place (header and lines; Save as New EquipRite's saveAgreementChain). Calls: New EquipRite's agreement-lines and agreement-edit chains, call for call.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "id": { "type": "string", "defaultValue": "", "input": "fromCaller", "description": "'new' for a new agreement." },
    "number": { "type": "string", "defaultValue": "", "input": "fromCaller", "description": "The agreement number (the tab's key)." },
    "mode": { "type": "string", "defaultValue": "view", "description": "view | edit" },
    "canWrite": { "type": "boolean", "defaultValue": false, "description": "FULL access to EQR_RENTAL_AGREEMENTS." },
    "unavailable": { "type": "string", "defaultValue": "" },
    "isLoading": { "type": "boolean", "defaultValue": true },
    "loadError": { "type": "string", "defaultValue": "" },
    "busy": { "type": "boolean", "defaultValue": false },
    "note": { "type": "string", "defaultValue": "", "description": "What the last action did, in words, kept on the page." },
    "noteTone": { "type": "string", "defaultValue": "info" },
    "agreementNumber": { "type": "string", "defaultValue": "" },
    "agreementName": { "type": "string", "defaultValue": "" },
    "agreementType": { "type": "string", "defaultValue": "" },
    "agreementHeaderId": { "type": "number", "defaultValue": null },
    "agreementStatus": { "type": "string", "defaultValue": "" },
    "currencyCode": { "type": "string", "defaultValue": "" },
    "customerName": { "type": "string", "defaultValue": "" },
    "customerRefId": { "type": "number", "defaultValue": null },
    "fusionCustomerId": { "type": "number", "defaultValue": null },
    "effectiveFrom": { "type": "string", "defaultValue": "" },
    "effectiveTo": { "type": "string", "defaultValue": "" },
    "agreementNotes": { "type": "string", "defaultValue": "" },
    "banner": { "type": "any", "defaultValue": {}, "description": "New's lines page formData: project or customer, task, dates, location." },
    "totalEstCost": { "type": "number", "defaultValue": 0 },
    "linesArray": { "type": "any[]", "defaultValue": [] },
    "idMap": { "type": "any", "defaultValue": {}, "description": "New's agreementLineIdByCompositeKey." },
    "selected": { "type": "any", "defaultValue": {} },
    "searchText": { "type": "string", "defaultValue": "" },
    "showLimit": { "type": "number", "defaultValue": 200 },
    "ask": { "type": "any", "defaultValue": null },
    "exportOpen": { "type": "boolean", "defaultValue": false },

    "editLoading": { "type": "boolean", "defaultValue": false },
    "editError": { "type": "string", "defaultValue": "" },
    "saving": { "type": "boolean", "defaultValue": false },
    "dirty": { "type": "boolean", "defaultValue": false },
    "missing": { "type": "any[]", "defaultValue": [] },
    "form": {
      "type": "any",
      "defaultValue": {
        "agreementName": "", "agreementType": "", "notes": "", "customerRefId": null, "customerId": null, "customerName": "",
        "startDate": "", "endDate": "", "currencyCode": "USD"
      },
      "description": "New's agreement-edit formData."
    },
    "loadedHeader": { "type": "any", "defaultValue": null },
    "typeOptions": { "type": "any[]", "defaultValue": [] },
    "customerQuery": { "type": "string", "defaultValue": "" },
    "customerResults": { "type": "any[]", "defaultValue": [] },
    "equipmentLines": { "type": "any[]", "defaultValue": [] },
    "deletedLineIds": { "type": "any[]", "defaultValue": [] },
    "addLineOpen": { "type": "boolean", "defaultValue": false },
    "lineError": { "type": "string", "defaultValue": "" },
    "currentLine": {
      "type": "any",
      "defaultValue": { "classId": null, "className": "", "subclassId": null, "subclassName": "", "equipmentMasterId": null, "equipmentName": "", "description": "", "unitPrice": null, "priceUom": "DAY" }
    },
    "equipmentClassesArray": { "type": "any[]", "defaultValue": [] },
    "equipmentSubclassesArray": { "type": "any[]", "defaultValue": [] },
    "equipmentNamesArray": { "type": "any[]", "defaultValue": [] }
  },
  "eventListeners": {
    "vbEnter": { "chains": [{ "chain": "loadChain" }] },
    "onRefresh": { "chains": [{ "chain": "uiChain", "parameters": { "action": "refresh" } }] },
    "onSearch": { "chains": [{ "chain": "uiChain", "parameters": { "action": "search", "value": "{{ $event.target.value }}" } }] },
    "onTick": {
      "chains": [{ "chain": "uiChain", "parameters": { "action": "tick", "value": "{{ $event.target.dataset.key }}", "checked": "{{ $event.target.checked }}" } }]
    },
    "onUi": {
      "chains": [{ "chain": "uiChain", "parameters": { "action": "{{ $event.currentTarget.dataset.action }}", "value": "{{ $event.currentTarget.dataset.value }}" } }]
    },
    "onExport": { "chains": [{ "chain": "exportChain", "parameters": { "format": "{{ $event.currentTarget.dataset.format }}" } }] },
    "onApprove": { "chains": [{ "chain": "approveChain" }] },
    "onReject": { "chains": [{ "chain": "rejectChain", "parameters": {} }] },
    "onCreateRequest": { "chains": [{ "chain": "createRequestChain" }] },
    "onField": {
      "chains": [{
        "chain": "fieldChain",
        "parameters": { "action": "{{ $event.target.dataset.action }}", "field": "{{ $event.target.dataset.field }}", "value": "{{ $event.target.value }}", "index": "{{ $event.target.dataset.index }}" }
      }]
    },
    "onFieldButton": {
      "chains": [{
        "chain": "fieldChain",
        "parameters": { "action": "{{ $event.currentTarget.dataset.action }}", "field": "{{ $event.currentTarget.dataset.field }}", "value": "{{ $event.currentTarget.dataset.value }}", "index": "{{ $event.currentTarget.dataset.index }}" }
      }]
    },
    "onLine": {
      "chains": [{
        "chain": "lineDraftChain",
        "parameters": { "action": "{{ $event.currentTarget.dataset.action }}", "value": "{{ $event.currentTarget.dataset.value }}", "key": "{{ $event.currentTarget.dataset.key }}" }
      }]
    },
    "onLineInput": {
      "chains": [{
        "chain": "lineDraftChain",
        "parameters": { "action": "{{ $event.target.dataset.action }}", "value": "{{ $event.target.value }}" }
      }]
    },
    "onSave": { "chains": [{ "chain": "saveChain" }] }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" }
    }
  }
}
