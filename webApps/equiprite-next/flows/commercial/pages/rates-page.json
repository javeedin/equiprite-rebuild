{
  "description": "Rates: every rate schedule (who uses it: customer, project, task, yard; when; whether the rate engine can use it) on the left, the open one on the right as one grid of the six rate periods per class (each tier's Threshold, Period total and Rate / day, as Old's rate grid) and Try a rate. Calls and rules are New EquipRite's rates page (FDD 7.3): GET /rate-schedules, /bu-org-mappings, /rate-schedules/{id}, /rate-period-lines; Save writes the header and then every line (saveScheduleChain); a saved line is deleted at once; Delete schedule. Export on both lists. Redwood (your menu, Look), as Old's Rate Management: Oracle's Smart Search page of the schedules (a filter per column), and the one opened under Oracle's general overview header over the same detail body (rwView, rwChain).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "hidden": { "type": "string", "defaultValue": "", "description": "Why rates are withdrawn (every business unit takes Fusion PPM rates), or ''." },
    "canWrite": { "type": "boolean", "defaultValue": false, "description": "FULL access to EQR_RATE_SCHEDULE." },
    "isLoading": { "type": "boolean", "defaultValue": true },
    "listError": { "type": "string", "defaultValue": "" },
    "schedules": { "type": "any[]", "defaultValue": [], "description": "New's loadSchedulesChain rows (rateRules.scheduleRow)." },
    "listText": { "type": "string", "defaultValue": "" },
    "listChip": { "type": "string", "defaultValue": "all" },
    "shown": { "type": "any[]", "defaultValue": [], "description": "The schedules the search and chip show." },
    "chips": { "type": "any[]", "defaultValue": [] },
    "summary": { "type": "string", "defaultValue": "" },
    "selectedId": { "type": "string", "defaultValue": "", "description": "Schedule id, or 'new'." },
    "detailLoading": { "type": "boolean", "defaultValue": false },
    "detailError": { "type": "string", "defaultValue": "" },
    "formData": { "type": "any", "defaultValue": {}, "description": "The old editor's formData." },
    "lines": { "type": "any[]", "defaultValue": [], "description": "The old editor's equipmentLines.",
      "onValueChanged": { "chains": [{ "chain": "rwRateOptsChain" }] } },
    "dirty": { "type": "boolean", "defaultValue": false },
    "saving": { "type": "boolean", "defaultValue": false },
    "saveNote": { "type": "string", "defaultValue": "", "description": "What the last Save or delete did, in words, kept on the page." },
    "saveTone": { "type": "string", "defaultValue": "info" },
    "lineError": { "type": "string", "defaultValue": "" },
    "headerOpen": { "type": "boolean", "defaultValue": false },
    "yardOptions": { "type": "any[]", "defaultValue": [] },
    "customerQuery": { "type": "string", "defaultValue": "" },
    "customerResults": { "type": "any[]", "defaultValue": [] },
    "projectQuery": { "type": "string", "defaultValue": "" },
    "projectResults": { "type": "any[]", "defaultValue": [] },
    "taskOptions": { "type": "any[]", "defaultValue": [] },
    "taskQuery": { "type": "string", "defaultValue": "" },
    "addRowOpen": { "type": "boolean", "defaultValue": false },
    "addRow": { "type": "any", "defaultValue": {} },
    "addClasses": { "type": "any[]", "defaultValue": [] },
    "addSubclasses": { "type": "any[]", "defaultValue": [] },
    "addEquipment": { "type": "any[]", "defaultValue": [] },
    "sim": { "type": "any", "defaultValue": { "hours": 80, "daysWorked": 10, "daysOnRent": 14, "qty": 1 } },
    "simGroup": { "type": "string", "defaultValue": "", "description": "The row Try a rate prices ('' for every Usage row)." },
    "ask": { "type": "any", "defaultValue": null },
    "exportOpen": { "type": "string", "defaultValue": "", "description": "'list' or 'lines': which export menu is open." },

    "rwRateCriterion": { "type": "any", "description": "Redwood view, a schedule's record: Smart Search's criterion over its rates (rwRateFilterChain)." },
    "rwRateCols": { "type": "object", "defaultValue": { "text": "", "equipment": "", "cls": "", "location": "", "period": "", "subclass": "", "rateType": "", "method": "" }, "description": "Redwood view: what the rates table is narrowed to (commercialRedwood.rateLineKeys)." },
    "rwRateSearchConfig": { "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory", "defaultValue": { "url": "[[ $application.path + 'resources/data/rateLinesSearchConfig.json' ]]" } },
    "rwRtEquipment": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Equipment filter's options over the schedule's rates, with counts (rwRateOptsChain)." },
    "rwRtEquipmentADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwRtEquipment }}" } },
    "rwRtClasses": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Class filter's options over the schedule's rates, with counts (rwRateOptsChain)." },
    "rwRtClassesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwRtClasses }}" } },
    "rwRtLocations": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Location filter's options over the schedule's rates, with counts (rwRateOptsChain)." },
    "rwRtLocationsADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwRtLocations }}" } },
    "rwRtPeriods": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Tier filter's options over the schedule's rates, with counts (rwRateOptsChain)." },
    "rwRtPeriodsADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwRtPeriods }}" } },
    "rwRtSubclasses": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Subclass filter's options over the schedule's rates, with counts (rwRateOptsChain)." },
    "rwRtSubclassesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwRtSubclasses }}" } },
    "rwRtTypes": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Rate type filter's options over the schedule's rates, with counts (rwRateOptsChain)." },
    "rwRtTypesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwRtTypes }}" } },
    "rwRtMethods": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Calc method filter's options over the schedule's rates, with counts (rwRateOptsChain)." },
    "rwRtMethodsADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwRtMethods }}" } },
    "rwRateSearchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
          "RateEquipmentFilter": { "label": "Equipment", "options": { "optionsData": "[[ $page.variables.rwRtEquipmentADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
          "RateClassFilter": { "label": "Class", "options": { "optionsData": "[[ $page.variables.rwRtClassesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
          "RateLocationFilter": { "label": "Location", "options": { "optionsData": "[[ $page.variables.rwRtLocationsADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
          "RatePeriodFilter": { "label": "Tier", "options": { "optionsData": "[[ $page.variables.rwRtPeriodsADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
          "RateSubclassFilter": { "label": "Subclass", "options": { "optionsData": "[[ $page.variables.rwRtSubclassesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
          "RateTypeFilter": { "label": "Rate type", "options": { "optionsData": "[[ $page.variables.rwRtTypesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
          "RateMethodFilter": { "label": "Calc method", "options": { "optionsData": "[[ $page.variables.rwRtMethodsADP ]]", "optionsKeys": { "label": "label", "value": "value" } } }
          }
        }
      }
    },
    "rwEditKey": { "type": "string", "defaultValue": "", "description": "Redwood view: the equipment row (rateRules.groupKey) open in Oracle's drawer to change its rates; '' when closed (rwRatesChain)." },
    "rwView": { "type": "string", "defaultValue": "list", "description": "Redwood view (your menu, Look): 'list', Oracle's Smart Search page of the schedules, or 'record', the open schedule (selectedId, as on Current) under Oracle's general overview header (rwChain)." },
    "rwRows": { "type": "any[]", "defaultValue": [], "description": "Redwood view: one row per schedule shown, for the oj-table (applyChain, commercialRedwood.rateRows)." },
    "rwADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "key", "data": "{{ $page.variables.rwRows }}" } },
    "rwCriterion": { "type": "any", "description": "Redwood view: the Smart Search criterion; rwFilterChain turns it into the list's search and chip, and the column filters." },
    "rwCols": { "type": "object", "defaultValue": { "name": "", "usedBy": "", "dates": "", "currency": "" }, "description": "Redwood view: the column filters picked in Smart Search, which only the Redwood table applies (commercialRedwood.rateByColumns); Status is the list's chip." },
    "rwSearchConfig": { "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory", "defaultValue": { "url": "[[ $application.path + 'resources/data/ratesSearchConfig.json' ]]" } },
    "rwNames": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Schedule filter's options with their counts (applyChain, commercialRedwood.rateOptions); and likewise below." },
    "rwNamesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwNames }}" } },
    "rwUsedBy": { "type": "any[]", "defaultValue": [] },
    "rwUsedByADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwUsedBy }}" } },
    "rwDates": { "type": "any[]", "defaultValue": [] },
    "rwDatesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwDates }}" } },
    "rwCurrencies": { "type": "any[]", "defaultValue": [] },
    "rwCurrenciesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwCurrencies }}" } },
    "rwStatuses": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the Status filter's options, the list's chips that are a status, with their counts." },
    "rwStatusesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwStatuses }}" } },
    "rwSearchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
          "ScheduleFilter": { "label": "Schedule", "options": { "optionsData": "[[ $page.variables.rwNamesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
          "UsedByFilter": { "label": "Used by", "options": { "optionsData": "[[ $page.variables.rwUsedByADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
          "EffectiveFilter": { "label": "Effective", "options": { "optionsData": "[[ $page.variables.rwDatesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
          "CurrencyFilter": { "label": "Currency", "options": { "optionsData": "[[ $page.variables.rwCurrenciesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
          "StatusFilter": { "label": "Status", "options": { "optionsData": "[[ $page.variables.rwStatusesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } }
          }
        }
      }
    }
  },
  "eventListeners": {
    "vbEnter": { "chains": [{ "chain": "initChain" }] },
    "onRefresh": { "chains": [{ "chain": "refreshChain" }] },
    "onListSearch": { "chains": [{ "chain": "listChain", "parameters": { "action": "search", "value": "{{ $event.target.value }}" } }] },
    "onListChip": { "chains": [{ "chain": "listChain", "parameters": { "action": "chip", "value": "{{ $event.currentTarget.dataset.value }}" } }] },
    "onSimInput": { "chains": [{ "chain": "listChain", "parameters": { "action": "{{ $event.target.dataset.field }}", "value": "{{ $event.target.value }}" } }] },
    "onSimGroup": { "chains": [{ "chain": "listChain", "parameters": { "action": "simGroup", "value": "{{ $event.currentTarget.dataset.value }}" } }] },
    "onExportMenu": { "chains": [{ "chain": "listChain", "parameters": { "action": "exportMenu", "value": "{{ $event.currentTarget.dataset.value }}" } }] },
    "onExport": {
      "chains": [{ "chain": "exportChain", "parameters": { "what": "{{ $event.currentTarget.dataset.what }}", "format": "{{ $event.currentTarget.dataset.format }}" } }]
    },
    "onSelect": { "chains": [{ "chain": "selectScheduleChain", "parameters": { "id": "{{ $event.currentTarget.dataset.id }}" } }] },
    "onNew": { "chains": [{ "chain": "selectScheduleChain", "parameters": { "id": "new" } }] },
    "onHeader": {
      "chains": [{
        "chain": "headerChain",
        "parameters": {
          "action": "{{ $event.currentTarget.dataset.action }}",
          "field": "{{ $event.currentTarget.dataset.field }}",
          "value": "{{ $event.currentTarget.dataset.value }}",
          "index": "{{ $event.currentTarget.dataset.index }}"
        }
      }]
    },
    "onHeaderInput": {
      "chains": [{
        "chain": "headerChain",
        "parameters": {
          "action": "{{ $event.target.dataset.action }}",
          "field": "{{ $event.target.dataset.field }}",
          "value": "{{ $event.target.type === 'checkbox' ? $event.target.checked : $event.target.value }}"
        }
      }]
    },
    "onLineEdit": {
      "chains": [{
        "chain": "lineEditChain",
        "parameters": { "key": "{{ $event.target.dataset.key }}", "field": "{{ $event.target.dataset.field }}", "value": "{{ $event.target.value }}" }
      }]
    },
    "onAddLine": {
      "chains": [{
        "chain": "addLineChain",
        "parameters": { "groupKey": "{{ $event.currentTarget.dataset.group }}", "period": "{{ $event.currentTarget.dataset.period }}" }
      }]
    },
    "onRemoveLine": {
      "chains": [{ "chain": "removeLineChain", "parameters": { "key": "{{ $event.currentTarget.dataset.key }}" } }]
    },
    "onAddRow": {
      "chains": [{
        "chain": "addRowChain",
        "parameters": { "action": "{{ $event.currentTarget.dataset.action }}", "value": "{{ $event.currentTarget.dataset.value }}" }
      }]
    },
    "onAddRowInput": {
      "chains": [{
        "chain": "addRowChain",
        "parameters": { "action": "{{ $event.target.dataset.action }}", "value": "{{ $event.target.value }}" }
      }]
    },
    "onSave": { "chains": [{ "chain": "saveScheduleChain" }] },
    "onDiscard": { "chains": [{ "chain": "discardChain" }] },
    "onDelete": { "chains": [{ "chain": "deleteScheduleChain", "parameters": {} }] },
    "onAnswer": {
      "chains": [{ "chain": "answerChain", "parameters": { "answer": "{{ $event.currentTarget.dataset.answer }}" } }]
    },
    "onRwFilter": { "chains": [{ "chain": "rwFilterChain" }] },
    "onRwRow": { "chains": [{ "chain": "rwChain", "parameters": { "action": "open", "value": "{{ $event.detail.context.key }}" } }] },
    "onRwNew": { "chains": [{ "chain": "rwChain", "parameters": { "action": "new" } }] },
    "onCompare": { "chains": [{ "chain": "compareChain" }], "description": "Compare schedules: Compare rates, with the open schedule as the base." },
    "onRwBack": { "chains": [{ "chain": "rwChain", "parameters": { "action": "back" } }] },
    "onRwAction": { "chains": [{ "chain": "rwChain", "parameters": { "action": "act", "value": "{{ $event.detail.secondaryItem }}" } }] },
    "onRwExport": { "chains": [{ "chain": "exportChain", "parameters": { "what": "list", "format": "xlsx" } }] },
    "onRwRates": { "chains": [{ "chain": "rwRatesChain", "parameters": { "act": "{{ $event.currentTarget.dataset.act }}", "key": "{{ $event.currentTarget.dataset.key }}" } }] },
    "onRwDrawer": { "chains": [{ "chain": "rwRatesChain", "parameters": { "act": "{{ $event.detail.value ? '' : 'close' }}" } }] },
    "onRwRateFilter": { "chains": [{ "chain": "rwRateFilterChain" }] },
    "onRwDrawerKey": { "chains": [{ "chain": "rwRatesChain", "parameters": { "act": "{{ $event.key === 'Escape' ? 'close' : '' }}" } }] },
    "onRwEditClose": { "chains": [{ "chain": "rwRatesChain", "parameters": { "act": "close" } }] },
    "onRwAddLine": { "chains": [{ "chain": "addLineChain", "parameters": { "groupKey": "{{ $event.currentTarget.dataset.group }}", "period": "{{ $event.currentTarget.dataset.period }}" } }] },
    "onRwRemoveLine": { "chains": [{ "chain": "removeLineChain", "parameters": { "key": "{{ $event.currentTarget.dataset.key }}" } }] }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" },
      "oj-sp-smart-search-page": { "path": "oj-sp/smart-search-page/loader" },
      "oj-sp-smart-search": { "path": "oj-sp/smart-search/loader" },
      "oj-sp-collection-container": { "path": "oj-sp/collection-container/loader" },
      "oj-sp-general-overview-page": { "path": "oj-sp/general-overview-page/loader" },
      "oj-table": { "path": "ojs/ojtable" },
      "oj-c-button": { "path": "oj-c/button" },
      "oj-sp-messages-banner": { "path": "oj-sp/messages-banner/loader" },
      "oj-drawer-popup": { "path": "ojs/ojdrawerpopup" },
      "oj-sp-general-drawer-template": { "path": "oj-sp/general-drawer-template/loader" }
    }
  }
}
