{
  "description": "Receiving & returns: what is coming back to the yard, one row per request, in sections by the yard's job (overdue first, to receive, return requested, on the way back, due back this week, later), with the yard it goes back to, filtered by stage tiles, yard and search; export. A request opens beside the list: Receive at yard is New's AcceptReturnLinesChain (EquipRite only). A unit back without notice is found by scanning or typing its serial (New's Direct Return search); a fixed-asset return is recorded here (EquipRite only), a stock return needs a return transfer order in Fusion and is left to New EquipRite. Under Redwood (your menu, Look) the list is Oracle's Smart Search page over an oj-table, a filter per column, the step tiles as its Step filter; a row opens the same panel, drawn as a drawer at the window's edge.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "records": { "type": "any[]", "defaultValue": [], "description": "The returns queue (yardWork.queueRows of views/workbench-requests?stage=RETURN)." },
    "linesBy": { "type": "any", "defaultValue": {} },
    "yards": { "type": "any", "defaultValue": {} },
    "loadToken": { "type": "number", "defaultValue": 0 },
    "yardsLoading": { "type": "boolean", "defaultValue": false },
    "isLoading": { "type": "boolean", "defaultValue": true },
    "error": { "type": "string", "defaultValue": "" },
    "linesFailed": { "type": "number", "defaultValue": 0 },
    "stage": { "type": "string", "defaultValue": "all" },
    "yard": { "type": "string", "defaultValue": "all" },
    "text": { "type": "string", "defaultValue": "" },
    "collapsed": { "type": "any", "defaultValue": { "later": true, "done": true } },
    "items": { "type": "any[]", "defaultValue": [] },
    "shown": { "type": "any[]", "defaultValue": [] },
    "sections": { "type": "any[]", "defaultValue": [] },
    "tiles": { "type": "any[]", "defaultValue": [] },
    "yardChips": { "type": "any[]", "defaultValue": [] },
    "summary": { "type": "string", "defaultValue": "" },
    "exportOpen": { "type": "string", "defaultValue": "", "description": "'' | 'list' | 'lines' | 'found'" },
    "side": { "type": "string", "defaultValue": "", "description": "What is beside the list: '' | 'request' | 'find'." },
    "openId": { "type": "string", "defaultValue": "" },
    "work": {
      "type": "any",
      "defaultValue": { "req": {}, "lines": [], "tos": [] },
      "description": "The open request, built with New's receipt openPickingDrawerChain calls: every line, its transfer order, unit and condition."
    },
    "workLoading": { "type": "boolean", "defaultValue": false },
    "workError": { "type": "string", "defaultValue": "" },
    "ticks": { "type": "any[]", "defaultValue": [], "description": "Ticked line ids (only lines shipped back to the yard can be ticked)." },
    "returnDate": { "type": "string", "defaultValue": "", "description": "The day the ticked pieces came back; blank is today." },
    "banner": { "type": "any", "defaultValue": { "type": "", "text": "" } },
    "busy": { "type": "string", "defaultValue": "", "description": "'' | 'receive' | 'record' | 'search'" },
    "findQuery": { "type": "string", "defaultValue": "" },
    "found": { "type": "any[]", "defaultValue": [], "description": "Units still in the field matching the search (resources/js/directReturn)." },
    "foundTicks": { "type": "any[]", "defaultValue": [], "description": "Row keys ticked. Never pre-filled: a unit can be out on more than one rental." },
    "foundMeta": { "type": "any", "defaultValue": { "searched": false } },
    "findBanner": { "type": "any", "defaultValue": { "type": "", "text": "" } },
    "scan": {
      "type": "any",
      "defaultValue": { "supported": false, "open": false, "status": "", "reading": false, "torch": false, "torchOn": false }
    },
    "rwShown": { "type": "any[]", "defaultValue": [], "description": "Redwood view: the requests shown (shown, in its sections' order) narrowed by its column filters (applyChain); what its export writes." },
    "rwRows": { "type": "any[]", "defaultValue": [], "description": "Redwood view: one oj-table row per request in rwShown (yardWork.redwoodRows)." },
    "rwADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "key", "data": "{{ $page.variables.rwRows }}" } },
    "rwCriterion": { "type": "any", "description": "Redwood view: the Smart Search criterion (text and filters); rwFilterChain turns it into text, stage, yard and rwCols." },
    "rwCols": {
      "type": "object",
      "defaultValue": { "when": "", "number": "", "party": "", "next": "", "type": "" },
      "description": "Redwood view: the column filters only it shows (yardWork.byColumns); Step and Back to yard are the page's own stage and yard."
    },
    "rwSearchConfig": { "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory", "defaultValue": { "url": "[[ $application.path + 'resources/data/returnsSearchConfig.json' ]]" } },
    "rwWhen": { "type": "any[]", "defaultValue": [], "description": "Redwood view: each filter's options with their counts (applyChain, yardWork.columnOptions)." },
    "rwWhenADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwWhen }}" } },
    "rwNumbers": { "type": "any[]", "defaultValue": [] },
    "rwNumbersADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwNumbers }}" } },
    "rwParties": { "type": "any[]", "defaultValue": [] },
    "rwPartiesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwParties }}" } },
    "rwStages": { "type": "any[]", "defaultValue": [] },
    "rwStagesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwStages }}" } },
    "rwYards": { "type": "any[]", "defaultValue": [] },
    "rwYardsADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwYards }}" } },
    "rwNext": { "type": "any[]", "defaultValue": [] },
    "rwNextADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwNext }}" } },
    "rwTypes": { "type": "any[]", "defaultValue": [] },
    "rwTypesADP": { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.rwTypes }}" } },
    "rwSearchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
            "DueFilter": { "label": "Due back", "options": { "optionsData": "[[ $page.variables.rwWhenADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "RequestFilter": { "label": "Request", "options": { "optionsData": "[[ $page.variables.rwNumbersADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "PartyFilter": { "label": "Project or customer", "options": { "optionsData": "[[ $page.variables.rwPartiesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "StepFilter": { "label": "Step", "options": { "optionsData": "[[ $page.variables.rwStagesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "YardFilter": { "label": "Back to yard", "options": { "optionsData": "[[ $page.variables.rwYardsADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "NextFilter": { "label": "Next step", "options": { "optionsData": "[[ $page.variables.rwNextADP ]]", "optionsKeys": { "label": "label", "value": "value" } } },
            "TypeFilter": { "label": "Type", "options": { "optionsData": "[[ $page.variables.rwTypesADP ]]", "optionsKeys": { "label": "label", "value": "value" } } }
          }
        }
      }
    }
  },
  "eventListeners": {
    "vbEnter": { "chains": [{ "chain": "loadChain", "parameters": { "refresh": false } }] },
    "vbExit": { "chains": [{ "chain": "closeScannerChain" }] },
    "onRefresh": { "chains": [{ "chain": "loadChain", "parameters": { "refresh": true } }] },
    "onSearch": { "chains": [{ "chain": "setChain", "parameters": { "field": "text", "value": "{{ $event.target.value }}" } }] },
    "onPick": {
      "chains": [{ "chain": "setChain", "parameters": { "field": "{{ $event.currentTarget.dataset.field }}", "value": "{{ $event.currentTarget.dataset.value }}" } }]
    },
    "onExportMenu": {
      "chains": [{ "chain": "setChain", "parameters": { "field": "exportOpen", "value": "{{ $event.currentTarget.dataset.what }}" } }]
    },
    "onExport": {
      "chains": [{ "chain": "exportChain", "parameters": { "format": "{{ $event.currentTarget.dataset.format }}", "what": "{{ $event.currentTarget.dataset.what }}" } }]
    },
    "onRow": {
      "chains": [{
        "chain": "rowChain",
        "parameters": {
          "id": "{{ $event.currentTarget.dataset.id }}",
          "number": "{{ $event.currentTarget.dataset.number }}",
          "act": "{{ $event.target && $event.target.closest && $event.target.closest('[data-act]') ? $event.target.closest('[data-act]').getAttribute('data-act') : 'open' }}"
        }
      }]
    },
    "onOpenRequest": {
      "chains": [{ "chain": "openRequestChain", "parameters": { "id": "{{ $event.currentTarget.dataset.id }}", "number": "{{ $event.currentTarget.dataset.number }}" } }]
    },
    "onCloseSide": { "chains": [{ "chain": "closeWorkChain" }] },
    "onRefreshWork": { "chains": [{ "chain": "openWorkChain", "parameters": { "id": "{{ $variables.openId }}", "keepBanner": false } }] },
    "onTick": {
      "chains": [{ "chain": "tickChain", "parameters": { "lineId": "{{ $event.target.dataset.lineId }}", "checked": "{{ $event.target.checked }}" } }]
    },
    "onTickAll": { "chains": [{ "chain": "tickAllChain" }] },
    "onReturnDate": { "chains": [{ "chain": "setChain", "parameters": { "field": "returnDate", "value": "{{ $event.target.value }}" } }] },
    "onReceive": { "chains": [{ "chain": "receiveChain" }] },
    "onOpenFind": { "chains": [{ "chain": "openFindChain" }] },
    "onFindInput": { "chains": [{ "chain": "setChain", "parameters": { "field": "findQuery", "value": "{{ $event.target.value }}" } }] },
    "onFindKey": { "chains": [{ "chain": "findChain", "parameters": { "value": "{{ $event.target.value }}", "key": "{{ $event.key }}" } }] },
    "onFind": { "chains": [{ "chain": "findChain", "parameters": {} }] },
    "onTickFound": { "chains": [{ "chain": "setChain", "parameters": { "field": "foundTick", "value": "{{ $event.target.dataset.rowKey }}" } }] },
    "onRecordReturn": { "chains": [{ "chain": "recordReturnChain" }] },
    "onOpenScanner": { "chains": [{ "chain": "openScannerChain" }] },
    "onCloseScanner": { "chains": [{ "chain": "closeScannerChain" }] },
    "onTorch": { "chains": [{ "chain": "torchChain" }] },
    "onReadText": { "chains": [{ "chain": "readTextChain" }] },
    "onRwFilter": { "chains": [{ "chain": "rwFilterChain" }] },
    "onRwRow": { "chains": [{ "chain": "rowChain", "parameters": { "id": "{{ $event.detail.context.key }}", "number": "", "act": "open" } }] },
    "onRwStep": {
      "chains": [{ "chain": "rowChain", "parameters": { "id": "{{ $event.currentTarget.dataset.id }}", "number": "{{ $event.currentTarget.dataset.number }}", "act": "step" } }]
    },
    "onRwNumber": {
      "chains": [{ "chain": "rowChain", "parameters": { "id": "{{ $event.currentTarget.dataset.id }}", "number": "{{ $event.currentTarget.dataset.number }}", "act": "request" } }]
    },
    "onRwExport": { "chains": [{ "chain": "exportChain", "parameters": { "format": "xlsx", "what": "list" } }] },
    "onRwAction": { "chains": [{ "chain": "rwActionChain", "parameters": { "item": "{{ $event.detail ? $event.detail.secondaryItem : '' }}" } }] }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" },
      "oj-sp-smart-search-page": { "path": "oj-sp/smart-search-page/loader" },
      "oj-sp-smart-search": { "path": "oj-sp/smart-search/loader" },
      "oj-sp-collection-container": { "path": "oj-sp/collection-container/loader" },
      "oj-table": { "path": "ojs/ojtable" },
      "oj-c-button": { "path": "oj-c/button" }
    }
  }
}
