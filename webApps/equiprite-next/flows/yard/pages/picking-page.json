{
  "description": "Picking & shipping: what has to go out of the yard, one row per request, in sections by the day it is needed (late first), with the yard it ships from, filtered by stage tiles, yard and search; export. A request opens beside the list for the yard's work, with New EquipRite's calls: release fixed-asset lines (EquipRite only), the pick slip, Pick and ship (EquipRite only). Releasing a transfer order and moving a maintenance asset write to Fusion: shown, and left to New EquipRite. The request number opens the request in its own tab.",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "records": { "type": "any[]", "defaultValue": [], "description": "The picking queue (yardWork.queueRows of views/workbench-requests?stage=INITIATE)." },
    "linesBy": { "type": "any", "defaultValue": {}, "description": "{ requestId: views/request-detail-lines rows | null when they could not be loaded }." },
    "yards": { "type": "any", "defaultValue": {}, "description": "{ lineId: yard name | '' (none recorded) } from views/line-detail-units, filled in after the list shows." },
    "loadToken": { "type": "number", "defaultValue": 0 },
    "yardsLoading": { "type": "boolean", "defaultValue": false },
    "isLoading": { "type": "boolean", "defaultValue": true },
    "error": { "type": "string", "defaultValue": "" },
    "linesFailed": { "type": "number", "defaultValue": 0 },
    "stage": { "type": "string", "defaultValue": "all" },
    "yard": { "type": "string", "defaultValue": "all" },
    "text": { "type": "string", "defaultValue": "" },
    "collapsed": { "type": "any", "defaultValue": { "done": true } },
    "items": { "type": "any[]", "defaultValue": [] },
    "shown": { "type": "any[]", "defaultValue": [] },
    "sections": { "type": "any[]", "defaultValue": [] },
    "tiles": { "type": "any[]", "defaultValue": [] },
    "yardChips": { "type": "any[]", "defaultValue": [] },
    "summary": { "type": "string", "defaultValue": "" },
    "exportOpen": { "type": "string", "defaultValue": "", "description": "'' | 'list' | 'lines': which export menu is open." },
    "openId": { "type": "string", "defaultValue": "", "description": "The request open beside the list." },
    "work": {
      "type": "any",
      "defaultValue": { "req": {}, "lines": [], "exceptions": [], "tos": [] },
      "description": "The open request's picking workspace, built with New's openPickingDrawerChain calls: its lines in picking (SCHEDULED_FOR_PICKING, PICK_INITIATED, SHIP_TO_SITE), their transfer orders and exceptions."
    },
    "workLoading": { "type": "boolean", "defaultValue": false },
    "workError": { "type": "string", "defaultValue": "" },
    "ticks": { "type": "any[]", "defaultValue": [], "description": "Ticked line ids: they scope Release and Pick and ship, as in New." },
    "selectedTOId": { "type": "string", "defaultValue": "", "description": "The single ticked transfer order, or ''." },
    "banner": { "type": "any", "defaultValue": { "type": "", "text": "" } },
    "busy": { "type": "string", "defaultValue": "", "description": "'' | 'release' | 'ship' | 'slip': a step in flight (its buttons are disabled)." },
    "slip": { "type": "any", "defaultValue": { "url": "", "fileName": "", "docNumber": "", "rows": 0 } }
  },
  "eventListeners": {
    "vbEnter": { "chains": [{ "chain": "loadChain", "parameters": { "refresh": false } }] },
    "onRefresh": { "chains": [{ "chain": "loadChain", "parameters": { "refresh": true } }] },
    "onSearch": { "chains": [{ "chain": "setChain", "parameters": { "field": "text", "value": "{{ $event.target.value }}" } }] },
    "onPick": {
      "chains": [{ "chain": "setChain", "parameters": { "field": "{{ $event.currentTarget.dataset.field }}", "value": "{{ $event.currentTarget.dataset.value }}" } }]
    },
    "onExportMenu": {
      "chains": [{ "chain": "setChain", "parameters": { "field": "exportOpen", "value": "{{ $event.currentTarget.dataset.what }}" } }]
    },
    "onExport": {
      "chains": [{ "chain": "exportChain", "parameters": { "format": "{{ $event.currentTarget.dataset.format }}", "what": "{{ $event.currentTarget.dataset.what }}" } }]
    },
    "onRow": {
      "chains": [{
        "chain": "rowChain",
        "parameters": {
          "id": "{{ $event.currentTarget.dataset.id }}",
          "number": "{{ $event.currentTarget.dataset.number }}",
          "act": "{{ $event.target && $event.target.closest && $event.target.closest('[data-act]') ? $event.target.closest('[data-act]').getAttribute('data-act') : 'open' }}"
        }
      }]
    },
    "onOpenRequest": {
      "chains": [{ "chain": "openRequestChain", "parameters": { "id": "{{ $event.currentTarget.dataset.id }}", "number": "{{ $event.currentTarget.dataset.number }}" } }]
    },
    "onCloseWork": { "chains": [{ "chain": "closeWorkChain" }] },
    "onRefreshWork": { "chains": [{ "chain": "openWorkChain", "parameters": { "id": "{{ $variables.openId }}", "keepBanner": false } }] },
    "onTick": {
      "chains": [{ "chain": "tickChain", "parameters": { "lineId": "{{ $event.target.dataset.lineId }}", "checked": "{{ $event.target.checked }}" } }]
    },
    "onTickAll": { "chains": [{ "chain": "tickAllChain" }] },
    "onRelease": { "chains": [{ "chain": "releaseChain" }] },
    "onShip": { "chains": [{ "chain": "shipChain" }] },
    "onSlip": { "chains": [{ "chain": "pickSlipChain", "parameters": { "action": "{{ $event.currentTarget.dataset.action }}" } }] }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" },
      "oj-bind-text": { "path": "ojs/ojknockout" }
    }
  }
}
