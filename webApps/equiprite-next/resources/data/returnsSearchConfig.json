{
  "description": "Receiving & returns (Redwood view): the Smart Search filters, one per column as the table shows them (Due back, Request, Project or customer, Step, Back to yard, Next step), then Type. Step and Back to yard are the page's own stage and yard (the step tiles and yard chips of the current look). Every filter here needs its entry in returns-page.json's rwSearchContext (the widget evaluates every filter in this file, and one without context throws and blanks the table).",
  "filters": {
    "DueFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Due back",
      "options": {
        "field": "when",
        "optionsData": "[[ $search.filters.DueFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.DueFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "RequestFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Request",
      "options": {
        "field": "number",
        "optionsData": "[[ $search.filters.RequestFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.RequestFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "PartyFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Project or customer",
      "options": {
        "field": "party",
        "optionsData": "[[ $search.filters.PartyFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.PartyFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "StepFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Step",
      "options": {
        "field": "stage",
        "optionsData": "[[ $search.filters.StepFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.StepFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "YardFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Back to yard",
      "options": {
        "field": "yard",
        "optionsData": "[[ $search.filters.YardFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.YardFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "NextFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Next step",
      "options": {
        "field": "next",
        "optionsData": "[[ $search.filters.NextFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.NextFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "TypeFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Type",
      "options": {
        "field": "type",
        "optionsData": "[[ $search.filters.TypeFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.TypeFilter.options.optionsKeys ]]"
      },
      "data": {}
    }
  }
}
