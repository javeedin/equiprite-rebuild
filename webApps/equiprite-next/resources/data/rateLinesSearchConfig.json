{
  "description": "Rates (Redwood view), a schedule's record: Smart Search over its rates table, in Oracle's header (as Old's Equipment Schedule page puts Smart Search in its general overview header). A filter per column of Old's rate grid (Class, Subclass, Equipment, Rate type, Tier, Calc method) and the location. Every filter here needs its entry in rates-page.json's rwRateSearchContext.",
  "filters": {
    "RateClassFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Class",
      "options": {
        "field": "cls",
        "optionsData": "[[ $search.filters.RateClassFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.RateClassFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "RateSubclassFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Subclass",
      "options": {
        "field": "subclass",
        "optionsData": "[[ $search.filters.RateSubclassFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.RateSubclassFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "RateEquipmentFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Equipment",
      "options": {
        "field": "equipment",
        "optionsData": "[[ $search.filters.RateEquipmentFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.RateEquipmentFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "RateTypeFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Rate type",
      "options": {
        "field": "rateType",
        "optionsData": "[[ $search.filters.RateTypeFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.RateTypeFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "RatePeriodFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Tier",
      "options": {
        "field": "period",
        "optionsData": "[[ $search.filters.RatePeriodFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.RatePeriodFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "RateMethodFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Calc method",
      "options": {
        "field": "method",
        "optionsData": "[[ $search.filters.RateMethodFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.RateMethodFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "RateLocationFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Location",
      "options": {
        "field": "location",
        "optionsData": "[[ $search.filters.RateLocationFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.RateLocationFilter.options.optionsKeys ]]"
      },
      "data": {}
    }
  }
}
