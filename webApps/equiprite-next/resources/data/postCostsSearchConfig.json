{
  "description": "Post costs (Redwood view): the Smart Search filters, one per column as the table shows them (Request, Project, Rental, Status, Cost to date, Ready to post, Posted), then Task. Status is the page's own chip; the others narrow the Redwood table only. Every filter here needs its entry in costs-page.json's rwSearchContext (the widget evaluates every filter in this file, and one without context throws and blanks the table).",
  "filters": {
    "RequestFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Request",
      "options": {
        "field": "number",
        "optionsData": "[[ $search.filters.RequestFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.RequestFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "ProjectFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Project",
      "options": {
        "field": "project",
        "optionsData": "[[ $search.filters.ProjectFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.ProjectFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "RentalFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Rental",
      "options": {
        "field": "rental",
        "optionsData": "[[ $search.filters.RentalFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.RentalFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "StatusFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Status",
      "options": {
        "field": "status",
        "optionsData": "[[ $search.filters.StatusFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.StatusFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "CostFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Cost to date",
      "options": {
        "field": "cost",
        "optionsData": "[[ $search.filters.CostFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.CostFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "ReadyFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Ready to post",
      "options": {
        "field": "ready",
        "optionsData": "[[ $search.filters.ReadyFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.ReadyFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "PostedFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Posted",
      "options": {
        "field": "posted",
        "optionsData": "[[ $search.filters.PostedFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.PostedFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "TaskFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Task",
      "options": {
        "field": "task",
        "optionsData": "[[ $search.filters.TaskFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.TaskFilter.options.optionsKeys ]]"
      },
      "data": {}
    }
  }
}
