{

  "metadata": {},
  "variables": {
    "WorkbenchAllArray": {
      "type": "any[]",
      "defaultValue": []
    },
    "WorkbenchFilteredArray": {
      "type": "any[]",
      "defaultValue": []
    },
    "WorkbenchADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "request_id",
        "data": "{{ $page.variables.WorkbenchFilteredArray }}"
      }
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": false
    },
    "filterCriterion": {
      "type": "any"
    },
    "searchConfiguration": {
      "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory",
      "defaultValue": {
        "url": "[[ $application.path + 'resources/data/workbenchSearchConfig.json' ]]"
      }
    },
    "searchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
            "StatusFilter": {
              "label": "Status",
              "options": {
                "optionsData": "[[ $page.variables.statusOptionsADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "SourceFilter": {
              "label": "All Sources",
              "options": {
                "optionsData": "[[ $page.variables.sourceOptionsADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            }
          }
        }
      }
    },
    "statusOptionsArray": {
      "type": "any[]",
      "defaultValue": [
        { "label": "Submitted (Awaiting Approval)",  "value": "SUBMITTED" },
        { "label": "Quote Generated",                "value": "QUOTE_GENERATED" },
        { "label": "Quote Accepted",                 "value": "QUOTE_ACCEPTED" },
        { "label": "In Process",                     "value": "IN_PROCESS" },
        { "label": "Rejected",                       "value": "REJECTED" },
        { "label": "Deployed",                       "value": "DEPLOYED" },
        { "label": "Returned",                       "value": "RETURNED" }
      ]
    },
    "statusOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.statusOptionsArray }}"
      }
    },
    "sourceOptionsArray": {
      "type": "any[]",
      "defaultValue": [
        { "label": "All Sources", "value": "ALL" },
        { "label": "Internal",    "value": "INTERNAL" },
        { "label": "External",    "value": "EXTERNAL" }
      ]
    },
    "sourceOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.sourceOptionsArray }}"
      }
    },
    "pageSubtitle": {
      "type": "string",
      "defaultValue": "Unified fulfillment across projects & customers"
    },
    "workbenchActiveTab": {
      "type": "string",
      "defaultValue": "outbound"
    }
  },
  "eventListeners": {
    "vbBeforeEnter": {
      "chains": [
        { "chain": "enforcePageAccessChain" }
      ]
    },
    "vbEnter": {
      "chains": [{ "chain": "WorkbenchInitChain", "parameters": {} }]
    },
    "filterCriterionChanged": {
      "chains": [{ "chain": "WorkbenchFilterChain", "parameters": {} }]
    },
    "onRowAction": {
      "chains": [{ "chain": "RowClickChain", "parameters": { "rowData": "{{ $event.detail.value?.data }}" } }]
    },
    "onTabChanged": {
      "chains": [{ "chain": "WorkbenchInitChain", "parameters": {} }]
    }
  },
  "functions": {
    "formatCurrency":      { "params": { "value": "any" },        "return": "string" },
    "getAllocationPct":    { "params": { "allocated": "any", "total": "any" }, "return": "number" },
    "allocationTone":      { "params": { "pct": "any" },          "return": "string" },
    "allocationToneClass": { "params": { "pct": "any" },          "return": "string" }
  },
  "imports": {
    "components": {
      "oj-sp-smart-search-page": { "path": "oj-sp/smart-search-page/loader" },
      "oj-sp-general-overview-page": { "path": "oj-sp/general-overview-page/loader" },
      "oj-sp-smart-search": { "path": "oj-sp/smart-search/loader" },
      "oj-sp-collection-container": { "path": "oj-sp/collection-container/loader" },
      "oj-table": { "path": "ojs/ojtable" },
      "oj-tab-bar": { "path": "ojs/ojnavigationlist" },
      "oj-bind-text": { "path": "ojs/ojknockout" },
      "oj-bind-if": { "path": "ojs/ojknockout" }
    }
  }
}
