  "eventListeners": {
    "vbBeforeEnter": {
      "chains": [
        { "chain": "enforcePageAccessChain" }
      ]
    },
    "vbEnter":         { "chains": [{ "chain": "InitChain",   "parameters": {} }] },
    "onFilterChanged": { "chains": [{ "chain": "FilterChain", "parameters": {} }] },
    "onExportCsv":     { "chains": [{ "chain": "ExportChain", "parameters": {} }] },
    "onToggleRentalReqMore":  { "chains": [{ "chain": "ToggleRentalReqMoreChain",  "parameters": {} }] },
    "onClearRentalReqFilters": { "chains": [{ "chain": "ClearRentalReqFiltersChain", "parameters": {} }] },
    "onReportsSmartSearchChanged": { "chains": [{ "chain": "OnReportsSmartSearchChangedChain", "parameters": { "criterion": "{{ $event.detail.value }}" } }] },
    "onReportsTabChanged": { "chains": [{ "chain": "OnReportsTabChangedChain", "parameters": { "newTab": "{{ $event.detail.value }}" } }] }
  },

  "functions": {
    "computeKpis":                  { "params": { "historyRows": "any[]", "projCostRows": "any[]", "rateExcRows": "any[]" }, "return": "any" },
    "formatDate":                   { "params": { "val": "any" },                                                                                                                                                        "return": "string" },
    "formatCurrency":               { "params": { "val": "any" },                                                                                                                                                        "return": "string" },
    "filterHistoryData":            { "params": { "historyRows": "any[]", "filterFrom": "string", "filterTo": "string", "filterSerial": "string" },                                                                     "return": "any[]"  },
    "getSerialNumberOptions":       { "params": { "historyRows": "any[]" },                                                                                                                                              "return": "any[]"  },
    "getEquipHistoryGridProvider":  { "params": { "historyRows": "any[]" },                                                                                                                                              "return": "any"    },
    "getEquipHistoryColumnHeaderStyle": { "params": { "headerContext": "any" },                                                                                                                                          "return": "string" },
    "getRentalReqGridProvider":     { "params": { "rows": "any[]" },                                                                                                                                                     "return": "any"    },
    "getRentalReqColumnHeaderStyle": { "params": { "headerContext": "any" },                                                                                                                                             "return": "string" },
    "toLovOptions":                 { "params": { "values": "any[]" },                                                                                                                                                    "return": "any[]"  },
    "getRentalReqLineStatusValues":    { "params": {}, "return": "any[]" },
    "getRentalReqRequestStatusValues": { "params": {}, "return": "any[]" },
    "buildRentalReqUriParams":      { "params": { "filterQ": "string", "filterRequest": "string", "filterProject": "string", "filterCustomer": "string", "filterLineStatus": "any[]", "filterReqStatus": "any[]", "filterClass": "string", "filterFrom": "string", "filterTo": "string", "filterProcurement": "string" }, "return": "any" },
