    "_comment_reportsWindow":    { "type": "string", "defaultValue": "Equipment History's date window. Smart search has no date filter type, so this is a page control like the Analytics Utilization Period: reportsDatePreset sends duration, or fromDate/toDate when it is 'custom'. Default 'all' sends nothing, so the report stays unfiltered until a period is chosen. All three controls fire FilterChain via onFilterChanged." },
    "reportsDatePreset":         { "type": "string", "defaultValue": "all" },
    "reportsCustomFrom":         { "type": "string", "defaultValue": "" },
    "reportsCustomTo":           { "type": "string", "defaultValue": "" },
    "reportsDateOptionsArray": {
      "type": "any[]",
      "defaultValue": [
        { "label": "All Time",      "value": "all"           },
        { "label": "Last 10 Days",  "value": "LAST_10_DAYS"  },
        { "label": "Last 30 Days",  "value": "LAST_30_DAYS"  },
        { "label": "Last 3 Months", "value": "LAST_3_MONTHS" },
        { "label": "Last 6 Months", "value": "LAST_6_MONTHS" },
        { "label": "Last Year",     "value": "LAST_YEAR"     },
        { "label": "Custom",        "value": "custom"        }
      ]
    },
    "reportsDateOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.reportsDateOptionsArray }}" }
