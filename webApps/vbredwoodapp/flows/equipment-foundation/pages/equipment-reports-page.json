    "_comment_lastQuerySig":     { "type": "string",  "defaultValue": "Params last sent for the active tab. Suppresses a refetch when a criterion change produces no change for THIS endpoint (e.g. a chip the tab doesn't support)." },
    "reportsLastQuerySignature": { "type": "string",  "defaultValue": "" },
    "reportsSearchConfiguration": {
      "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory",
      "defaultValue": {
        "url": "[[ $application.path + 'resources/data/reports/' + $page.variables.reportsActiveTab + '.json' ]]"
      }
    },
    "_comment_searchContext": { "type": "string", "defaultValue": "One entry per filter id used by ANY per-tab config in resources/data/reports/. The ids are deliberately shared across those files so this list stays short; only the ids in the loaded file are rendered as chips. Which file loads is the URL expression on reportsSearchConfiguration above." },
    "reportsSearchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
            "AssetGroupFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsAssetGroupOptionsADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "ClassFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsClassOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "SubclassFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsSubclassOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "StatusFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsStatusOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "LineStatusFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsLineStatusOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "ProjectFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsProjectOptionsADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "EquipmentFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsEquipmentOptionsADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "YardFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsYardOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "RateTypeFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsRateTypeOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "PeriodFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsPeriodOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "ActiveFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsActiveOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "TypeFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsTypeOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "ExpiryFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsExpiryOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "PostedFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsPostedOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            },
            "ProcurementFilter": {
              "options": {
                "optionsData": "[[ $page.variables.reportsProcurementOptionsArrayADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            }
          }
        }
      }
    },
    "_comment_suggestionFilters": { "type": "string", "defaultValue": "Ordering hint passed to the component as string[] — NOT a gate. Which chips exist is the per-tab config file; this was previously a JSON string, which the component ignored. Set per tab by reportsData.suggestionFiltersFor()." },
    "reportsSuggestionFilters":  { "type": "any[]", "defaultValue": ["AssetGroupFilter", "EquipmentFilter", "StatusFilter", "SerialFilter"] },

    "_comment_lovArrays": { "type": "string", "defaultValue": "One array per smart-search filter id used by ANY per-tab config in resources/data/reports/, refilled from the ACTIVE tab's rows by reportsData.loadTab (TAB_META.lovs). Ids are shared across those files, so one array serves whichever param that tab filters on — StatusFilter is allocationStatus on Equipment History, requestStatus on Rental Requests and status on Agreement Expiry. A few are fixed enums the rows never carry (Period/Posted/Active/Procurement) and are filled from constants." },

    "reportsAssetGroupOptionsArray": { "type": "any[]", "defaultValue": [] },
    "reportsAssetGroupOptionsADP":   { "type": "vb/ArrayDataProvider2", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.reportsAssetGroupOptionsArray }}" } },
    "reportsProjectOptionsArray": { "type": "any[]", "defaultValue": [] },
    "reportsProjectOptionsADP":   { "type": "vb/ArrayDataProvider2", "description": "UI-only placeholder for the Equipment History tab's Project chip — empty until a real project lookup is wired up, same convention as Asset Group.", "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.reportsProjectOptionsArray }}" } },
    "reportsEquipmentOptionsArray": { "type": "any[]", "defaultValue": [] },
