          "chain": "BeforeExitChain"
        }
      ]
    },
    "spSecondaryAction": {
      "chains": [
        {
          "chain": "SecondaryActionChain",
          "parameters": {
            "event": "[[ $event ]]"
          }
        }
      ]
    },
    "onRowAction": {
      "chains": [
        {
          "chain": "RowClickChain",
          "parameters": {
            "rowData": "{{ $event.detail.value?.data }}"
          }
