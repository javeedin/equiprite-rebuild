        }
      ]
    },
    "onImportDialogClosed": {
      "chains": [
        {
          "chain": "CancelImportDialogChain",
          "parameters": {
            "event": "[[ $event ]]"
          }
        }
      ]
    },
    "onImportFilterChanged": {
      "chains": [
        {
          "chain": "ClearImportWarningChain"
        }
      ]
    },
    "onSaveStagingClasses": {
      "chains": [
        {
          "chain": "SaveStagingClassesChain"
        }
      ]
    },
    "onStagingNextPage": {
      "chains": [
        {
          "chain": "StagingPageChangeChain",
          "parameters": {
            "direction": "NEXT"
          }
        }
      ]
    },
    "onStagingPrevPage": {
      "chains": [
        {
          "chain": "StagingPageChangeChain",
          "parameters": {
            "direction": "PREV"
          }
        }
      ]
    },
    "onClearStaging": {
      "chains": [
        {
          "chain": "ClearStagingChain"
        }
      ]
    }
