{
  "metadata": {},
  "variables": {
    "filterCriterion": {
      "type": "any"
    },
    "searchConfiguration": {
      "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory",
      "defaultValue": {
        "url": "[[ $application.path + 'resources/data/equipmentMasterSearchConfig.json' ]]"
      }
    },
    "searchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
            "ClassFilter": {
              "label": "Class",
              "options": {
                "optionsData": "[[ $page.variables.classOptionsADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "SubclassFilter": {
              "label": "Subclass",
              "options": {
                "optionsData": "[[ $page.variables.subclassOptionsADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            },
            "AssetGroupFilter": {
              "label": "Asset Group",
              "options": {
                "optionsData": "[[ $page.variables.assetGroupOptionsADP ]]",
                "optionsKeys": {
                  "label": "label",
                  "value": "value"
                }
              }
            }
          }
        }
      }
    },
    "classOptionsArray": {
      "type": "any[]",
      "defaultValue": []
    },
    "classOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.classOptionsArray }}"
      }
    },
    "subclassOptionsArray": {
      "type": "any[]",
      "defaultValue": []
    },
    "subclassOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.subclassOptionsArray }}"
      }
    },
    "assetGroupOptionsArray": {
      "type": "any[]",
      "defaultValue": []
    },
    "assetGroupOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.assetGroupOptionsArray }}"
      }
    },
    "classesById": {
      "type": "object",
      "defaultValue": {}
    },
    "subclassesById": {
      "type": "object",
      "defaultValue": {}
    },
    "equipmentSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "eqp-v1/getEquipriteV1EquipmentMaster",
        "keyAttributes": "id",
        "itemsPath": "data"
      }
    },
    "equipmentDPV": {
      "type": "ojs/ojlistdataproviderview",
      "constructorParams": [
        "[[ $page.variables.equipmentSDP ]]",
        {
          "filterCriterion": "[[ $page.variables.filterCriterion ]]"
        }
      ]
    },
    "isImporting": {
      "type": "boolean",
      "defaultValue": false
    },
    "isSyncing": {
      "type": "boolean",
      "description": "Sync from Fusion is running (SyncFromFusionChain). Part of isBusy: it writes the same stock staging as Fetch.",
      "defaultValue": false
    },
    "syncStep": {
      "type": "string",
      "description": "Which Sync step is running (items / stock / units); shown in the menu item's label.",
      "defaultValue": ""
    },
    "importDialogOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "importPhase": {
      "type": "string",
      "defaultValue": "RUNNING"
    },
    "importMessage": {
      "type": "string",
      "defaultValue": ""
    },
    "secondaryActions": {
      "type": "any[]",
      "defaultValue": [
        {
          "id": "syncFusion",
          "label": "Sync from Fusion",
          "display": "on"
        },
        {
          "id": "importFusion",
          "label": "Import From Fusion",
          "display": "on"
        },
        {
          "id": "refresh",
          "label": "Refresh",
          "display": "on"
        },
        {
          "id": "mapView",
          "label": "Map View",
          "display": "off"
        }
      ]
    },
    "itemClassOptionsArray": {
      "type": "any[]",
      "defaultValue": []
    },
    "itemClassOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.itemClassOptionsArray }}"
      }
    },
    "selectedItemClass": {
      "type": "string",
      "defaultValue": null,
      "description": "ItemClassName. NULL = no item-class filter."
    },
    "itemTypeOptionsArray": {
      "type": "any[]",
      "defaultValue": []
    },
    "itemTypeOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.itemTypeOptionsArray }}"
      }
    },
    "selectedItemType": {
      "type": "string",
      "defaultValue": null,
      "description": "EGP_ITEM_TYPE LookupCode. NULL = no item-type filter."
    },
    "importStatusOptionsArray": {
      "type": "any[]",
      "description": "Review-grid status filter. Values are EQR_EQUIPMENT_MASTER_T.IMPORT_STATUS (CK_EQR_EMPT_IMPORT_STATUS); static, so the filter never waits on a LOV call. Only statuses the package writes: no MERGED (imported rows are deleted from staging since 2026-10-05), and no AMBIGUOUS or REJECTED (allowed by the constraint, never written).",
      "defaultValue": [
        { "value": "AUTO_MAPPED",     "label": "Auto-mapped (tick and Import to merge)" },
        { "value": "ERRORED",         "label": "Errored (class mapping did not resolve)" },
        { "value": "UNMAPPED",        "label": "Unmapped (no mapping source)" },
        { "value": "NEW",             "label": "New (not yet classified)" },
        { "value": "MAPPED",          "label": "Mapped (classified, not yet imported)" },
        { "value": "NO_UNIT_PATHWAY", "label": "No unit pathway" }
      ]
    },
    "importStatusOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.importStatusOptionsArray }}"
      }
    },
    "selectedImportStatus": {
      "type": "string",
      "defaultValue": null,
      "description": "IMPORT_STATUS to show in the review grid. NULL = every status."
    },
    "lovsLoading": {
      "type": "boolean",
      "defaultValue": false
    },
