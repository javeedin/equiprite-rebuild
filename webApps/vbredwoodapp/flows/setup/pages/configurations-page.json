{
  "title": "Configurations Workbench",
  "description": "Configuration workbench for global application settings — wired to eqp-v1 REST API.",
  "variables": {
    "selectedTab": {
      "type": "string",
      "defaultValue": "featureFlagsTab"
    },

    "ConfigSettingsMap": { "type": "object", "defaultValue": {} },
    "changedRows": { "type": "object", "defaultValue": {} },
    "hasChanges": { "type": "boolean", "defaultValue": false },
    "isSaving": { "type": "boolean", "defaultValue": false },
    "isLoading": { "type": "boolean", "defaultValue": false },
    "saveError": { "type": "string", "defaultValue": "" },

    "buSettingsDirty": { "type": "boolean", "defaultValue": false },

    "CostingLovArray": {
      "type": "any[]",
      "defaultValue": [
        { "label": "EquipRite Rates", "value": "EQUIPRITE_RATES" },
        { "label": "PPM Rates", "value": "PPM_RATES" }
      ]
    },
    "WeekEndDayLovArray": {
      "type": "any[]",
      "defaultValue": [
        { "label": "Friday", "value": "FRIDAY" },
        { "label": "Saturday", "value": "SATURDAY" },
        { "label": "Sunday", "value": "SUNDAY" }
      ]
    },

    "EnableQuotesLovArray": {
      "type": "any[]",
      "defaultValue": [
        { "value": "NONE", "label": "None" },
        { "value": "PROJECTS", "label": "Internal only" },
        { "value": "CUSTOMER", "label": "External only" },
        { "value": "BOTH", "label": "Both" }
      ]
    },
    "EnableQuotesLovDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.variables.EnableQuotesLovArray ]]" }
    },
    "PpmTxnSourceSel": {
      "type": "string",
      "defaultValue": "External Miscellaneous",
      "description": "Two-way binding target for the PPM_TXN_SOURCE field. Seeded from ConfigSettingsMap in loadConfigSettingsChain; persisted via data-setting-key, not from here. Defaults to 'External Miscellaneous' \u2014 the value that posts successfully today \u2014 so the PPM branch is wired end to end before anyone changes Fusion setup. Global, never per BU: EquipRite 1.0 made this per-BU and 4,444 of its 4,519 postings went out under a source that appeared in no config row."
    },
    "PpmDocumentSel": {
      "type": "string",
      "defaultValue": "Miscellaneous",
      "description": "Two-way binding target for the PPM_DOCUMENT field. Seeded from ConfigSettingsMap in loadConfigSettingsChain; persisted via data-setting-key, not from here. Defaults to 'Miscellaneous' \u2014 the value that posts successfully today \u2014 so the PPM branch is wired end to end before anyone changes Fusion setup."
    },
    "PpmDocEntrySel": {
      "type": "string",
      "defaultValue": "Miscellaneous",
      "description": "Two-way binding target for the PPM_DOC_ENTRY field. Seeded from ConfigSettingsMap in loadConfigSettingsChain; persisted via data-setting-key, not from here. Defaults to 'Miscellaneous' \u2014 the value that posts successfully today \u2014 so the PPM branch is wired end to end before anyone changes Fusion setup. \ud83d\udd34 This is the one that matters: the document entry carries the expenditure type class AND Fusion's 'Import raw cost amounts' flag, which is what decides whether Fusion calculates the cost. That flag is Fusion SETUP \u2014 this field only chooses which entry we post to, never how it behaves."
    },
    "PpmExpenditureOrgSel": {
      "type": "string",
      "defaultValue": "",
      "description": "Two-way binding target for the PPM_EXPENDITURE_ORG field. Seeded from ConfigSettingsMap in loadConfigSettingsChain; persisted via data-setting-key. Blank = not set: EQP_P_FUSION_POST_QUEUE branch C then falls back to its old literal 'Applications and Services', so dev20 is unchanged. Default '' on purpose -- an unsaved key seeds '' too, so the first render fires no change and does not mark the page dirty."
    },
    "EnableQuotesSel": { "type": "string", "defaultValue": "CUSTOMER", "description": "Two-way binding target for the ENABLE_QUOTES picker (oj-select-single needs a writable value). Seeded from ConfigSettingsMap in loadConfigSettingsChain; persisted via data-setting-key, not from here." },

    "daysOfWeekArray": {
      "type": "any[]",
      "defaultValue": [
        { "value": "SUNDAY", "label": "Sunday" },
        { "value": "MONDAY", "label": "Monday" },
        { "value": "TUESDAY", "label": "Tuesday" },
        { "value": "WEDNESDAY", "label": "Wednesday" },
        { "value": "THURSDAY", "label": "Thursday" },
        { "value": "FRIDAY", "label": "Friday" },
        { "value": "SATURDAY", "label": "Saturday" }
      ]
    },
    "daysOfWeekDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.variables.daysOfWeekArray ]]" }
    },

    "WeekEndDaySel": { "type": "string", "defaultValue": "" },

    "CostingLovDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.variables.CostingLovArray ]]" }
    },
    "WeekEndDayLovDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.variables.WeekEndDayLovArray ]]" }
    },
    "EquipmentClassConfigLovArray": { "type": "any[]", "defaultValue": [] },
    "EquipmentClassConfigLovDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.EquipmentClassConfigLovArray }}" }
    },

    "isAddClassDrawerOpen": { "type": "boolean", "defaultValue": false },
    "isAddingClassSubclass": { "type": "boolean", "defaultValue": false },
    "EditClassSubclass": {
      "type": "object",
      "defaultValue": {
        "id": null,
        "classId": null,
        "subclassName": "",
        "trackingType": "INVENTORY",
        "consumableFlag": "N",
        "autoConsumeFlag": "N",
        "procurementMarkupPct": null,
        "bufferPeriodDays": 0
      }
    },
    "DeleteSubclassTarget": {
      "type": "object",
      "defaultValue": { "id": null, "classId": null, "subclassName": "" }
    },
    "DeleteClassTarget": {
      "type": "object",
      "defaultValue": { "id": null, "className": "" }
    },
    "DeleteBuOrgTarget": {
      "type": "object",
      "defaultValue": { "rowKey": null, "id": null, "orgName": "", "buName": "" }
    },
    "BuOrgEditTarget": {
      "type": "object",
      "defaultValue": { "id": null, "buName": "", "orgId": null, "orgName": "", "orgCode": "", "yardType": null, "isTransactable": "Y", "subinventoryCode": null }
    },
    "BuOrgMenuRowKey": { "type": "string" },
    "DeleteAgreementTypeTarget": {
      "type": "object",
      "defaultValue": { "id": null, "typeLabel": "" }
    },
    "newClassSubclass": {
      "type": "object",
      "defaultValue": {
        "className": "",
        "subclassName": "",
        "trackingType": "INVENTORY",
        "classLovId": null,
        "subclassLovId": null,
        "consumableFlag": "N",
        "autoConsumeFlag": "N"
      }
    },
    "YesNoLovArray": {
      "type": "any[]",
      "defaultValue": [
        { "value": "Y", "label": "Yes" },
        { "value": "N", "label": "No" }
      ]
    },
    "YesNoLovDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.YesNoLovArray }}" }
    },

    "TrackingTypeLovArray": {
      "type": "any[]",
      "description": "TYPE picker on the Add drawer / Edit dialog. Values match the TRACKING_TYPE column planned for EQR_EQUIPMENT_SUBCLASS. Descriptive DEFAULT for new items in the subclass, NOT a constraint on existing ones: the three tracking axes on EQR_EQUIPMENT_MASTER (IS_INVENTORY_TRACKED / IS_MAINTENANCE_TRACKED / IS_FIXED_ASSET_TRACKED) are independent and combinable, so a subclass may legitimately hold items that disagree with this value. Never filter or validate items by it.",
      "defaultValue": [
        { "value": "INVENTORY", "label": "Inventory" },
        { "value": "MAINTENANCE", "label": "Maintenance" },
        { "value": "FIXED_ASSET", "label": "Fixed Assets" },
        { "value": "CUSTOM", "label": "Custom" }
      ]
    },
    "AddClassTypeLovDP": {
      "type": "vb/ArrayDataProvider2",
      "description": "Add Class drawer TYPE picker: Inventory plus the Asset Classification Source (all three while it is not configured), plus Custom (typed by hand, no Fusion column).",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.functions.addClassTypeOptions($page.variables.ClassMapTruthSel) ]]" }
    },
    "TrackingTypeLovDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "{{ $page.variables.TrackingTypeLovArray }}" }
    },

    "ClassLovArray": {
      "type": "any[]",
      "defaultValue": [],
      "description": "CLASS level of EQP_CLASS_LOV_RP, read LIVE from Fusion over bipService. What a 'class' IS depends on TYPE: INVENTORY = catalog/category set, FINANCE = major category, MAINTENANCE = maintenance-enabled item. CUSTOM loads nothing on purpose (hand-typed, not sourced from Fusion). Populated by loadClassLovChain."
    },
    "ClassLovDP": {
      "type": "vb/ArrayDataProvider2",
      "description": "textFilterAttributes turns the picker into search-as-you-type, matching LOCALLY with no round-trip. Not cosmetic: MAINTENANCE/CLASS returns 107 rows on Dev 20 and grows with the fleet (it is item-grain, unlike the other two axes which are bounded setup data), and INVENTORY/CLASS returns 77 catalogs. Matching on 'code' as well as 'label' lets an admin type either the name or the native Fusion code (ITEM_NUMBER, CATALOG_CODE).",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.ClassLovArray }}",
        "textFilterAttributes": ["label", "code"]
      }
    },
    "isClassLovLoading": { "type": "boolean", "defaultValue": false },
    "classLovLoaded": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Latch so the placeholder can distinguish 'still loading' from 'genuinely none found'. False while a call is in flight, so an empty list mid-load never reads as a real empty result."
    },

    "SubclassLovArray": {
      "type": "any[]",
      "defaultValue": [],
      "description": "SUBCLASS level of EQP_CLASS_LOV_RP, cascaded off the selected class (its LOV_ID is sent as P_PARENT_ID). INVENTORY = category, FINANCE = minor category, MAINTENANCE = default work order type. Populated by loadSubclassLovChain."
    },
    "SubclassLovDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.SubclassLovArray }}",
        "textFilterAttributes": ["label", "code"]
      }
    },
    "isSubclassLovLoading": { "type": "boolean", "defaultValue": false },
    "subclassLovLoaded": { "type": "boolean", "defaultValue": false },

    "selectedClassSubTab": {
      "type": "string",
      "defaultValue": "classMappingSubTab",
      "description": "Sub-tab inside Equipment Classes: classMappingSubTab (map Fusion classes in) or classSubclassSubTab (the class/subclass behaviour-flag grid)."
    },
    "ClassMapTruthSel": {
      "type": "string",
      "defaultValue": "",
      "description": "CLASS_MAPPING_SOURCE_OF_TRUTH (conf-global-settings, SETTING_CATEGORY SYSTEM): which of FIXED_ASSET / MAINTENANCE is the source of truth beside Inventory. Seeded in loadConfigSettingsChain; saved immediately by saveClassMapTruthChain (this tab has no Save Changes button). Empty = not chosen yet = all three sources offered, which is the behaviour before the setting existed."
    },
    "ClassMapTruthLovArray": {
      "type": "any[]",
      "defaultValue": [
        { "value": "FIXED_ASSET", "label": "Fixed Assets" },
        { "value": "MAINTENANCE", "label": "Maintenance" }
      ]
    },
    "ClassMapTruthLovDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.variables.ClassMapTruthLovArray ]]" }
    },
    "isClassMapTruthSaving": { "type": "boolean", "defaultValue": false },
    "ClassMapPrecedenceSel": {
      "type": "string",
      "defaultValue": "",
      "description": "CLASS_MAPPING_PRECEDENCE (conf-global-settings, SYSTEM): ordered, comma-separated source list, first = highest, e.g. MAINTENANCE,INVENTORY -- the format EQR_ITEM_IMPORT_MERGE_PKG reads. Each imported item is classified from the first source it has data in. Seeded in loadConfigSettingsChain; saved immediately by saveClassMapPrecedenceChain. Empty = not saved yet; the import then defaults to <asset source>,INVENTORY."
    },
    "ClassMapPrecedenceLovDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.functions.classMapPrecedenceOptions($page.variables.ClassMapTruthSel) ]]" }
    },
    "isClassMapPrecedenceSaving": { "type": "boolean", "defaultValue": false },
    "ClassMapSourceLovDP": {
      "type": "vb/ArrayDataProvider2",
      "description": "SOURCE picker: Inventory plus the source of truth (all three while none is chosen). Derived by classMapSourceOptions.",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.functions.classMapSourceOptions($page.variables.ClassMapTruthSel) ]]" }
    },
    "ClassMapTypesArray": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The Class / Subclass Attribute lists for every source, as {source, value, label, sort}, loaded from EQP_CATEGORY_LOV_RP TYPES by loadClassMapTypesChain. The report is the one place the lists are defined; the page keeps no copy."
    },
    "UnmapTarget": {
      "type": "object",
      "description": "Confirmed target of the Class Mapping Unmap action. level CLASS clears the class's Fusion fields and those of every subclass under it; SUBCLASS clears one subclass only. The EquipRite class/subclass itself is kept either way.",
      "defaultValue": { "level": null, "classId": null, "subclassId": null, "className": "", "subclassName": "", "mappedSubclassCount": 0 }
    },
    "isUnmapping": { "type": "boolean", "defaultValue": false },
    "ColumnMapDraft": {
      "type": "object",
      "description": "The column-mapping form: for one classification source, the field group and Fusion column that hold the equipment CLASS, and (optionally) the SUBCLASS. Saved per source as CLASS_MAPPING_COLUMNS_<SOURCE> by saveColumnMappingChain; refilled from the saved mapping by onColumnMapSourceChangedChain.",
      "defaultValue": { "sourceType": "INVENTORY", "classGroup": null, "classColumn": null, "subclassGroup": null, "subclassColumn": null }
    },
    "ColumnMapClassGroupDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.functions.fieldGroupOptions($page.variables.ColumnMapDraft.sourceType, $page.variables.ClassMapTypesArray) ]]" }
    },
    "ColumnMapClassColumnDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.functions.columnOptions($page.variables.ColumnMapDraft.sourceType, $page.variables.ColumnMapDraft.classGroup, $page.variables.ClassMapTypesArray) ]]", "textFilterAttributes": ["label"] }
    },
    "ColumnMapSubGroupDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.functions.fieldGroupOptions($page.variables.ColumnMapDraft.sourceType, $page.variables.ClassMapTypesArray) ]]" }
    },
    "ColumnMapSubColumnDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.functions.columnOptions($page.variables.ColumnMapDraft.sourceType, $page.variables.ColumnMapDraft.subclassGroup, $page.variables.ClassMapTypesArray) ]]", "textFilterAttributes": ["label"] }
    },
    "isColumnMapSaving": { "type": "boolean", "defaultValue": false },
    "ColumnMappingsADP": {
      "type": "vb/ArrayDataProvider2",
      "description": "One row per classification source with a saved column mapping, read from ConfigSettingsMap (CLASS_MAPPING_COLUMNS_<SOURCE>).",
      "defaultValue": { "itemType": "any", "keyAttributes": "source", "data": "[[ $page.functions.columnMappingRows($page.variables.ConfigSettingsMap) ]]" }
    },
    "ClassMapPairsArray": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Create from Fusion dialog: distinct (class value, subclass value) pairs Fusion carries on the same item / asset for ClassMapPairsSource's column mapping, each marked EXISTS / NEW_SUBCLASS / NEW. Filled by previewClassMapPairsChain."
    },
    "ClassMapPairsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "key", "data": "[[ $page.variables.ClassMapPairsArray ]]" }
    },
    "ClassMapPairsSource": { "type": "string", "defaultValue": "" },
    "ClassMapBulkSourceLovDP": {
      "type": "vb/ArrayDataProvider2",
      "description": "Create from Fusion SOURCE picker: allowed sources with a saved column mapping (bulkSourceOptions).",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.functions.bulkSourceOptions($page.variables.ConfigSettingsMap, $page.variables.ClassMapTruthSel) ]]" }
    },
    "isClassMapPairsLoading": { "type": "boolean", "defaultValue": false },
    "isClassMapCreating": { "type": "boolean", "defaultValue": false },

    "AuditTrailAllArray": { "type": "any[]", "defaultValue": [] },
    "AuditTrailADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "id",
        "data": "{{ $page.variables.AuditTrailAllArray }}"
      }
    },

    "BuOrgSelectedBUId": { "type": "number" },
    "BuOrgSelectedBUName": { "type": "string", "defaultValue": "" },
    "buSearchQ": { "type": "string", "defaultValue": "BusinessUnitName LIKE '*'" },

    "BuOrgConfiguredBuSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "eqp-v1/getConfEquipmentSettings",
        "keyAttributes": "businessUnitId",
        "itemsPath": "data",
        "uriParameters": {
          "limit": 500
        },
        "textFilterAttributes": ["businessUnitName"],
        "capabilities": {
          "filter": {
            "operators": ["$co", "$eq", "$ew", "$ge", "$gt", "$le", "$lt", "$ne", "$pr", "$sw"]
          }
        }
      }
    },

    "BuOrgBuSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "ProjectLOV/getFscmRestApiResources11_13_18_05FinBusinessUnitsLOV",
        "keyAttributes": "BusinessUnitId",
        "itemsPath": "items",
        "uriParameters": {
          "q": "[[ $variables.buSearchQ ]]",
          "fields": "BusinessUnitId,BusinessUnitName",
          "limit": 500
        },
        "textFilterAttributes": ["BusinessUnitName"],
        "capabilities": {
          "filter": {
            "operators": ["$co", "$eq", "$ew", "$ge", "$gt", "$le", "$lt", "$ne", "$pr", "$sw"]
          }
        }
      }
    },

    "BuOrgYardSDP": {
      "type": "vb/ServiceDataProvider",
      "defaultValue": {
        "endpoint": "ProjectLOV/getFscmRestApiResources11_13_18_05InventoryOrganizations",
        "keyAttributes": "OrganizationId",
        "itemsPath": "items",
        "uriParameters": {
          "q": "[[ $page.variables.BuOrgSelectedBUId ? 'ManagementBusinessUnitId=' + $page.variables.BuOrgSelectedBUId : 'OrganizationId=-1' ]]",
          "fields": "OrganizationId,OrganizationCode,OrganizationName,ManagementBusinessUnitId,LocationCode,Status",
          "limit": 200
        },
        "textFilterAttributes": ["OrganizationName", "OrganizationCode"],
        "capabilities": {
          "filter": {
            "operators": ["$co", "$eq", "$ew", "$ge", "$gt", "$le", "$lt", "$ne", "$pr", "$sw"]
          }
        }
      }
    },

    "isBuOrgDrawerOpen": { "type": "boolean", "defaultValue": false },

    "BuOrgSubinvArray": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Fusion subinventories of the org being added/edited on BU Org Mapping, as { value, label }. Filled by loadBuOrgSubinventoriesChain (disabled ones left out; a saved code is kept so it still shows)."
    },
    "BuOrgSubinvDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.variables.BuOrgSubinvArray ]]" }
    },
    "isBuOrgSubinvLoading": { "type": "boolean", "defaultValue": false },

    "currentMapping": {
      "type": "object",
      "defaultValue": {
        "buId": null,
        "buName": "",
        "orgId": null,
        "orgName": "",
        "orgCode": "",
        "location": "",
        "status": "",
        "yardType": null,
        "isTransactable": "Y",
        "subinventoryCode": null
      }
    },

    "BuOrgMappingsArray": { "type": "any[]", "defaultValue": [] },
    "BuOrgFilterBUId": { "type": "number" },
    "BuOrgFilterLovArray": { "type": "any[]", "defaultValue": [] },
    "BuOrgFilterLovDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.variables.BuOrgFilterLovArray ]]" }
    },
    "isBuOrgSaving": { "type": "boolean", "defaultValue": false },
    "buOrgDirty": { "type": "boolean", "defaultValue": false },
    "BuOrgMappingADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "rowKey",
        "data": "[[ $page.functions.filterBuOrgMappings($page.variables.BuOrgMappingsArray, $page.variables.BuOrgFilterBUId) ]]"
      }
    },

    "OrgRoleLovArray": {
      "type": "any[]",
      "description": "Yard Type LOV for the BU & Org Mapping drawer. Hard-coded here — there is no endpoint behind it — so it MUST stay in lockstep with CHK_BOM_ORG_ROLE on EQR_BU_ORG_MAPPING, which permits exactly these four values (widened to include DESTINATION_YARD in schema v302). An option the constraint does not accept renders as selectable and then fails on save with ORA-02290.",
      "defaultValue": [
        { "label": "Equipment Yard", "value": "EQUIPMENT_YARD" },
        { "label": "Destination Yard", "value": "DESTINATION_YARD" },
        { "label": "Virtual Project Org", "value": "VIRTUAL_PROJECT" },
        { "label": "Virtual Customer Org", "value": "VIRTUAL_CUSTOMER" }
      ]
    },
    "OrgRoleLovDP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": { "itemType": "any", "keyAttributes": "value", "data": "[[ $page.variables.OrgRoleLovArray ]]" }
    },

    "AgreementTypeAllArray": { "type": "any[]", "defaultValue": [] },
    "AgreementTypeADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "id",
        "data": "{{ $page.variables.AgreementTypeAllArray }}"
      }
    },
