{
  "description": "Rate Management — Smart Search Page (PATH B, hardcoded data)",
  "metadata": {},
  "functions": {
    "getRequestData": {
      "return": "any[]"
    }
  },
  "variables": {
    "RequestAllArray": {
      "type": "any[]",
      "defaultValue": []
    },
    "RequestFilteredArray": {
      "type": "any[]",
      "defaultValue": []
    },
    "RequestADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "id",
        "data": "{{ $page.variables.RequestFilteredArray }}"
      }
    },
    "filterCriterion": {
      "type": "any"
    },
    "searchConfiguration": {
      "type": "oj-sp/smart-search/strategies/JsonSearchConfigProviderFactory",
      "defaultValue": {
        "url": "[[ $application.path + 'resources/data/rateScheduleSearchConfig.json' ]]"
      }
    },
    "searchContext": {
      "type": "object",
      "defaultValue": {
        "$search": {
          "filters": {
            "StatusFilter": {
              "label": "Status",
              "options": {
                "optionsData": "[[ $page.variables.statusOptionsADP ]]",
                "optionsKeys": { "label": "label", "value": "value" }
              }
            }
          }
        }
      }
    },
    "statusOptionsArray": {
      "type": "any[]",
      "defaultValue": [
        { "value": "ACTIVE",   "label": "Active" },
        { "value": "INACTIVE", "label": "Inactive" }
      ]
    },
    "statusOptionsADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "any",
        "keyAttributes": "value",
        "data": "{{ $page.variables.statusOptionsArray }}"
      }
    },
    "isDrawerOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "selectedRequest": {
      "type": "any",
      "defaultValue": {}
    }
  },
  "eventListeners": {
    "vbBeforeEnter": {
      "chains": [
        { "chain": "enforcePageAccessChain" }
      ]
    },
    "vbEnter": {
      "chains": [
        { "chain": "rateManagementGuardChain", "parameters": {} },
        { "chain": "RateScheduleInitChain", "parameters": {} }
      ]
    },
    "filterCriterionChanged": {
      "chains": [{ "chain": "RateScheduleFilterChain", "parameters": {} }]
    },
    "onRowAction": {
      "chains": [{ "chain": "navigateToDetailChain", "parameters": { "scheduleId": "{{ $event.detail.value?.data.id }}" } }]
    },
    "closeRequestDrawer": {
      "chains": [{ "chain": "closeDrawerChain", "parameters": {} }]
    },
    "spPrimaryAction": {
      "chains": [{ "chain": "navigateToCreateChain", "parameters": {} }]
    }
  },
  "imports": {
    "components": {
      "oj-sp-smart-search-page":      { "path": "oj-sp/smart-search-page/loader" },
      "oj-sp-smart-search":           { "path": "oj-sp/smart-search/loader" },
      "oj-sp-collection-container":   { "path": "oj-sp/collection-container/loader" },
      "oj-sp-general-drawer-template":{ "path": "oj-sp/general-drawer-template/loader" },
      "oj-sp-messages-banner":        { "path": "oj-sp/messages-banner/loader" },
      "oj-table":                     { "path": "ojs/ojtable" },
      "oj-button":                    { "path": "ojs/ojbutton" },
      "oj-drawer-popup":              { "path": "ojs/ojdrawerpopup" },
      "oj-defer":                     { "path": "ojs/ojdefer" },
      "oj-form-layout":               { "path": "ojs/ojformlayout" },
      "oj-bind-if":                   { "path": "ojs/ojknockout" },
      "oj-bind-for-each":             { "path": "ojs/ojknockout" },
      "oj-bind-text":                 { "path": "ojs/ojknockout" }
    }
  }
}
