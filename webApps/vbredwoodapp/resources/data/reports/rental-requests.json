{
  "description": "Smart-search filters for the Rental Requests tab ONLY. One config file per tab, because oj-sp-smart-search renders a chip for EVERY filter the loaded config declares \u2014 suggestion-filters does NOT gate that row. Each `field` IS the endpoint's literal query-param name (see reportCriterion.ENDPOINT_PARAMS); a field that is not a real param yields a chip that filters nothing, because the views ignore unknown params silently. This set is deliberately CURATED, not exhaustive \u2014 the endpoint accepts more params than are offered. Not offered: requestNumber, customerName (dropped by request \u2014 free-text q still spans both); dateFrom/dateTo (no date filter type); eqrEquipmentRequestId (redundant with the request number). Project re-added by request (projectName was previously covered by q= alone). CAUTION \u2014 EquipmentFilter (equipmentName) was ALSO added for chip-set parity with the other report tabs, but this view's own endpoint has NO equipment param at all (per the original note above); until the backend adds one, this specific chip will filter nothing.",
  "filters": {
    "AssetGroupFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Asset Group",
      "options": {
        "field": "assetGroup",
        "optionsData": "[[ $search.filters.AssetGroupFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.AssetGroupFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "ClassFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Class",
      "options": {
        "field": "equipmentClass",
        "optionsData": "[[ $search.filters.ClassFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.ClassFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "StatusFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Request Status",
      "options": {
        "field": "requestStatus",
        "optionsData": "[[ $search.filters.StatusFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.StatusFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "LineStatusFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Line Status",
      "options": {
        "field": "lineStatus",
        "optionsData": "[[ $search.filters.LineStatusFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.LineStatusFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "ProcurementFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Procurement",
      "options": {
        "field": "procurement",
        "optionsData": "[[ $search.filters.ProcurementFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.ProcurementFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "ProjectFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Project",
      "options": {
        "field": "projectName",
        "optionsData": "[[ $search.filters.ProjectFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.ProjectFilter.options.optionsKeys ]]"
      },
      "data": {}
    },
    "EquipmentFilter": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Equipment Name",
      "options": {
        "field": "equipmentName",
        "optionsData": "[[ $search.filters.EquipmentFilter.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.EquipmentFilter.options.optionsKeys ]]"
      },
      "data": {}
    }
  }
}
